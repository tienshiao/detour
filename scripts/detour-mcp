#!/usr/bin/env python3
"""Minimal client for Detour's automation endpoint (TASK-228.1).

Speaks MCP over Streamable HTTP with no model in the loop: initialize, the
initialized notification, then tool calls, then ends the session. Scripts,
/verify and external test suites drive Detour with it.

It finds the endpoint in the data directory's mcp-endpoint.json:
~/Library/Application Support/<DETOUR_DATA_DIR or "Detour">/mcp-endpoint.json

Usage:
  scripts/detour-mcp [--data-dir NAME | --endpoint FILE] tools
  scripts/detour-mcp [...] call TOOL [ARGS_JSON | key=value ...]
  scripts/detour-mcp [...] batch < calls.jsonl

  call: arguments as one JSON object, or key=value pairs whose values are
        parsed as JSON when they parse (window_id=1, path='["File","New Tab"]')
        and taken as strings otherwise (url=https://example.com).
  batch: one JSON object per line, {"tool": NAME, "arguments": {...}}, all in
        one session; prints one result per line and stops at the first error
        unless --keep-going.

Prints the tool's structuredContent as JSON. Exit status: 0 success, 1 the
tool reported an error (isError; its error.code is in the output), 2 a
transport or protocol failure.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

PROTOCOL_VERSION = "2025-06-18"

# Straight to 127.0.0.1, never through a proxy: urllib otherwise takes
# HTTP_PROXY (or the system's proxy) and would hand the proxy the bearer token.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class ProtocolError(Exception):
    pass


def endpoint_file(args):
    if args.endpoint:
        return args.endpoint
    name = args.data_dir or os.environ.get("DETOUR_DATA_DIR") or "Detour"
    return os.path.expanduser(f"~/Library/Application Support/{name}/mcp-endpoint.json")


class Session:
    def __init__(self, url, token, client_name):
        self.url = url
        self.token = token
        self.client_name = client_name
        self.session_id = None
        self.next_id = 1

    def _post(self, message):
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "Authorization": f"Bearer {self.token}",
        }
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
            headers["MCP-Protocol-Version"] = PROTOCOL_VERSION
        request = urllib.request.Request(self.url, data=json.dumps(message).encode(), headers=headers, method="POST")
        try:
            with OPENER.open(request, timeout=120) as response:
                body = response.read()
                session = response.headers.get("Mcp-Session-Id")
                return response.status, body, session
        except urllib.error.HTTPError as error:
            raise ProtocolError(f"HTTP {error.code}: {error.read().decode(errors='replace').strip()}")
        except urllib.error.URLError as error:
            raise ProtocolError(f"cannot reach {self.url}: {error.reason} (is Detour running with the endpoint on?)")

    def request(self, method, params=None):
        message = {"jsonrpc": "2.0", "id": self.next_id, "method": method}
        self.next_id += 1
        if params is not None:
            message["params"] = params
        _, body, session = self._post(message)
        if session and not self.session_id:
            self.session_id = session
        reply = json.loads(body)
        if "error" in reply:
            raise ProtocolError(f"{method}: {reply['error'].get('message')} ({reply['error'].get('code')})")
        return reply["result"]

    def notify(self, method):
        self._post({"jsonrpc": "2.0", "method": method})

    def open(self):
        result = self.request("initialize", {
            "protocolVersion": PROTOCOL_VERSION,
            "capabilities": {},
            "clientInfo": {"name": self.client_name, "version": "1"},
        })
        if not self.session_id:
            raise ProtocolError("initialize returned no Mcp-Session-Id")
        self.notify("notifications/initialized")
        return result

    def close(self):
        if not self.session_id:
            return
        request = urllib.request.Request(self.url, method="DELETE", headers={
            "Authorization": f"Bearer {self.token}",
            "Mcp-Session-Id": self.session_id,
        })
        try:
            OPENER.open(request, timeout=10).read()
        except (urllib.error.URLError, urllib.error.HTTPError):
            pass
        self.session_id = None

    def call(self, tool, arguments):
        return self.request("tools/call", {"name": tool, "arguments": arguments})


def parse_arguments(items):
    if not items:
        return {}
    if len(items) == 1 and items[0].lstrip().startswith("{"):
        return json.loads(items[0])
    arguments = {}
    for item in items:
        if "=" not in item:
            raise SystemExit(f"argument '{item}' is not key=value")
        key, value = item.split("=", 1)
        try:
            arguments[key] = json.loads(value)
        except json.JSONDecodeError:
            arguments[key] = value
    return arguments


def structured(result):
    if "structuredContent" in result:
        return result["structuredContent"]
    texts = [c.get("text", "") for c in result.get("content", []) if c.get("type") == "text"]
    try:
        return json.loads(texts[0]) if texts else None
    except json.JSONDecodeError:
        return {"text": "\n".join(texts)}


def main():
    parser = argparse.ArgumentParser(description="Call tools on Detour's automation endpoint.")
    parser.add_argument("--data-dir", help="DETOUR_DATA_DIR of the running Detour (default: $DETOUR_DATA_DIR, else Detour)")
    parser.add_argument("--endpoint", help="path to an mcp-endpoint.json")
    parser.add_argument("--client-name", default="detour-mcp script", help="name shown in Detour's connected indicator")
    parser.add_argument("--compact", action="store_true", help="print JSON on one line")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("tools", help="list the tools")
    call = sub.add_parser("call", help="call one tool")
    call.add_argument("tool")
    call.add_argument("arguments", nargs="*")
    batch = sub.add_parser("batch", help="call tools from JSON lines on stdin, in one session")
    batch.add_argument("--keep-going", action="store_true")
    args = parser.parse_args()

    path = endpoint_file(args)
    try:
        with open(path) as f:
            endpoint = json.load(f)
    except FileNotFoundError:
        print(f"detour-mcp: no endpoint file at {path} (is Detour running with the endpoint on?)", file=sys.stderr)
        return 2

    pid = endpoint.get("pid")
    if isinstance(pid, int):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            print(f"detour-mcp: {path} is stale: process {pid} is not running", file=sys.stderr)
            return 2
        except PermissionError:
            pass

    indent = None if args.compact else 2
    session = Session(endpoint["url"], endpoint["token"], args.client_name)
    try:
        session.open()
        if args.command == "tools":
            tools = session.request("tools/list")["tools"]
            for tool in tools:
                print(f"{tool['name']}: {tool.get('description', '')}")
            return 0
        if args.command == "call":
            result = session.call(args.tool, parse_arguments(args.arguments))
            print(json.dumps(structured(result), indent=indent, sort_keys=True))
            return 1 if result.get("isError") else 0
        status = 0
        for line in sys.stdin:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            # A bad line is a usage failure (2), not a tool error (1).
            try:
                step = json.loads(line)
                tool = step["tool"]
            except (json.JSONDecodeError, KeyError, TypeError) as error:
                raise ProtocolError(f"batch line is not {{\"tool\": NAME, \"arguments\": {{...}}}}: {line} ({error})")
            result = session.call(tool, step.get("arguments", {}))
            print(json.dumps({"tool": tool, "isError": bool(result.get("isError")),
                              "result": structured(result)}, sort_keys=True))
            if result.get("isError"):
                status = 1
                if not args.keep_going:
                    break
        return status
    except ProtocolError as error:
        print(f"detour-mcp: {error}", file=sys.stderr)
        return 2
    finally:
        session.close()


if __name__ == "__main__":
    sys.exit(main())
