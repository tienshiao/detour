+// TEMP TASK-199 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+/// The harness log: wall clock, seconds since the harness started, line.
+enum Task199Log {
+    static let env = ProcessInfo.processInfo.environment
+    static let start = ProcessInfo.processInfo.systemUptime
+    static let queue = DispatchQueue(label: "task199.log")
+    static var logURL: URL? {
+        guard let outDir = env["DETOUR_VERIFY_DIR"] else { return nil }
+        return URL(fileURLWithPath: outDir).appendingPathComponent("verify-\(env["DETOUR_VERIFY_RUN"] ?? "run").log")
+    }
+    static let clock: DateFormatter = {
+        let f = DateFormatter(); f.dateFormat = "HH:mm:ss.SSS"; return f
+    }()
+    static func log(_ line: String) {
+        guard let logURL else { return }
+        let stamped = String(format: "%@ [%7.3f] %@\n", clock.string(from: Date()),
+                             ProcessInfo.processInfo.systemUptime - start, line)
+        queue.async {
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+    }
+    static func formats() -> String {
+        let defaults = ContentBlockerStorage.current.defaults
+        return ContentBlockerManager.filterLists.map {
+            "\($0.identifier)=\(defaults.object(forKey: "ContentBlocker.\($0.identifier).rulesFormat").map { "\($0)" } ?? "nil")"
+        }.joined(separator: " ")
+    }
+}
+
+/// Serves the filter list URLs from DETOUR_VERIFY_LISTS (no network): ETag
+/// "v2" for every list, 304 when the request names it, and logs the
+/// conditional headers of every request.
+final class Task199ListProtocol: URLProtocol {
+    static let etag = "\"v2\""
+    static func identifier(for url: URL?) -> String? {
+        ContentBlockerManager.filterLists.first { $0.url == url }?.identifier
+    }
+    override class func canInit(with request: URLRequest) -> Bool { identifier(for: request.url) != nil }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        let id = Self.identifier(for: request.url) ?? "?"
+        let inm = request.value(forHTTPHeaderField: "If-None-Match")
+        let ims = request.value(forHTTPHeaderField: "If-Modified-Since")
+        let dir = Task199Log.env["DETOUR_VERIFY_LISTS"] ?? ""
+        let body = try? Data(contentsOf: URL(fileURLWithPath: dir).appendingPathComponent("\(id).txt"))
+        let status = inm == Self.etag ? 304 : (body == nil ? 404 : 200)
+        Task199Log.log("FETCH \(id) If-None-Match=\(inm ?? "-") If-Modified-Since=\(ims ?? "-") -> \(status)")
+        let response = HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: "HTTP/1.1",
+                                       headerFields: ["ETag": Self.etag, "Content-Type": "text/plain"])!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        if status == 200, let body { client?.urlProtocol(self, didLoad: body) }
+        client?.urlProtocolDidFinishLoading(self)
+    }
+    override func stopLoading() {}
+}
+
+/// A main-queue heartbeat every 100 ms: logs every gap over 250 ms, and every
+/// change of a list's rulesFormat and of the manager's refreshing set.
+final class Task199Heartbeat {
+    static let shared = Task199Heartbeat()
+    var last = ProcessInfo.processInfo.systemUptime
+    var maxGap: Double = 0
+    var gapCount = 0
+    var lastFormats = ""
+    var lastRefreshing = ""
+    var timer: Timer?
+
+    func start() {
+        last = ProcessInfo.processInfo.systemUptime
+        let timer = Timer(timeInterval: 0.1, repeats: true) { [unowned self] _ in self.tick() }
+        RunLoop.main.add(timer, forMode: .common)
+        self.timer = timer
+    }
+
+    func tick() {
+        let now = ProcessInfo.processInfo.systemUptime
+        let gap = now - last
+        last = now
+        maxGap = max(maxGap, gap)
+        if gap > 0.25 {
+            gapCount += 1
+            Task199Log.log(String(format: "GAP main queue %.0f ms", gap * 1000))
+        }
+        let formats = Task199Log.formats()
+        if formats != lastFormats {
+            lastFormats = formats
+            Task199Log.log("formats now: \(formats)")
+        }
+        let refreshing = ContentBlockerManager.shared.refreshingIdentifiers.sorted().joined(separator: ",")
+        if refreshing != lastRefreshing {
+            lastRefreshing = refreshing
+            Task199Log.log("refreshing now: [\(refreshing)]")
+        }
+    }
+}
+
+extension AppDelegate {
+    /// Before ContentBlockerManager.initialize(): the list URL protocol, the
+    /// heartbeat and the notification log.
+    func startTask199HarnessIfRequested() {
+        guard Task199Log.logURL != nil else { return }
+        URLProtocol.registerClass(Task199ListProtocol.self)
+        Task199Log.log("start run=\(Task199Log.env["DETOUR_VERIFY_RUN"] ?? "run") formats at launch: \(Task199Log.formats())")
+        Task199Heartbeat.shared.start()
+        NotificationCenter.default.addObserver(forName: .contentBlockerRulesDidChange, object: nil, queue: .main) { _ in
+            Task199Log.log("contentBlockerRulesDidChange")
+        }
+    }
+
+    func runTask199HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard Task199Log.logURL != nil, let port = Task199Log.env["DETOUR_VERIFY_PORT"] else { return }
+        let log = Task199Log.log
+        let defaults = ContentBlockerStorage.current.defaults
+        let store = TabStore.shared
+
+        @MainActor func sleep(_ s: Double) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+        @MainActor func waitLoaded(_ tab: BrowserTab) async {
+            for _ in 0..<60 {
+                await sleep(0.25)
+                if !tab.isLoading, tab.url != nil, tab.webView != nil { break }
+            }
+            await sleep(1.5)
+        }
+        /// window.__loaded (the EasyList-blocked script ran), the computed
+        /// display of `.ad-slot` (EasyList generic hiding) and of
+        /// `.detour-control` (no rule), and the tab's blocked counter.
+        @MainActor func probe(_ tab: BrowserTab) async -> String {
+            guard let webView = tab.webView else { return "no webView" }
+            let js = "JSON.stringify({loaded: window.__loaded, adSlot: getComputedStyle(document.querySelector('.ad-slot')).display, control: getComputedStyle(document.querySelector('.detour-control')).display})"
+            let value = try? await webView.evaluateJavaScript(js)
+            return ((value as? String) ?? "nil") + " blockedCount=\(tab.blockedCount)"
+        }
+        func current() -> Bool {
+            ContentBlockerManager.filterLists.allSatisfy {
+                defaults.object(forKey: "ContentBlocker.\($0.identifier).rulesFormat") as? Int == EasyListParser.rulesFormatVersion
+            }
+        }
+
+        Task { @MainActor in
+            for _ in 0..<120 {
+                if ContentBlockerManager.shared.isCompiled(identifier: "easylist") { break }
+                await sleep(0.5)
+            }
+            log("easylist compiled=\(ContentBlockerManager.shared.isCompiled(identifier: "easylist")) count=\(ContentBlockerManager.shared.compiledRuleCount(for: "easylist") ?? -1)")
+            if Task199Log.env["DETOUR_VERIFY_WAIT_FORMAT"] == "1" {
+                for _ in 0..<480 {
+                    if current() && ContentBlockerManager.shared.refreshingIdentifiers.isEmpty { break }
+                    await sleep(0.25)
+                }
+                log("formats after waiting for the recompile: \(Task199Log.formats())")
+            }
+            await sleep(3.0)
+            guard let space = wc.activeSpace else { return log("no active space") }
+            for host in ["127.0.0.1", "localhost", "lvh.me"] {
+                let url = URL(string: "http://\(host):\(port)/page.html")!
+                let tab = store.addTab(in: space, url: url)
+                wc.selectTab(id: tab.id)
+                await waitLoaded(tab)
+                log("RESULT \(host): \(await probe(tab))")
+            }
+            for list in ContentBlockerManager.filterLists {
+                let id = list.identifier
+                log("LIST \(id): rulesFormat=\(defaults.object(forKey: "ContentBlocker.\(id).rulesFormat").map { "\($0)" } ?? "nil") ruleCount=\(defaults.integer(forKey: "ContentBlocker.\(id).ruleCount")) compiled=\(ContentBlockerManager.shared.compiledRuleCount(for: id) ?? -1) etag=\(defaults.string(forKey: "ContentBlocker.\(id).etag") ?? "nil") lastFetch=\(defaults.object(forKey: "ContentBlocker.\(id).lastFetch").map { "\($0)" } ?? "nil")")
+            }
+            let hb = Task199Heartbeat.shared
+            log(String(format: "heartbeat: max main-queue gap %.0f ms, %d gap(s) over 250 ms", hb.maxGap * 1000, hb.gapCount))
+            log("done")
+        }
+    }
+}
+#endif
