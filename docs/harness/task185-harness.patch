+        }
+        at(1.5) {
+            let host = tabs["normal"]!
+            let group = store.splitGroup(containing: host.id, in: space)
+            let right = group?.members.last
+            tabs["normalRight"] = right
+            describeTabs("after peek→split (normal)")
+            check("normal host: split of host + new pane", group?.members.count == 2 && group?.members.first === host)
+            check("normal host: right pane adopts the very web view", right?.webView === oldPeekWebView && oldPeekWebView != nil)
+            check("normal host: right pane keeps back history", right?.webView?.canGoBack == true,
+                  "url=\(right?.webView?.url?.lastPathComponent ?? "nil") back=\(right?.webView?.backForwardList.backList.map { $0.url.lastPathComponent } ?? [])")
+            check("normal host: right pane selected", wc.selectedTabID == right?.id)
+            check("normal host: right pane first responder", firstResponderIsInside(right?.webView),
+                  "firstResponder=\(String(describing: window.firstResponder))")
+            check("normal host: peek cleared", wc.peekOverlayView == nil && host.peekTab == nil && host.peekURL == nil)
+            check("normal host: both panes hosted in the split view", right.map { isHostedInSplit($0, in: window) } == true && isHostedInSplit(host, in: window))
+            check("normal host: undo action name", store.undoManager.undoActionName == "Open in Split", store.undoManager.undoActionName)
+            shoot("2-split-normal-host")
+        }
+        at(1.5) {
