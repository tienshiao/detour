+        // MARK: 1. Peek on an ungrouped normal host
+        var oldPeekWebView: WKWebView?
+        at(2.0) {
+            activate()
+            wc.selectTab(id: tabs["normal"]!.id)
+            wc.showPeekOverlay(url: url("peek1.html"))
+        }
+        at(2.0) {
