+        // MARK: 5. The link menu
+        // A real right-click: WebKit builds the menu, `willOpenMenu` adds ours,
+        // the hook picks Open Link in Split View while the menu is up.
+        var menuLegResult: [String: Bool] = [:]
+        func menuLeg(_ key: String, label: String, expect: @escaping () -> Void) {
+            at(2.0) {
+                activate()
+                wc.selectTab(id: tabs[key]!.id)
+                menuLegResult[label] = false
+                Task185Hook.menuOpened = { menu, webView in
+                    Task185Hook.menuOpened = nil
+                    let titles = menu.items.map(\.title)
+                    log("menu (\(label)) items=\(titles)")
+                    guard let index = menu.items.firstIndex(where: { $0.title == "Open Link in Split View" }) else {
+                        check("menu \(label): has Open Link in Split View", false); return
+                    }
+                    let item = menu.items[index]
+                    let original = item.representedObject as? NSMenuItem
+                    check("menu \(label): has Open Link in Split View after New Window",
+                          index > 0 && menu.items[index - 1].title == "Open Link in New Window")
+                    check("menu \(label): action/target/representedObject",
+                          item.action == #selector(BrowserWindowController.contextMenuOpenInSplitView(_:))
+                          && item.target === wc && original?.identifier?.rawValue == "WKMenuItemIdentifierOpenLinkInNewWindow",
+                          "action=\(String(describing: item.action)) original=\(original?.identifier?.rawValue ?? "nil")")
+                    menuLegResult[label] = true
+                    let timer = Timer(timeInterval: 0.3, repeats: false) { _ in
+                        menu.performActionForItem(at: index)
+                        menu.cancelTracking()
+                        log("menu (\(label)) performed Open Link in Split View")
+                    }
+                    RunLoop.main.add(timer, forMode: .common)
+                }
+            }
+            at(1.5) {
+                guard let webView = tabs[key]!.webView else { return log("\(label): no web view") }
+                linkPoint(in: webView) { p in
+                    guard let p else { return }
+                    log("right-click \(label) at \(p)")
+                    postClick(at: p, flags: [], right: true)
+                }
+            }
+            at(3.0) {
+                if menuLegResult[label] != true { log("menu \(label): no menu appeared") }
+                Task185Hook.menuOpened = nil
+                expect()
+            }
+        }
