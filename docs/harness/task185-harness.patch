+            shoot("9-menu-favourite")
+        }
+        at(1.0) { store.undoManager.undo() }
+        at(0.5) { tabs["splitB"]!.load(url("split-b.html")) }
+        menuLeg("normal", label: "normal") {
+            describeTabs("after menu split (normal)")
+            let group = store.splitGroup(containing: tabs["normal"]!.id, in: space)
+            check("menu normal: host + new right pane", group?.members.count == 2 && group?.members.first === tabs["normal"]
+                  && group?.members.last?.url?.lastPathComponent == "target.html")
+        }
+        at(1.0) { store.undoManager.undo() }
+        menuLeg("splitA", label: "split pane") {
+            describeTabs("after menu split (split)")
+            check("menu in a split: other pane loads the link", tabs["splitB"]!.url?.lastPathComponent == "target.html"
+                  && space.tabs.count == 3)
+        }
+        // In a Peek: no split item (synthetic menu through the same override).
+        at(2.0) {
+            wc.selectTab(id: tabs["normal"]!.id)
+            wc.showPeekOverlay(url: url("peek1.html"))
+        }
+        at(2.0) {
+            guard let peekWebView = tabs["normal"]!.peekTab?.webView as? BrowserWebView else { return log("no peek web view") }
+            let menu = NSMenu()
+            let original = NSMenuItem(title: "Open Link in New Window", action: nil, keyEquivalent: "")
+            original.identifier = NSUserInterfaceItemIdentifier("WKMenuItemIdentifierOpenLinkInNewWindow")
+            menu.addItem(original)
+            let event = NSEvent.mouseEvent(with: .rightMouseDown, location: NSPoint(x: 300, y: 300), modifierFlags: [],
+                                           timestamp: 0, windowNumber: window.windowNumber, context: nil,
+                                           eventNumber: 0, clickCount: 1, pressure: 1)!
+            peekWebView.willOpenMenu(menu, with: event)
+            log("peek menu items=\(menu.items.map(\.title))")
+            check("menu in a Peek: no split item", !menu.items.contains { $0.title == "Open Link in Split View" }
+                  && menu.items.contains { $0.title == "Open Link in New Tab" })
+            wc.closePeekOverlay()
+        }
+
+        // MARK: 6. A second window on the space must not steal the web view
+        var second: BrowserWindowController?
+        at(2.0) {
+            guard let appDelegate = NSApp.delegate as? AppDelegate else { return }
+            let b = appDelegate.createNewWindow(showing: space)
+            second = b
+            b.window?.setFrame(window.frame.offsetBy(dx: 60, dy: -60), display: true)
+            b.selectTab(id: tabs["normal"]!.id)
+            log("second window \(b.window?.windowNumber ?? 0) selected normal")
+        }
+        at(1.5) {
+            activate()   // window A takes the web view back on becoming key
+            wc.selectTab(id: tabs["normal"]!.id)
+            wc.showPeekOverlay(url: url("peek1.html"))
+        }
+        at(2.0) {
+            oldPeekWebView = tabs["normal"]!.peekTab?.webView
+            wc.openPeekInSplitView()
+        }
+        at(1.5) {
+            guard let b = second, let bWindow = b.window else { return }
+            let host = tabs["normal"]!
+            let right = store.splitGroup(containing: host.id, in: space)?.members.last
+            check("two windows: right pane adopts the peek web view", right?.webView === oldPeekWebView)
+            check("two windows: both panes live in window A", right?.webViewContainer?.window === window && host.webViewContainer?.window === window,
+                  "right in \(right?.webViewContainer?.window?.windowNumber ?? -1), host in \(host.webViewContainer?.window?.windowNumber ?? -1)")
+            let bShowsSnapshot = b.contentContainerView.subviews.contains { $0 is NSImageView }
+            let bHostsLive = b.contentContainerView.subviews.contains { $0 is NSSplitView || $0 is WebViewContainerView }
+            check("two windows: window B shows a snapshot, not the live view", bShowsSnapshot && !bHostsLive,
+                  "B subviews=\(b.contentContainerView.subviews.map { String(describing: type(of: $0)) })")
+            shoot("10-two-windows-A")
+            shoot("10-two-windows-B", bWindow)
+        }
+        at(1.5) {
+            store.undoManager.undo()
+            second?.window?.close()
+            second = nil
+        }
+        at(1.5) {
+            describeTabs("final")
+            log("RESULT passes=\(passes) failures=\(failures)")
+            log("done")
+        }
+    }
+}
+#endif
