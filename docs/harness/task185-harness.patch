+        at(2.0) {
+            check("normal host: peek can go back before hand-off", oldPeekWebView?.canGoBack == true,
+                  "url=\(oldPeekWebView?.url?.lastPathComponent ?? "nil")")
+            shoot("1-peek-normal-host")
+        }
+        at(1.0) {
+            log("openPeekInSplitView (normal host)")
