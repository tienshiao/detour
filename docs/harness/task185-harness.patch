+            _ = store.moveTabToFavorites(id: tabs["fav"]!.id, from: space, profileID: profileID)
+            store.createSplit(draggedTabID: tabs["splitB"]!.id, targetTabID: tabs["splitA"]!.id, edge: .right, in: space)
+            store.createSplit(draggedTabID: tabs["psplitB"]!.id, targetTabID: tabs["psplitA"]!.id, edge: .right, in: space)
+            if let g = tabs["psplitA"]!.splitGroupID { store.pinSplitGroup(groupID: g, in: space) }
+            // Leftover tabs of a fresh profile (a New Tab) are closed so the list reads clearly.
+            for tab in space.tabs where !tabs.values.contains(where: { $0 === tab }) {
+                store.closeTab(id: tab.id, in: space, undoable: false)
+            }
+            store.undoManager.removeAllActions()
+            wc.selectTab(id: tabs["normal"]!.id)
+            describeTabs("arranged")
+        }
