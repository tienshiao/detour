+/// Lets the harness see the link menu WebKit is about to show.
+enum Task185Hook {
+    static var menuOpened: ((NSMenu, BrowserWebView) -> Void)?
+}
+
+extension AppDelegate {
+    func runTask185HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"],
+              let base = ProcessInfo.processInfo.environment["TASK185_BASE"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%7.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var passes = 0, failures = 0
+        func check(_ name: String, _ ok: Bool, _ detail: @autoclosure () -> String = "") {
+            if ok { passes += 1 } else { failures += 1 }
+            log("\(ok ? "PASS" : "FAIL") \(name)\(detail().isEmpty ? "" : " — \(detail())")")
+        }
+        var clock: TimeInterval = 2.0
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) {
+            clock += dt
+            let timer = Timer(timeInterval: clock, repeats: false) { _ in block() }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window else { return log("no window") }
+        let store = TabStore.shared
+        func url(_ path: String) -> URL { URL(string: "\(base)/\(path)")! }
+        var tabs: [String: BrowserTab] = [:]
+        var space: Space { wc.activeSpace! }
+
+        func shoot(_ name: String, _ w: NSWindow? = nil) {
+            log("SHOOT \(name) \((w ?? window).windowNumber)")
+        }
+        func name(_ tab: BrowserTab?) -> String {
+            guard let tab else { return "nil" }
+            return tabs.first { $0.value === tab }?.key ?? (tab.url?.lastPathComponent ?? "?")
+        }
+        func describeTabs(_ label: String) {
+            log("\(label): tabs=\(space.tabs.map { "\(name($0))\($0.splitGroupID.map { "[\($0.uuidString.prefix(4))]" } ?? "")" }) "
+                + "pinned=\(space.pinnedEntries.map { "\($0.pinnedTitle)\($0.splitGroupID.map { "[\($0.uuidString.prefix(4))]" } ?? "")" }) "
+                + "selected=\(name(wc.selectedTab)) closed=\(store.closedTabRecords(in: space).count)")
+        }
+        func isHostedInSplit(_ tab: BrowserTab, in w: NSWindow) -> Bool {
+            guard let container = tab.webViewContainer else { return false }
+            return container.superview is NSSplitView && container.window === w
+        }
+        func firstResponderIsInside(_ webView: WKWebView?) -> Bool {
+            guard let webView, let view = window.firstResponder as? NSView else { return false }
+            return view === webView || view.isDescendant(of: webView)
+        }
+        /// The centre of `#l` in window coordinates.
+        func linkPoint(in webView: WKWebView, _ done: @escaping (NSPoint?) -> Void) {
+            webView.evaluateJavaScript("(() => { const r = document.getElementById('l').getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; })()") { result, error in
+                guard let xy = result as? [Double], xy.count == 2 else {
+                    log("linkPoint error \(String(describing: error))"); return done(nil)
+                }
+                let y = webView.isFlipped ? xy[1] : webView.bounds.height - xy[1]
+                done(webView.convert(NSPoint(x: xy[0], y: y), to: nil))
+            }
+        }
+        func postClick(at p: NSPoint, flags: NSEvent.ModifierFlags, right: Bool = false) {
+            let types: [NSEvent.EventType] = right ? [.rightMouseDown, .rightMouseUp] : [.leftMouseDown, .leftMouseUp]
+            for type in types {
+                let e = NSEvent.mouseEvent(with: type, location: p, modifierFlags: flags,
+                                           timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: window.windowNumber, context: nil,
+                                           eventNumber: 0, clickCount: 1,
+                                           pressure: (type == .leftMouseDown || type == .rightMouseDown) ? 1 : 0)!
+                NSApp.postEvent(e, atStart: false)
+            }
+        }
+        func activate() {
+            NSApp.activate(ignoringOtherApps: true)
+            window.makeKeyAndOrderFront(nil)
+        }
+
+        // MARK: Seed
+        at(0) {
+            activate()
+            for (key, path) in [("normal", "host.html"), ("pinned", "pinned.html"), ("fav", "fav.html"),
+                                ("splitA", "split-a.html"), ("splitB", "split-b.html"),
+                                ("psplitA", "psplit-a.html"), ("psplitB", "psplit-b.html")] {
