+                    log("links caption bottom gap to window bottom: \(fixed.first(where: { $0.stringValue.hasPrefix("For every link") }).map { Int($0.convert($0.bounds, to: nil).minY - margin) } ?? -1)")
+                }
+                await setContentHeight(sw.contentMaxSize.height)
+                log("links at max \(height()): \(scrolls.first.map(describe) ?? "-") fixed: \(fixedFrames())")
+            }
+
+            // Quick Detour: its own pane, one scrolling body.
+            if let pane = await showPane("quickdetour") {
+                log("quickdetour: height=\(height()) \(bounds()) bodyScroll=\(pane.scrollView == nil ? "none" : "present")")
+                for t in texts(pane.view) where !t.isHidden && !t.stringValue.isEmpty {
