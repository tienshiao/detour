+    func diff(_ x: NSBitmapImageRep?, _ y: NSBitmapImageRep?) -> String {
+        guard let x, let y else { return "n/a" }
+        guard x.pixelsWide == y.pixelsWide, x.pixelsHigh == y.pixelsHigh, x.bytesPerRow == y.bytesPerRow,
+              x.bitsPerPixel == y.bitsPerPixel, let px = x.bitmapData, let py = y.bitmapData else {
+            return "different geometry \(x.pixelsWide)x\(x.pixelsHigh) vs \(y.pixelsWide)x\(y.pixelsHigh)"
+        }
+        let bpp = x.bitsPerPixel / 8
+        var count = 0, minX = Int.max, minY = Int.max, maxX = -1, maxY = -1
+        for row in 0..<x.pixelsHigh {
+            for col in 0..<x.pixelsWide {
+                let offset = row * x.bytesPerRow + col * bpp
+                var same = true
+                for k in 0..<bpp where px[offset + k] != py[offset + k] { same = false; break }
+                if !same {
+                    count += 1
+                    minX = min(minX, col); maxX = max(maxX, col); minY = min(minY, row); maxY = max(maxY, row)
+                }
+            }
+        }
+        let total = x.pixelsWide * x.pixelsHigh
+        return count == 0 ? "differingPixels=0 of \(total) (identical)"
+            : "differingPixels=\(count) of \(total), bbox px x \(minX)...\(maxX) y \(minY)...\(maxY)"
+    }
