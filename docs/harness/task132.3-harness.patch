+        log("  content area before attach vs re-parked (A's field is focused now): \(diff(contentBefore, contentReparked))")
+
+        // ---- 6. detach
+        log("=== 6. detach")
+        b.detachAutomation(owner)
+        log("  " + hosting(b))
+        log("  container.superview=\(b.webViewContainer?.superview == nil ? "nil" : "NOT nil") webView.window=\(name(b.webView?.window)) "
+            + "W1 parked=\(wc.automationParkedContainers.count) web view kept (awake)=\(b.webView === webViewB) "
+            + "drivable=\(b.automationDrivableWebView() == nil ? "nil" : "non-nil")")
+        state("after detach")
+        log("  B page after detach: " + (await pageReport(b)))
+
+        // ---- 7. a second window on the same space
+        log("=== 7. second window on the same space")
+        b.attachAutomation(owner)
+        log("  re-attached: " + hosting(b))
+        let wc2 = app.createNewWindow(showing: space)
+        if let w2 = wc2.window { windowNames[ObjectIdentifier(w2)] = "W2" }
+        wc2.selectTab(id: c.id)
+        await sleep(2)
+        log("  7a. W2 open showing C")
+        state("7a")
+        for tab in tabs { log("  " + hosting(tab)) }
+
+        wc2.selectTab(id: b.id)
+        await sleep(2)
+        log("  7b. W2 selects B (parked in W1)")
+        state("7b")
+        log("  " + hosting(b) + " sameWebView=\(b.webView === webViewB)")
+        _ = capture(wc2.contentContainerView, "content-5-w2-b-selected.png")
+        _ = capture(wc.contentContainerView, "content-6-w1-while-w2-shows-b.png")
+
+        wc2.selectTab(id: c.id)
+        await sleep(1.5)
+        log("  7c. W2 selects C: B should park in W2 (the window that just stopped displaying it)")
+        state("7c")
+        log("  " + hosting(b))
+
+        wc.selectTab(id: b.id)
+        await sleep(1.5)
+        log("  7d. W1 selects B: claims it out of W2's parking host")
+        state("7d")
+        log("  " + hosting(b) + " sameWebView=\(b.webView === webViewB)")
+
+        wc2.selectTab(id: b.id)
+        await sleep(1.5)
+        log("  7e. W2 also selects B while W1 displays it")
+        state("7e")
+        log("  " + hosting(b))
+        log("  W2 content subviews: \(wc2.contentContainerView.subviews.map { String(describing: type(of: $0)) })")
+
+        wc.selectTab(id: a.id)
+        await sleep(1.5)
+        log("  7f. W1 selects A; W2 still has B selected")
+        state("7f")
+        log("  " + hosting(b))
+
+        wc2.ensureOwnsWebView()
+        await sleep(1.5)
+        log("  7g. W2.ensureOwnsWebView() (what windowDidBecomeKey does)")
+        state("7g")
+        log("  " + hosting(b) + " sameWebView=\(b.webView === webViewB)")
+
+        wc2.selectTab(id: c.id)
+        await sleep(1.5)
+        log("  7h. W2 selects C: B parks in W2")
+        log("  " + hosting(b))
+        wc2.window?.close()
+        await sleep(1.5)
+        log("  7i. W2 closed while B was parked in it")
+        state("7i")
+        log("  " + hosting(b) + " sameWebView=\(b.webView === webViewB)")
+        log("  B page still alive: " + (await pageReport(b)))
+
+        if keyLeg { await runKeyLeg(space: space, window: window, a: a, b: b, c: c) }
+
+        b.detachAutomation(owner)
+        log("=== end: detached. " + hosting(b))
+        state("end")
+    }
+
+    /// The paths that only exist with a key window: WebKit handing a declined
+    /// key back through NSApp.sendEvent, and the windowDidBecomeKey hand-off.
+    /// Activates the app for a few seconds, then gives the front app back.
+    func runKeyLeg(space: Space, window: BrowserWindow, a: BrowserTab, b: BrowserTab, c: BrowserTab) async {
+        log("=== 8. key-window leg (activates the app briefly)")
+        let previousApp = NSWorkspace.shared.frontmostApplication
+        log("  frontmost app before: \(previousApp?.localizedName ?? "nil")")
+        NSApp.activate(ignoringOtherApps: true)
+        window.makeKeyAndOrderFront(nil)
+        await waitUntil("W1 to become key", timeout: 5) { window.isKeyWindow }
+        state("8 activated")
+        log("  " + hosting(b))
+        guard window.isKeyWindow, let parked = b.automationDrivableWebView() else {
+            log("  W1 did not become key (or no drivable web view); skipping")
+            previousApp?.activate()
+            return
+        }
+        log("  focus A's field: " + (await js(a, "document.getElementById('i').focus(); return document.activeElement.id")))
+        _ = await js(b, "document.activeElement.blur(); log.length = 0; return 1")
+        _ = await js(a, "log.length = 0; return 1")
+        let droppedBefore = AutomationInput.droppedKeyDownCount
+        typeKey("j", keyCode: 38, in: parked)
+        await waitUntil("WebKit to hand the declined 'j' back", timeout: 5) { AutomationInput.droppedKeyDownCount == droppedBefore + 1 }
+        await sleep(0.4)
+        log("  declined key with W1 key: dropped=\(AutomationInput.droppedKeyDownCount - droppedBefore)")
+        log("  parked B: " + (await pageReport(b)))
+        log("  selected A: " + (await pageReport(a)))
+        // Control: the same kind of key sent raw, not through AutomationInput —
+        // the hazard its event monitor exists for.
+        if let rawWindow = parked.window,
+           let raw = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [],
+                                      timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: rawWindow.windowNumber,
+                                      context: nil, characters: "q", charactersIgnoringModifiers: "q",
+                                      isARepeat: false, keyCode: 12) {
+            parked.keyDown(with: raw)
+            await sleep(0.6)
+            log("  CONTROL raw webView.keyDown('q') to parked B, bypassing AutomationInput: dropped=\(AutomationInput.droppedKeyDownCount - droppedBefore); A: " + (await pageReport(a)))
+            _ = await js(a, "document.getElementById('i').value = ''; log.length = 0; return 1")
+        }
+        click(parked, pageX: 80, pageY: 40)
+        await waitUntil("click on B's button", timeout: 10) { await self.js(b, "return log.join(' ')").contains("click/T/b") }
+        log("  after click on parked B: W1 firstResponder=\(describe(window.firstResponder)) keyWindow=\(name(NSApp.keyWindow)); A: " + (await pageReport(a)))
+
+        // Real hand-off: a second window that shows a snapshot of B becomes key.
+        wc.selectTab(id: b.id)
+        await sleep(1)
+        let wc2 = app.createNewWindow(showing: space)
+        if let w2 = wc2.window { windowNames[ObjectIdentifier(w2)] = "W2b" }
+        await sleep(1.5)
+        log("  8a. W1 displays B; new window W2b shown (showWindow makes it key)")
+        state("8a")
+        wc2.selectTab(id: b.id)
+        await sleep(1.5)
+        log("  8b. W2b (key) selects B")
+        state("8b")
+        log("  " + hosting(b))
+        window.makeKeyAndOrderFront(nil)
+        await sleep(1.5)
+        log("  8c. W1 made key again (both windows have B selected)")
+        state("8c")
+        log("  " + hosting(b))
+        wc.selectTab(id: a.id)
+        await sleep(1.5)
+        log("  8d. W1 (key) selects A: B should park in W1; W2b shows a snapshot of B")
+        state("8d")
+        log("  " + hosting(b))
+        log("  W2b content subviews: \(wc2.contentContainerView.subviews.map { String(describing: type(of: $0)) })")
+        wc2.window?.makeKeyAndOrderFront(nil)
+        await sleep(1.5)
+        log("  8e. W2b becomes key: claims B out of W1's parking host via windowDidBecomeKey")
+        state("8e")
+        log("  " + hosting(b))
+        wc2.window?.close()
+        await sleep(1.5)
+        log("  8f. W2b closed while displaying B")
+        state("8f")
+        log("  " + hosting(b))
+        previousApp?.activate()
+        await sleep(1)
+        log("  gave the front back to \(previousApp?.localizedName ?? "nil"); app.isActive=\(NSApp.isActive)")
+    }
+}
+#endif
