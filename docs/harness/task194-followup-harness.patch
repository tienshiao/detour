+            // 3. A tracked download link: the download question.
+            let q3 = QuickDetourWindowController.openQuarantine(url: URL(string: base + "/dl")!,
+                                                               privateProfile: privateProfile, sourceSpace: home)
+            _ = await waitFor("the download page") { q3.tab?.title == "Download" && q3.tab?.isLoading == false }
