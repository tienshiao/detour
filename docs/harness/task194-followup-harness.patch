+// TEMP TASK-194 follow-up verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    func runTask194FollowupHarnessIfRequested(_ wc: BrowserWindowController) {
+        let env = ProcessInfo.processInfo.environment
+        guard let outDir = env["DETOUR_VERIFY_DIR"] else { return }
+        let port = env["DETOUR_VERIFY_PORT"] ?? "8795"
+        let base = "http://127.0.0.1:\(port)"
+        let ap = env["DETOUR_VERIFY_APPEARANCE"] ?? "light"
+        let serverLog = env["DETOUR_VERIFY_SERVER_LOG"] ?? ""
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify-\(ap).log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%7.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        NSApp.appearance = NSAppearance(named: ap == "dark" ? .darkAqua : .aqua)
+        let store = TabStore.shared
+        // Never the real ~/Downloads.
+        if let dir = env["DETOUR_VERIFY_DOWNLOADS"] {
+            DownloadManager.shared.downloadsDirectory = URL(fileURLWithPath: dir)
+        }
+
+        @MainActor func sleep(_ s: Double) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+        func humanIdle() -> Double {
+            CGEventSource.secondsSinceLastEventType(.combinedSessionState, eventType: CGEventType(rawValue: ~0)!)
+        }
+        func awaitIdle(_ seconds: Double = 12) async {
+            var waited = 0.0
+            while humanIdle() < seconds {
+                if waited == 0 { log("waiting for the machine to be idle (idle \(Int(humanIdle())) s)") }
+                await sleep(2); waited += 2
+            }
+            if waited > 0 { log("idle again after \(Int(waited)) s") }
+        }
+        func ensureFront(_ window: NSWindow?) async {
+            await awaitIdle()
+            for _ in 0..<6 {
+                if !NSApp.isActive { NSApp.activate(ignoringOtherApps: true) }
+                if let window, NSApp.keyWindow !== window { window.makeKeyAndOrderFront(nil) }
+                if NSApp.isActive && (window == nil || NSApp.keyWindow === window) { return }
+                await sleep(0.5)
+            }
+            // Cooperative activation keeps another app in front: order the
+            // window above it anyway (no activation; setting a floating level
+            // here traps in AppKit), so it is not occluded and WebKit renders it.
+            window?.orderFrontRegardless()
+            await sleep(0.5)
+            log("not frontmost (active=\(NSApp.isActive)): floated; occluded=\(window.map { !$0.occlusionState.contains(.visible) } ?? true)")
+        }
+        func shoot(_ name: String, _ window: NSWindow?) async {
+            guard let window else { return log("no window for \(name)") }
+            await sleep(0.8)
+            log("SHOOT \(ap)-\(name) \(window.windowNumber)")
+            await sleep(1.5)
+        }
+        var eventNumber = 9500
+        func post(_ e: NSEvent?) { if let e { NSApp.postEvent(e, atStart: false) } }
+        func clickLink(_ id: String, in webView: WKWebView?, mods: NSEvent.ModifierFlags = []) async {
+            guard let webView, let window = webView.window else { return log("clickLink \(id): no web view") }
+            let js = "(() => { const e = document.getElementById('\(id)'); if (!e) return null; e.scrollIntoView({block: 'center'}); const b = e.getBoundingClientRect(); return [b.x + Math.min(20, b.width / 2), b.y + b.height / 2]; })()"
+            guard let r = try? await webView.evaluateJavaScript(js) as? [Double] else { return log("clickLink \(id): no element") }
+            if humanIdle() < 1 { return log("ABORT human input before a click: not posted") }
+            let p = webView.convert(NSPoint(x: r[0], y: r[1]), to: nil)
+            if mods.isEmpty && !NSApp.isActive {
+                // An inactive app's window takes a plain first click as an
+                // activation click (refused: another app is active), so the
+                // page never sees it. Handed to the web view itself, as the
+                // window would once active: real AppKit events to WebKit.
+                func make(_ type: NSEvent.EventType) -> NSEvent? {
+                    eventNumber += 1
+                    return NSEvent.mouseEvent(with: type, location: p, modifierFlags: [],
+                                              timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber,
+                                              context: nil, eventNumber: eventNumber, clickCount: 1,
+                                              pressure: type == .leftMouseDown ? 1 : 0)
+                }
+                if let down = make(.leftMouseDown), let up = make(.leftMouseUp) {
+                    webView.mouseDown(with: down)
+                    await sleep(0.1)
+                    webView.mouseUp(with: up)
+                }
+                log("clickLink \(id): handed to the web view (app inactive)")
+                return
+            }
+            for type in [NSEvent.EventType.mouseMoved, .leftMouseDown, .leftMouseUp] {
+                eventNumber += 1
+                post(NSEvent.mouseEvent(with: type, location: p, modifierFlags: mods,
+                                        timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber,
+                                        context: nil, eventNumber: eventNumber, clickCount: type == .mouseMoved ? 0 : 1,
+                                        pressure: type == .leftMouseDown ? 1 : 0))
+            }
+        }
+        func key(_ chars: String, keyCode: UInt16, to window: NSWindow) {
+            for type in [NSEvent.EventType.keyDown, .keyUp] {
+                post(NSEvent.keyEvent(with: type, location: .zero, modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime,
+                                      windowNumber: window.windowNumber, context: nil, characters: chars,
+                                      charactersIgnoringModifiers: chars, isARepeat: false, keyCode: keyCode))
+            }
+        }
+        func waitFor(_ what: String, timeout: Double = 15, _ cond: () -> Bool) async -> Bool {
+            let deadline = Date().addingTimeInterval(timeout)
+            while Date() < deadline {
+                if cond() { return true }
+                await sleep(0.25)
+            }
+            log("TIMEOUT waiting for \(what)")
+            return false
+        }
+        func quarantines() -> [QuickDetourWindowController] { QuickDetourWindowController.openControllers.filter(\.isQuarantine) }
+        func serverLines(_ needle: String) -> [String] {
+            ((try? String(contentsOfFile: serverLog, encoding: .utf8)) ?? "").split(separator: "\n")
+                .map(String.init).filter { $0.contains(needle) }
+        }
+        func closeAll() {
+            for q in quarantines() { q.closeDisposition = .discard; q.close() }
+        }
+
+        Task { @MainActor in
+            await sleep(2.5)
+            log("start \(ap)")
+            let privateProfile = store.ensureIncognitoProfile()
+            let home = wc.activeSpace ?? store.nonIncognitoSpaces.first!
+
+            // 1. A client redirect back to utm_*: the page settles.
+            let before1 = serverLines("/replace").count
+            let q1 = QuickDetourWindowController.openQuarantine(url: URL(string: base + "/replace")!,
+                                                               privateProfile: privateProfile, sourceSpace: home)
+            _ = await waitFor("the replace page to settle") { q1.tab?.title == "Replaced" && q1.tab?.isLoading == false }
+            await sleep(3)
+            let loads = serverLines("/replace").dropFirst(before1)
+            log("1 loop: url=\(q1.tab?.url?.absoluteString ?? "nil") title=\(q1.tab?.title ?? "nil") loading=\(q1.tab?.isLoading ?? true) requests(\(loads.count))=\(Array(loads))")
+            await ensureFront(q1.window)
+            await shoot("01-replace-settled", q1.window)
+
+            // 1b. A real click on an anchor of that page: no reload.
+            let before1b = serverLines("/replace").count
+            await clickLink("anchor", in: q1.tab?.webView)
+            _ = await waitFor("the anchor") { q1.tab?.webView?.url?.fragment == "section" }
+            await sleep(1.5)
+            let marker = try? await q1.tab?.webView?.evaluateJavaScript("window.marker") as? String
+            log("1b anchor: url=\(q1.tab?.webView?.url?.absoluteString ?? "nil") marker=\(marker ?? "nil") newRequests=\(serverLines("/replace").count - before1b)")
+            closeAll()
+
+            // 2. Cmd+click in a quarantine: the user's opens one; a page timer's
+            // synthetic Cmd+click opens none; a burst handler from one real
+            // Cmd+click is counted.
+            let q2 = QuickDetourWindowController.openQuarantine(url: URL(string: base + "/cmd")!,
+                                                               privateProfile: privateProfile, sourceSpace: home)
+            _ = await waitFor("the cmd page") { q2.tab?.title == "Cmd" && q2.tab?.isLoading == false }
+            await ensureFront(q2.window)
+            await clickLink("plain", in: q2.tab?.webView, mods: .command)
+            _ = await waitFor("the user's Cmd+click quarantine") { quarantines().count == 2 }
+            await sleep(1)
+            let others = quarantines().filter { $0 !== q2 }
+            log("2a user's Cmd+click: quarantines=\(quarantines().count) newURL=\(others.first?.tab?.url?.absoluteString ?? "nil") ownStore=\(others.first?.quarantine !== q2.quarantine) cmdPageStays=\(q2.tab?.url?.path ?? "nil")")
+            for q in others { q.closeDisposition = .discard; q.close() }
+
+            _ = try? await q2.tab?.webView?.evaluateJavaScript("window.timerCmdClick(); true")
+            await sleep(4)
+            log("2b page timer's Cmd+click: quarantines=\(quarantines().count) cmdPage=\(q2.tab?.url?.absoluteString ?? "nil") server=\(serverLines("n=timer"))")
+            if q2.tab?.url?.path != "/cmd" {
