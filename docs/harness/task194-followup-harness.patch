    #!/bin/zsh
    # run.sh <light|dark>: launches the harness build, serves SHOOT/SHOOTRECT
    # lines from the log with screencapture, kills only the launched PID.
    SP=/private/tmp/claude-501/-Users-tma-Projects-browser-MyBrowser/953f551f-71df-4025-b208-16f0ecfa685a/scratchpad/task194f
    AP=$1
    APP=/Users/tma/Projects/browser/MyBrowser/.derived/Build/Products/Debug/Detour.app
    LOG=$SP/out/verify-$AP.log
    rm -f -- $LOG
    DETOUR_DATA_DIR=DetourVerify1941 DETOUR_VERIFY_DIR=$SP/out DETOUR_VERIFY_APPEARANCE=$AP \
      DETOUR_VERIFY_PORT=8795 DETOUR_VERIFY_SERVER_LOG=$SP/out/server.log DETOUR_VERIFY_DOWNLOADS=$SP/downloads \
      "$APP/Contents/MacOS/Detour" > $SP/out/stderr-$AP.log 2>&1 &
    PID=$!
    echo "launched $PID"
    seen=0
    for i in $(seq 1 900); do
      sleep 0.5
      [ -f $LOG ] || continue
      total=$(wc -l < $LOG)
      if [ $total -gt $seen ]; then
        sed -n "$((seen+1)),${total}p" $LOG | while read -r line; do
          case "$line" in
            *"SHOOT "*) set -- ${=line#*SHOOT }; screencapture -x -o -l $2 $SP/out/$1.png && echo "shot $1";;
            *"SHOOTRECT "*) set -- ${=line#*SHOOTRECT }; screencapture -x -R $2 $SP/out/$1.png && echo "shot $1";;
          esac
        done
        seen=$total
      fi
      if grep -q "^\[.*\] done" $LOG; then break; fi
      kill -0 $PID 2>/dev/null || { wait $PID; echo "app exited status $?"; break; }
    done
    kill $PID 2>/dev/null; echo "killed $PID"

