    # TASK-194 follow-up harness fixture. Usage: python3 -I server.py PORT LOGFILE
    import sys
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    
    PORT = int(sys.argv[1])
    LOG = sys.argv[2]
    STYLE = 'style="font: 15px -apple-system; padding: 24px"'
    
    REPLACE = """<html><head><script>location.replace('/replace?utm_source=loop');</script></head><body>replacing</body></html>"""
    REPLACED = """<html><head><title>Replaced</title><script>window.marker = 'kept';</script></head><body %s>
    <h2>Landed with its parameters</h2><p id="u"></p><script>document.getElementById('u').textContent = location.href;</script>
    <p><a id="anchor" href="#section">Jump to the section</a></p><div style="height: 900px"></div><h3 id="section">Section</h3></body></html>""" % STYLE
    CMD = """<html><head><title>Cmd</title></head><body %s><h2>Cmd+click</h2>
    <p><a id="plain" href="/probe?n=plain">A link (the user's Cmd+click)</a></p>
    <p><a id="burst" href="/probe?n=burst">A link whose click handler clicks another link five times</a></p>
    <p><a id="target" href="/probe?n=target">target</a></p>
    <p><a id="timer" href="/probe?n=timer">target of the page's timer</a></p>
    <script>
    document.getElementById('burst').addEventListener('click', (e) => {
      e.preventDefault();
      for (let i = 0; i < 5; i++) document.getElementById('target').click();
    });
    window.timerCmdClick = () => setTimeout(() => document.getElementById('timer').dispatchEvent(
      new MouseEvent('click', { bubbles: true, cancelable: true, metaKey: true })), 1500);
    </script></body></html>""" % STYLE
    PROBE = """<html><head><title>Probe</title></head><body %s><h2>Probe</h2><p id="u"></p>
    <script>document.getElementById('u').textContent = location.href;</script></body></html>""" % STYLE
    DL = """<html><head><title>Download</title></head><body %s><h2>Download</h2>
    <p><a id="dl" href="/report.txt?utm_source=x" download="report.txt">Download report.txt (tracked link)</a></p></body></html>""" % STYLE
    
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def do_GET(self):
            with open(LOG, 'a') as f:
                f.write("%s %s referer=%s\n" % (self.headers.get('Host'), self.path, self.headers.get('Referer')))
            path, _, query = self.path.partition('?')
            headers = {'Content-Type': 'text/html; charset=utf-8'}
            status = 200
            if path == '/replace': body = REPLACED if query else REPLACE
            elif path == '/cmd': body = CMD
            elif path == '/probe': body = PROBE
            elif path == '/dl': body = DL
            elif path == '/report.txt': body = 'quarantined report\n'; headers['Content-Type'] = 'text/plain'
            else: status = 404; body = 'not found'
            data = body.encode()
            self.send_response(status)
            for k, v in headers.items(): self.send_header(k, v)
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
    
    ThreadingHTTPServer(('127.0.0.1', PORT), H).serve_forever()

