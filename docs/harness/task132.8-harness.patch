+extension AppDelegate {
+    /// Env-gated: `DETOUR_SP_HARNESS_DIR` (output directory), `DETOUR_SP_HARNESS_MODE`
+    /// (explorer | width | claude), `DETOUR_SP_HARNESS_EXT` (extension id),
+    /// `DETOUR_SP_HARNESS_URL` (base URL of the loopback pages, with one.html / two.html / three.html).
+    func runSidePanelHarnessIfRequested(_ wc: BrowserWindowController) {
+        let env = ProcessInfo.processInfo.environment
+        guard let outDir = env["DETOUR_SP_HARNESS_DIR"], let extID = env["DETOUR_SP_HARNESS_EXT"],
+              let base = env["DETOUR_SP_HARNESS_URL"].flatMap(URL.init(string:)) else { return }
+        let mode = env["DETOUR_SP_HARNESS_MODE"] ?? "explorer"
+        Task { @MainActor in
+            let harness = SidePanelHarness(wc: wc, outDir: URL(fileURLWithPath: outDir), extID: extID, base: base)
+            harness.log("harness armed pid=\(ProcessInfo.processInfo.processIdentifier) mode=\(mode)")
+            switch mode {
+            case "claude": await harness.runClaude()
+            case "width": await harness.runWidth()
+            case "inspector": await harness.runInspector()
+            default: await harness.runExplorer()
+            }
+            harness.log("DONE")
+        }
+    }
+}
