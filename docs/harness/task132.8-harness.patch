+            frames("window 1400 wide")
+            await capture("wide-window")
+            window.setFrame(original, display: true)
+            await sleep(0.5)
+        }
+
+        log("== 9. window.close() in the panel page, then reopen: remembered width")
+        if let panelWebView = panel?.webView {
+            _ = await realClick(panelWebView, id: "btn-panel-close")
+            await sleep(1.0)
+            await panelState("after window.close()")
+            frames("after window.close()")
+        }
+        if let popup = await openPopup() {
+            log("    via worker still checked: " + (await js(popup, "return String(document.getElementById('chk-sidepanel-worker').checked);")))
+            await step(popup, "open tab panel again", button: "btn-sidepanel-open-tab", result: "res-sidepanel")
+            await step(popup, "toggle openPanelOnActionClick", button: "btn-sidepanel-behavior", result: "res-sidepanel")
+            await step(popup, "toggle it back", button: "btn-sidepanel-behavior", result: "res-sidepanel")
+            await step(popup, "disable for tab", button: "btn-sidepanel-disable-tab", result: "res-sidepanel")
+            await sleep(0.5)
+            await panelState("after disable for tab")
+            await step(popup, "open tab panel (re-enables)", button: "btn-sidepanel-open-tab", result: "res-sidepanel")
+            await step(popup, "close (tab)", button: "btn-sidepanel-close-tab", result: "res-sidepanel")
+            await panelState("after close (tab)")
+            await step(popup, "open tab panel once more", button: "btn-sidepanel-open-tab", result: "res-sidepanel")
+            await closePopup()
+        }
+        await sleep(1.0)
+        await panelState("reopened")
+        frames("reopened: remembered width")
+        await capture("reopened")
+
+        log("== 10. closing the tab tears its panel down; disabling the extension closes the rest")
+        let before = ExtensionSidePanelController.allPanels.count
+        TabStore.shared.closeTab(id: tab1.id, in: space, undoable: false, registersUndo: false)
+        await sleep(0.8)
+        log("    panels open: \(before) -> \(ExtensionSidePanelController.allPanels.count) after closing tab one")
+        frames("tab one closed")
+        if let popup = await openPopup() {
+            _ = await realClick(popup, id: "chk-sidepanel-worker")
