+    // MARK: Web Inspector docking, without and with a panel
+
+    func runInspector() async {
+        log("START inspector ext=\(extID) \(focusState())")
+        guard await waitForContext(), let space = wc.activeSpace else { return }
+        let tab = await openTab("one.html", in: space)
+        frames("no panel")
+        await inspect(tab.webView, container: tab.webViewContainer, "baseline: no panel was ever opened", shot: "baseline-inspector")
+        let result = wc.activeSpace?.profile?.sidePanels.open(extensionID: extID, tab: nil, window: wc, focus: false)
+        if case .failure(let error)? = result { log("open failed: \(error.message)") }
+        await sleep(2.0)
+        frames("window panel open")
+        await inspect(tab.webView, container: tab.webViewContainer, "with a panel open", shot: "panel-open-inspector")
+        if let shown = panel {
+            wc.activeSpace?.profile?.sidePanels.close(shown, reason: .user)
+            await sleep(1.0)
+            frames("panel closed")
+            await inspect(tab.webView, container: tab.webViewContainer, "after the panel closed", shot: "panel-closed-inspector")
+        }
+    }
+
+    // MARK: Remembered width across a relaunch
+
+    func runWidth() async {
+        log("START width ext=\(extID)")
+        guard await waitForContext(), let space = wc.activeSpace else { return }
+        let tab = await openTab("one.html", in: space)
+        log("    remembered width at launch=\(SidePanelWidthStore.width) key=\(SidePanelWidthStore.defaultsKey)")
+        let result = wc.activeSpace?.profile?.sidePanels.open(extensionID: extID, tab: nil, window: wc, focus: false)
+        log("    open window panel natively: \(String(describing: result.map { if case .failure(let e) = $0 { return e.message } else { return "ok" } }))")
+        await sleep(1.5)
+        frames("after a relaunch")
+        await capture("after-relaunch")
+        _ = tab
+    }
+
+    // MARK: The real Claude extension
+
+    func runClaude() async {
+        log("START claude ext=\(extID) \(focusState())")
+        guard await waitForContext(), let space = wc.activeSpace, let profile = space.profile else { return }
+        if !ExtensionManager.shared.pinnedExtensions(for: profile.id).contains(where: { $0.id == extID }) {
+            ExtensionManager.shared.toggleExtensionPinned(extID, profileID: profile.id)
+        }
+        // The extension opens its own onboarding tab at install; let it settle.
+        await sleep(6)
+        log("    tabs at start: \(space.tabs.map { $0.url?.host ?? "nil" })")
+        let tab1 = await openTab("one.html", in: space)
+        let tab2 = await openTab("two.html", in: space)
+        wc.selectTab(id: tab1.id)
+        await sleep(1.0)
+        frames("before the click")
+
+        log("== 1. a real click on the pinned toolbar action")
+        let stack = wc.tabSidebar.fauxAddressBar.pinnedExtensionStack
+        guard let button = stack.arrangedSubviews.first(where: { $0.identifier?.rawValue == extID }) as? NSButton else {
+            log("FAILED: no pinned button for the extension (\(stack.arrangedSubviews.map { $0.identifier?.rawValue ?? "?" }))")
+            return
+        }
+        await nativeClick(button, "pinned action button") { !profile.sidePanels.panels(for: self.extID).isEmpty }
+        for _ in 0..<60 where profile.sidePanels.panels(for: extID).isEmpty { await sleep(0.25) }
+        guard let opened = profile.sidePanels.panels(for: extID).first, let panelWebView = opened.webView else {
+            log("FAILED: no panel opened after the click")
+            return
+        }
+        log("    panel opened: \(opened.documentURL.absoluteString) displayed=\(wc.displayedSidePanel === opened) \(focusState())")
+        await waitForLoad(panelWebView)
+        await sleep(6)
+        await describeClaudePanel(panelWebView, "after the click")
+        frames("claude panel open")
+        await capture("claude-panel")
+        _ = await js(panelWebView, "globalThis.__harnessMarker = 'marker-' + Date.now(); return '';")
+        await panelState("marked")
+
+        log("== 2. tab switch hides and restores it")
+        wc.selectTab(id: tab2.id)
+        await sleep(1.0)
+        await panelState("on tab two")
+        frames("tab two")
+        await capture("claude-other-tab")
+        wc.selectTab(id: tab1.id)
+        await sleep(1.0)
+        await panelState("back on tab one")
+        frames("back on tab one")
+        await capture("claude-back")
+
+        log("== 3. the command shortcut (Cmd+E) — needs the window key, so the app is activated for this step")
+        NSApp.activate(ignoringOtherApps: true)
+        wc.window?.makeKeyAndOrderFront(nil)
+        await sleep(1.5)
+        if let pageWebView = tab1.webView { wc.window?.makeFirstResponder(pageWebView) }
+        log("    \(focusState())")
+        // What the worker's shortcut handler will see, and whether its close message reaches the panel page.
+        log("    probe before Cmd+E #1: " + (await js(panelWebView, """
+            globalThis.__harnessMessages = [];
+            chrome.runtime.onMessage.addListener((m) => { globalThis.__harnessMessages.push(m); });
+            const contexts = await chrome.runtime.getContexts({ contextTypes: [chrome.runtime.ContextType.SIDE_PANEL] });
+            const [active] = await chrome.tabs.query({ active: true, currentWindow: true });
+            return JSON.stringify({ contexts, active: active && { id: active.id, windowId: active.windowId } });
+            """)))
+        await pressCommandE()
+        for _ in 0..<40 where !profile.sidePanels.panels(for: extID).isEmpty { await sleep(0.25) }
+        if let stillOpen = profile.sidePanels.panels(for: extID).first?.webView {
+            log("    messages the panel page received: " + (await js(stillOpen, "return JSON.stringify(globalThis.__harnessMessages || null) + ' marker=' + String(globalThis.__harnessMarker || '');")))
+            await describeClaudePanel(stillOpen, "after Cmd+E #1")
+        }
+        log("    after Cmd+E #1: panels open=\(profile.sidePanels.panels(for: extID).count) displayed=\(panel != nil)")
+        frames("after Cmd+E #1")
+        await capture("claude-after-shortcut-1")
+        await sleep(1.0)
+        // The signed-out screen does not mount the extension's own close listener (it lives in the
+        // signed-in components). Stand in for it with the same body, so the rest of the toggle is exercised.
+        if let stillOpen = profile.sidePanels.panels(for: extID).first?.webView {
+            log("    stand-in close listener installed: " + (await js(stillOpen, """
+                const own = Number(new URLSearchParams(location.search).get('tabId'));
+                chrome.runtime.onMessage.addListener((m) => { if (m.type === 'close_side_panel' && m.tabId === own) window.close(); });
+                return String(own);
+                """)))
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        wc.window?.makeKeyAndOrderFront(nil)
+        await sleep(1.0)
+        await pressCommandE()
+        for _ in 0..<40 where !profile.sidePanels.panels(for: extID).isEmpty { await sleep(0.25) }
+        log("    after Cmd+E #2 (stand-in listener): panels open=\(profile.sidePanels.panels(for: extID).count) displayed=\(panel != nil) \(focusState())")
+        frames("after Cmd+E #2")
+        await capture("claude-after-shortcut-2")
+        await sleep(1.0)
+        NSApp.activate(ignoringOtherApps: true)
+        wc.window?.makeKeyAndOrderFront(nil)
+        await sleep(1.0)
+        await pressCommandE()
+        for _ in 0..<60 where profile.sidePanels.panels(for: extID).isEmpty { await sleep(0.25) }
+        log("    after Cmd+E #3: panels open=\(profile.sidePanels.panels(for: extID).count) displayed=\(panel != nil) \(focusState())")
+        if let reopened = profile.sidePanels.panels(for: extID).first?.webView {
+            await waitForLoad(reopened)
+            await sleep(5)
+            await describeClaudePanel(reopened, "after Cmd+E #3")
+            log("    reopened page marker (empty = a fresh page): " + (await js(reopened, "return String(globalThis.__harnessMarker || '');")))
+        }
+        frames("after Cmd+E #3")
+        await capture("claude-after-shortcut-3")
+        NSApp.deactivate()
+        await sleep(1.0)
+        log("    end: \(focusState())")
+    }
+
+    func describeClaudePanel(_ webView: WKWebView, _ label: String) async {
+        let text = await js(webView, """
+            const root = document.getElementById('root');
+            return JSON.stringify({
+                href: location.href, title: document.title, readyState: document.readyState,
+                rootChildren: root ? root.childElementCount : null,
+                text: (document.body ? document.body.innerText : '').replace(/\\s+/g, ' ').slice(0, 700),
+                buttons: Array.from(document.querySelectorAll('button, a')).slice(0, 12).map((b) => (b.innerText || b.getAttribute('aria-label') || '').trim().slice(0, 40)),
+                sidePanel: typeof chrome.sidePanel, getCurrent: await chrome.tabs.getCurrent().then((t) => t === undefined ? 'undefined' : JSON.stringify(t), (e) => 'error: ' + e.message)
+            });
+            """)
+        log("CLAUDE PANEL \(label): \(text)")
+    }
+
+    func pressKey(characters: String, unmodified: String, keyCode: UInt16, flags: NSEvent.ModifierFlags) async {
+        guard let window = wc.window else { return }
+        for type in [NSEvent.EventType.keyDown, .keyUp] {
+            if let event = NSEvent.keyEvent(with: type, location: .zero, modifierFlags: flags,
+                                            timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber,
+                                            context: nil, characters: characters, charactersIgnoringModifiers: unmodified,
+                                            isARepeat: false, keyCode: keyCode) {
+                NSApp.postEvent(event, atStart: false)
+            }
+            await sleep(0.08)
+        }
+    }
+
+    func pressCommandE() async {
+        guard let window = wc.window else { return }
+        for type in [NSEvent.EventType.keyDown, .keyUp] {
+            if let event = NSEvent.keyEvent(with: type, location: .zero, modifierFlags: [.command],
+                                            timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber,
+                                            context: nil, characters: "e", charactersIgnoringModifiers: "e",
+                                            isARepeat: false, keyCode: 14) {
+                NSApp.postEvent(event, atStart: false)
+            }
+            await sleep(0.08)
+        }
+        log("    posted Cmd+E (\(focusState()))")
+    }
 }
