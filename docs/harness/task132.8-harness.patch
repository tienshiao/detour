+    /// The frames that matter, in the content area's coordinates.
+    func frames(_ label: String) {
+        wc.window?.layoutIfNeeded()
+        let area = wc.contentAreaView
+        var line = "FRAMES \(label): window=\(r(wc.window?.frame ?? .zero)) area=\(r(area.bounds)) content=\(r(wc.contentContainerView.frame))"
+        if let panelView = area.panelView {
+            line += " panel=\(r(panelView.frame)) divider=\(r(area.divider.frame)) dividerHidden=\(area.divider.isHidden)"
+            if let panel, let webView = panel.webView {
+                line += " panelWebView=\(r(webView.convert(webView.bounds, to: area))) holderSubviews=\(panel.view.webViewHolder.subviews.count)"
+            }
+        } else {
+            line += " panel=none dividerHidden=\(area.divider.isHidden)"
+        }
+        if let tab = wc.selectedTab {
+            for member in wc.splitMembers(of: tab) {
+                if let container = member.webViewContainer, let webView = member.webView {
+                    line += " | pane \(member.title.prefix(12)): container=\(r(container.convert(container.bounds, to: area))) webView=\(r(webView.convert(webView.bounds, to: area))) containerSubviews=\(container.subviews.count)"
+                }
+            }
+        }
+        line += " | owns=\(wc.ownsWebView) panels(open)=\(ExtensionSidePanelController.allPanels.count)"
+        log(line)
+    }
