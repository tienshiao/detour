+    /// A click on a native button with real mouse events: the mouse-up waits
+    /// in the queue for the button's tracking loop. Falls back to performClick.
+    func nativeClick(_ button: NSButton, _ label: String, fired: () -> Bool) async {
+        guard let window = button.window else { log("    native click \(label): the button is in no window"); return }
+        let point = button.convert(NSPoint(x: button.bounds.midX, y: button.bounds.midY), to: nil)
+        let hit = window.contentView?.superview?.hitTest(point)
+        log("    native click \(label): at \(Int(point.x)),\(Int(point.y)) hitTest=\(hit.map { String(describing: type(of: $0)) } ?? "nil") isTheButton=\(hit === button)")
+        if let down = mouseEvent(.leftMouseDown, at: point, in: window), let up = mouseEvent(.leftMouseUp, at: point, in: window) {
+            NSApp.postEvent(up, atStart: false)
+            button.mouseDown(with: down)
+        }
+        await sleep(0.4)
+        if fired() { log("    native click \(label): the mouse events fired the button"); return }
+        log("    native click \(label): mouse events did not fire it; using performClick")
+        button.performClick(nil)
+        await sleep(0.4)
+    }
