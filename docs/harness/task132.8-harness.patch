+    /// Opens the Web Inspector on `webView`, docks it if it came up detached,
+    /// and says whether it is docked: WebKit puts a docked inspector beside the
+    /// web view, in the same superview, and shrinks the web view.
+    func inspect(_ webView: WKWebView?, container: NSView?, _ label: String, shot: String) async {
+        guard let webView, let container, let inspector = webView.value(forKey: "_inspector") as? NSObject else {
+            log("INSPECTOR \(label): no web view"); return
+        }
+        let before = webView.frame
+        log("    inspector: calling show for \(label)")
+        inspector.perform(Selector(("show")))
+        log("    inspector: show returned")
+        await sleep(2.5)
+        log("    inspector: 2.5 s after show, siblings=\(container.subviews.count)")
+        var attachedByHarness = false
+        if container.subviews.count < 2, inspector.responds(to: Selector(("attach"))) {
+            attachedByHarness = true
+            inspector.perform(Selector(("attach")))
+            await sleep(2.0)
+        }
+        log("    inspector selectors: isAttached=\(inspector.responds(to: Selector(("isAttached")))) attach=\(inspector.responds(to: Selector(("attach")))) isVisible=\(inspector.responds(to: Selector(("isVisible"))))")
+        log("INSPECTOR \(label): docked=\(container.subviews.count >= 2) attachCalled=\(attachedByHarness) webView \(r(before)) -> \(r(webView.frame)) siblings=\(container.subviews.map { String(describing: type(of: $0)) })")
+        frames("inspector: \(label)")
+        await capture(shot)
+        inspector.perform(Selector(("close")))
+        await sleep(1.2)
+        log("    inspector closed: webView \(r(webView.frame)) siblings=\(container.subviews.count)")
+    }
