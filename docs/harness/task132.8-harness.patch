+    /// A picture of the browser window: the real on-screen pixels through
+    /// screencapture, and the content area drawn in-process as a second opinion.
+    func capture(_ name: String) async {
+        shot += 1
+        let stem = String(format: "%02d-%@", shot, name)
+        guard let window = wc.window else { return }
+        window.displayIfNeeded()
+        await sleep(0.4)
+        let screenFile = outDir.appendingPathComponent(stem + ".png")
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture")
+        process.arguments = ["-x", "-o", "-l", "\(window.windowNumber)", screenFile.path]
+        do {
+            try process.run()
+            process.waitUntilExit()
+            let size = (try? FileManager.default.attributesOfItem(atPath: screenFile.path)[.size] as? Int) ?? 0
+            log("    capture \(stem).png (screencapture, status \(process.terminationStatus), \(size) bytes)")
+        } catch {
+            log("    capture \(stem).png: screencapture failed to start: \(error.localizedDescription)")
+        }
+        let view = wc.contentAreaView
+        if let rep = view.bitmapImageRepForCachingDisplay(in: view.bounds) {
+            view.cacheDisplay(in: view.bounds, to: rep)
+            if let png = rep.representation(using: .png, properties: [:]) {
+                try? png.write(to: outDir.appendingPathComponent(stem + "-inprocess.png"))
+            }
+        }
+    }
