+        await panelState("window panel before disabling")
+        ExtensionManager.shared.setEnabled(id: extID, enabled: false)
+        await sleep(1.0)
+        log("    after ExtensionManager.setEnabled(false): panels open=\(ExtensionSidePanelController.allPanels.count) displayed=\(panel != nil)")
