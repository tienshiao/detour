+        wc.selectTab(id: tab1.id)
+        await sleep(1.5)
+        await panelState("split")
+        frames("split + panel")
+        await capture("split-and-panel")
+        await inspect(tab1.webView, container: tab1.webViewContainer, "split pane narrower than 500 pt + panel", shot: "split-narrow-pane-inspector")
+        wc.contentAreaView.setWantedPanelWidth(SidePanelLayout.minimumPanelWidth)
+        await sleep(0.5)
+        frames("split + panel at its minimum width")
+        await inspect(tab1.webView, container: tab1.webViewContainer, "split pane of 500 pt or more + panel", shot: "split-panel-inspector")
+        wc.contentAreaView.setWantedPanelWidth(560)
+        await sleep(0.5)
+        await inspect(panel?.webView, container: panel?.view.webViewHolder, "the panel's own page (panel 560 pt wide)", shot: "panel-inspector")
+        wc.contentAreaView.setWantedPanelWidth(470)
+        await sleep(0.5)
+
+        log("== 8. window resize")
+        if let window = wc.window {
+            let original = window.frame
+            window.setFrame(NSRect(x: original.minX, y: original.minY, width: 760, height: original.height), display: true)
+            await sleep(0.8)
+            frames("window 760 wide")
+            await capture("narrow-window")
+            window.setFrame(NSRect(x: original.minX, y: original.minY, width: 1400, height: original.height), display: true)
