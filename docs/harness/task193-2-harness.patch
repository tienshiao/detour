    import CoreGraphics
    import Foundation
    // TASK-193.2 driver input, posted at the HID event tap (as a physical device would).
    //   input key <keyCode> <flags c o t s f>
    //   input text <string>
    //   input click <x> <y> <expectedOwnerPid>   (CG global coordinates; refuses unless
    //                                            the topmost window there is that pid's)
    guard CGPreflightPostEventAccess() else { print("no post access"); exit(2) }
    let args = CommandLine.arguments
    let src = CGEventSource(stateID: .hidSystemState)
    func flags(_ spec: String) -> CGEventFlags {
        var f: CGEventFlags = []
        if spec.contains("c") { f.insert(.maskCommand) }
        if spec.contains("o") { f.insert(.maskAlternate) }
        if spec.contains("t") { f.insert(.maskControl) }
        if spec.contains("s") { f.insert(.maskShift) }
        if spec.contains("f") { f.insert(.maskSecondaryFn) }
        return f
    }
    switch args[1] {
    case "key":
        let code = CGKeyCode(args[2])!
        let f = flags(args.count > 3 ? args[3] : "")
        let down = CGEvent(keyboardEventSource: src, virtualKey: code, keyDown: true)!
        down.flags = f
        let up = CGEvent(keyboardEventSource: src, virtualKey: code, keyDown: false)!
        up.flags = f
        down.post(tap: .cghidEventTap); usleep(30000); up.post(tap: .cghidEventTap)
        print("key \(code) \(args.count > 3 ? args[3] : "")")
    case "text":
        for scalar in args[2].utf16 {
            var chars = [scalar]
            let down = CGEvent(keyboardEventSource: src, virtualKey: 0, keyDown: true)!
            down.keyboardSetUnicodeString(stringLength: 1, unicodeString: &chars)
            let up = CGEvent(keyboardEventSource: src, virtualKey: 0, keyDown: false)!
            up.keyboardSetUnicodeString(stringLength: 1, unicodeString: &chars)
            down.post(tap: .cghidEventTap); usleep(15000); up.post(tap: .cghidEventTap); usleep(25000)
        }
        print("text \(args[2])")
    case "type":
        // Virtual key codes of a US layout, as a physical keyboard sends them.
        let codes: [Character: (CGKeyCode, Bool)] = [
            "a": (0, false), "s": (1, false), "d": (2, false), "f": (3, false), "h": (4, false), "g": (5, false),
            "z": (6, false), "x": (7, false), "c": (8, false), "v": (9, false), "b": (11, false), "q": (12, false),
            "w": (13, false), "e": (14, false), "r": (15, false), "y": (16, false), "t": (17, false), "1": (18, false),
            "2": (19, false), "3": (20, false), "4": (21, false), "6": (22, false), "5": (23, false), "9": (25, false),
            "7": (26, false), "8": (28, false), "0": (29, false), "o": (31, false), "u": (32, false), "i": (34, false),
            "p": (35, false), "l": (37, false), "j": (38, false), "k": (40, false), "n": (45, false), "m": (46, false),
            ".": (47, false), "/": (44, false), ":": (41, true), "-": (27, false), " ": (49, false),
        ]
        for ch in args[2] {
            guard let (code, shift) = codes[ch] else { print("no key for \(ch)"); exit(4) }
            let down = CGEvent(keyboardEventSource: src, virtualKey: code, keyDown: true)!
            let up = CGEvent(keyboardEventSource: src, virtualKey: code, keyDown: false)!
            down.flags = shift ? .maskShift : []
            up.flags = shift ? .maskShift : []
            down.post(tap: .cghidEventTap); usleep(15000); up.post(tap: .cghidEventTap); usleep(25000)
        }
        print("type \(args[2])")
    case "click":
        let point = CGPoint(x: Double(args[2])!, y: Double(args[3])!)
        let expected = Int32(args[4])!
        let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
        var top: (Int32, String, Int)? = nil
        for w in info {
            let layer = w[kCGWindowLayer as String] as? Int ?? 0
            guard layer < 20 else { continue }   // skip menu bar, Dock, overlays
            let alpha = w[kCGWindowAlpha as String] as? Double ?? 1
            guard alpha > 0 else { continue }
            guard let b = w[kCGWindowBounds as String] as? [String: CGFloat] else { continue }
            let r = CGRect(x: b["X"]!, y: b["Y"]!, width: b["Width"]!, height: b["Height"]!)
            if r.contains(point) {
                top = (w[kCGWindowOwnerPID as String] as? Int32 ?? 0, w[kCGWindowOwnerName as String] as? String ?? "?", layer)
                break
            }
        }
        guard let top, top.0 == expected else { print("REFUSED click at \(point): top window is \(String(describing: top))"); exit(3) }
        for type in [CGEventType.leftMouseDown, .leftMouseUp] {
            let e = CGEvent(mouseEventSource: src, mouseType: type, mouseCursorPosition: point, mouseButton: .left)!
            e.post(tap: .cghidEventTap); usleep(40000)
        }
        print("click \(point) on \(top.1)")
    default: print("?")
    }

