    import AppKit
    // Scratch "Other App" for TASK-193.2: a window with a text field; logs its
    // activation, key state and every key it receives. SIGUSR1 activates it.
    // usage: other <logfile> <w> <h>   (centred on the main screen)
    let args = CommandLine.arguments
    let logURL = URL(fileURLWithPath: args[1])
    FileManager.default.createFile(atPath: logURL.path, contents: nil)
    let handle = try! FileHandle(forWritingTo: logURL)
    func log(_ s: String) {
        let line = String(format: "%.3f ", ProcessInfo.processInfo.systemUptime) + s + "\n"
        handle.seekToEndOfFile(); handle.write(line.data(using: .utf8)!)
    }
    final class Delegate: NSObject, NSApplicationDelegate, NSTextFieldDelegate {
        var window: NSWindow!
        var field: NSTextField!
        var signalSource: DispatchSourceSignal?
        func applicationDidFinishLaunching(_ n: Notification) {
            let a = CommandLine.arguments
            // <w> <h> centred on the main screen's visible frame.
            let visible = NSScreen.screens[0].visibleFrame
            let w = Double(a[2])!, h = Double(a[3])!
            let rect = NSRect(x: visible.midX - w / 2, y: visible.midY - h / 2, width: w, height: h)
            window = NSWindow(contentRect: rect, styleMask: [.titled, .closable], backing: .buffered, defer: false)
            window.title = "Other App (TASK-193.2 scratch)"
            window.backgroundColor = NSColor(calibratedRed: 0.85, green: 0.93, blue: 0.85, alpha: 1)
            field = NSTextField(frame: NSRect(x: 20, y: rect.height - 60, width: rect.width - 40, height: 24))
            field.placeholderString = "Other App field"
            field.delegate = self
            window.contentView!.addSubview(field)
            window.makeKeyAndOrderFront(nil)
            window.makeFirstResponder(field)
            NSApp.activate(ignoringOtherApps: true)
            for name in [NSApplication.didBecomeActiveNotification, NSApplication.didResignActiveNotification] {
                NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main) { n in log("APP \(n.name.rawValue)") }
            }
            for name in [NSWindow.didBecomeKeyNotification, NSWindow.didResignKeyNotification] {
                NotificationCenter.default.addObserver(forName: name, object: window, queue: .main) { n in log("WINDOW \(n.name.rawValue)") }
            }
            NSEvent.addLocalMonitorForEvents(matching: [.keyDown]) { e in
                log("KEYDOWN keyCode=\(e.keyCode) chars=\(e.charactersIgnoringModifiers ?? "") flags=\(e.modifierFlags.rawValue)")
                return e
            }
            signal(SIGUSR1, SIG_IGN)
            let src = DispatchSource.makeSignalSource(signal: SIGUSR1, queue: .main)
            src.setEventHandler { [weak self] in
                log("SIGUSR1 activate")
                NSApp.activate(ignoringOtherApps: true)
                self?.window.makeKeyAndOrderFront(nil)
            }
            src.resume()
            signalSource = src
            let f = window.frame, H = NSScreen.screens[0].frame.height
            log("LAUNCHED pid=\(getpid()) windowNumber=\(window.windowNumber) active=\(NSApp.isActive) cgFrame=\(Int(f.minX)),\(Int(H - f.maxY)),\(Int(f.width)),\(Int(f.height))")
            Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in
                guard let self else { return }
                log("TICK active=\(NSApp.isActive) key=\(self.window.isKeyWindow) text=\(self.field.stringValue)")
            }
        }
        func controlTextDidChange(_ obj: Notification) { log("TEXT \(field.stringValue)") }
    }
    let app = NSApplication.shared
    app.setActivationPolicy(.regular)
    let delegate = Delegate()
    app.delegate = delegate
    app.run()

