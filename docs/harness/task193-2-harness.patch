+// TEMP TASK-193.2 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import Carbon.HIToolbox
+
+/// A command server for the shell driver: the driver writes
+/// `$DETOUR_VERIFY_DIR/cmd-<n>` (one command line), the harness runs it and
+/// logs `DONE <n>` to verify.log. Real input (the hotkey, typing, clicks) is
+/// posted by the driver from outside, through the HID event tap.
+extension AppDelegate {
+    func runTask1932HarnessIfRequested() {
+        let env = ProcessInfo.processInfo.environment
+        guard let outDir = env["DETOUR_VERIFY_DIR"] else { return }
+        let harness = Task1932Harness(outDir: outDir, fixture: env["DETOUR_VERIFY_FIXTURE"] ?? "http://127.0.0.1:8932/",
+                                      appDelegate: self)
+        Task1932Harness.current = harness
+        harness.start()
+    }
+}
+
+final class Task1932Harness {
+    static var current: Task1932Harness?
+    let outDir: String
+    let fixture: String
+    weak var appDelegate: AppDelegate?
+    private var next = 1
+    private var timer: Timer?
+    private let logURL: URL
+    private var hotKeyPresses = 0
+    private var stateObserver: NSObjectProtocol?
+
+    init(outDir: String, fixture: String, appDelegate: AppDelegate) {
+        self.outDir = outDir
+        self.fixture = fixture
+        self.appDelegate = appDelegate
+        logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        FileManager.default.createFile(atPath: logURL.path, contents: nil)
+    }
+
+    func log(_ line: String) {
+        let text = String(format: "%.3f ", ProcessInfo.processInfo.systemUptime) + line + "\n"
+        if let handle = try? FileHandle(forWritingTo: logURL) {
+            handle.seekToEndOfFile()
+            handle.write(text.data(using: .utf8)!)
+            try? handle.close()
+        }
+    }
+
+    func start() {
+        log("HARNESS pid=\(getpid()) dataDir=\(WebKitStorageScope.currentDataDirectoryName) suite=\(UserDefaultsScope.suiteName() ?? "standard")")
+        stateObserver = NotificationCenter.default.addObserver(
+            forName: QuickDetourHotKey.stateDidChangeNotification, object: nil, queue: .main) { [weak self] _ in
+            self?.log("HOTKEY-STATE \(QuickDetourHotKey.shared.state)")
+        }
+        // Count the launcher's openings by path: wrap the hotkey's handler.
+        timer = Timer.scheduledTimer(withTimeInterval: 0.1, repeats: true) { [weak self] _ in self?.poll() }
+    }
+
+    private func poll() {
+        let url = URL(fileURLWithPath: outDir).appendingPathComponent("cmd-\(next)")
+        guard let data = try? Data(contentsOf: url), let line = String(data: data, encoding: .utf8) else { return }
+        let n = next
+        next += 1
+        let words = line.trimmingCharacters(in: .whitespacesAndNewlines).split(separator: " ").map(String.init)
+        log("CMD \(n) \(words.joined(separator: " "))")
+        run(words)
+        log("DONE \(n)")
+    }
+
+    private func run(_ words: [String]) {
+        guard let command = words.first else { return }
+        let args = Array(words.dropFirst())
+        switch command {
+        case "setup": setup()
+        case "hotkey":
+            // hotkey <keyCode> <carbonModifiers> <character or ->
+            let shortcut = HotKeyShortcut(keyCode: UInt16(args[0])!,
+                                          modifiers: HotKeyShortcut.modifiers(fromCarbon: UInt32(args[1])!),
+                                          character: args[2] == "-" ? "" : args[2])
+            QuickDetourHotKey.shared.settings.shortcut = shortcut
+        case "enable": QuickDetourHotKey.shared.settings.isEnabled = args[0] == "1"
+        case "variant": setVariant(args[0])
+        case "state": logState(args.first ?? "")
+        case "settings": showSettings()
+        case "rect": logRect(identifier: args[0])
+        case "appearance":
+            NSApp.appearance = NSAppearance(named: args[0] == "dark" ? .darkAqua : .aqua)
+        case "activate":
+            NSApp.activate()
+            if let window = NSApp.orderedWindows.first(where: { $0.windowController is BrowserWindowController }) {
+                window.makeKeyAndOrderFront(nil)
+            }
+        case "closeqd":
+            for controller in QuickDetourWindowController.openControllers { controller.window?.performClose(nil) }
+        case "closesettings": SettingsWindowController.shared.window?.orderOut(nil)
+        case "invoke": appDelegate?.quickDetourHotKeyPressed()
+        case "winpoint":
+            // winpoint <x> <y>: a point given from the Settings window's top-left, in CG coordinates.
+            guard let window = SettingsWindowController.shared.window else { break }
+            let height = NSScreen.screens[0].frame.height
+            log("WINPOINT \(Int(window.frame.minX) + Int(args[0])!) \(Int(height - window.frame.maxY) + Int(args[1])!)")
+        case "monitor":
+            _ = NSEvent.addLocalMonitorForEvents(matching: [.keyDown, .keyUp, .flagsChanged]) { [weak self] event in
+                self?.log("EVENT \(event.type.rawValue) keyCode=\(event.keyCode) chars=\(event.characters ?? "") window=\(self?.describe(event.window) ?? "") fr=\(event.window?.firstResponder.map { String(describing: type(of: $0)) } ?? "-")")
+                return event
+            }
+        case "quit":
+            QuickDetourHotKey.shared.stop()
+            log("EXIT")
+            exit(0)
+        default: log("UNKNOWN \(command)")
+        }
+    }
+
+    private func setup() {
+        guard let appDelegate else { return }
+        let main = NSScreen.screens[0].visibleFrame
+        appDelegate.createNewWindowWithURL(URL(string: fixture + "b.html")!)
+        let browsers = NSApp.windows.filter { $0.windowController is BrowserWindowController && $0.isVisible }
+        for (index, window) in browsers.enumerated() {
+            window.setFrame(NSRect(x: main.minX + 40 + CGFloat(index) * 260, y: main.maxY - 700 - CGFloat(index) * 40,
+                                   width: 900, height: 640), display: true)
+        }
+        if let first = browsers.first(where: { ($0.windowController as? BrowserWindowController)?.activeSpace?.tabs.isEmpty == false } ) {
+            log("SETUP first has tabs \(first.windowNumber)")
+        }
+        // The window that had no tab gets the a.html page.
+        for window in browsers {
+            guard let wc = window.windowController as? BrowserWindowController, let space = wc.activeSpace else { continue }
+            if wc.selectedTab == nil {
+                let tab = TabStore.shared.addTab(in: space, url: URL(string: fixture + "a.html")!)
+                wc.selectTab(id: tab.id)
+            }
+        }
+        log("SETUP browsers=\(browsers.map { $0.windowNumber })")
+    }
+
+    /// new: the shipped order (open the window, then activate). old: what
+    /// TASK-193.1 did (activate, then open), for comparison.
+    private func setVariant(_ variant: String) {
+        let launcher = QuickDetourLauncher.shared
+        launcher.openWindow = { profile, space, url, typed in
+            switch variant {
+            case "old":       // TASK-193.1: activate, then open
+                NSApp.activate(ignoringOtherApps: true)
+                QuickDetourWindowController.open(profile: profile, sourceSpace: space, url: url, typed: typed)
+            case "coop":      // open, then the cooperative NSApp.activate()
+                QuickDetourWindowController.open(profile: profile, sourceSpace: space, url: url, typed: typed)
+                NSApp.activate()
+            case "running":   // open, then NSRunningApplication without .activateAllWindows
+                QuickDetourWindowController.open(profile: profile, sourceSpace: space, url: url, typed: typed)
+                NSRunningApplication.current.activate(options: [])
+            case "ignoring":  // open, then activate(ignoringOtherApps:)
+                QuickDetourWindowController.open(profile: profile, sourceSpace: space, url: url, typed: typed)
+                NSApp.activate(ignoringOtherApps: true)
+            default:          // the shipped closure
+                QuickDetourLauncher.defaultOpenWindow(profile, space, url, typed)
+            }
+        }
+        log("VARIANT \(variant)")
+    }
+
+    private func describe(_ window: NSWindow?) -> String {
+        guard let window else { return "nil" }
+        let kind: String
+        switch window.windowController {
+        case is BrowserWindowController: kind = "browser"
+        case is QuickDetourWindowController: kind = "quick"
+        case is SettingsWindowController: kind = "settings"
+        default: kind = window is QuickDetourPalettePanel ? "panel" : String(describing: type(of: window))
+        }
+        return "\(kind)#\(window.windowNumber)"
+    }
+
+    private func paletteText() -> String? {
+        guard let host = QuickDetourLauncher.shared.panel?.contentView else { return nil }
+        func find(_ view: NSView) -> NSTextField? {
+            if let field = view as? CommandPaletteTextField { return field }
+            for sub in view.subviews { if let found = find(sub) { return found } }
+            return nil
+        }
+        return find(host)?.stringValue
+    }
+
+    private func logState(_ label: String) {
+        let front = NSWorkspace.shared.frontmostApplication
+        let launcher = QuickDetourLauncher.shared
+        let panel = launcher.panel
+        let fieldEditorFirst = panel.map { $0.firstResponder is NSTextView } ?? false
+        let hotKey = QuickDetourHotKey.shared
+        let item = appDelegate?.quickDetourMenuItem
+        let keyEquivalent = item.map { $0.keyEquivalent.unicodeScalars.map { String(format: "U+%04X", $0.value) }.joined() } ?? "nil"
+        let mask = item.map { HotKeyShortcut(keyCode: UInt16.max, modifiers: $0.keyEquivalentModifierMask, character: "").displayString } ?? ""
+        log("STATE \(label) active=\(NSApp.isActive) front=\(front?.localizedName ?? "?")/\(front?.processIdentifier ?? 0) "
+            + "launcher=\(launcher.isShowing) panelKey=\(panel?.isKeyWindow ?? false) fieldFirstResponder=\(fieldEditorFirst) "
+            + "text=\(paletteText() ?? "-") hotkey=\(hotKey.state) enabled=\(hotKey.settings.isEnabled) "
+            + "shortcut=\(hotKey.settings.shortcut?.displayString ?? "none") menu=\(keyEquivalent)+\(mask) "
+            + "quickWindows=\(QuickDetourWindowController.openControllers.count) key=\(describe(NSApp.keyWindow)) "
+            + "main=\(describe(NSApp.mainWindow)) panelFrameCG=\(panel.map { Self.cgRect($0.frame) } ?? "-")")
+        let ordered = NSApp.orderedWindows.filter(\.isVisible).map(describe)
+        log("ORDER-APP \(label) \(ordered.joined(separator: " "))")
+        log("RECORDER \(label) recording=\(recorderView()?.isRecording.description ?? "-") availability=\(hotKey.availability) pane=\(SettingsWindowController.shared.window?.contentViewController.map { String(describing: type(of: $0)) } ?? "-") warning=\(warningText() ?? "-")")
+        // Front to back, every on-screen window of Detour or the scratch app.
+        let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID)
+            as? [[String: Any]] ?? []
+        let mine = getpid()
+        var entries: [String] = []
+        for window in info {
+            let pid = window[kCGWindowOwnerPID as String] as? Int32 ?? 0
+            let owner = window[kCGWindowOwnerName as String] as? String ?? "?"
+            let number = window[kCGWindowNumber as String] as? Int ?? 0
+            let layer = window[kCGWindowLayer as String] as? Int ?? 0
+            let bounds = window[kCGWindowBounds as String] as? [String: CGFloat] ?? [:]
+            guard pid == mine || owner == "other" else { continue }
+            guard (bounds["Width"] ?? 0) > 50 else { continue }
+            let name = pid == mine ? describe(NSApp.window(withWindowNumber: number)) : "OTHER#\(number)"
+            entries.append("\(name)@L\(layer)")
+        }
+        log("ORDER-CG \(label) \(entries.joined(separator: " "))")
+    }
+
+    static func cgRect(_ rect: NSRect) -> String {
+        let height = NSScreen.screens[0].frame.height
+        return "\(Int(rect.minX)),\(Int(height - rect.maxY)),\(Int(rect.width)),\(Int(rect.height))"
+    }
+
+    private func showSettings() {
+        SettingsWindowController.shared.showLinksPane()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) { [weak self] in
+            guard let window = SettingsWindowController.shared.window,
+                  let pane = window.contentViewController as? SettingsPaneViewController else { return }
+            // The section is at the bottom of the pane.
+            if let document = pane.scrollView.documentView {
+                document.scroll(NSPoint(x: 0, y: document.bounds.maxY))
+            }
+            self?.log("SETTINGS windowNumber=\(window.windowNumber) frame=\(window.frame)")
+        }
+    }
+
+    private func recorderView() -> ShortcutRecorderView? {
+        guard let content = SettingsWindowController.shared.window?.contentView else { return nil }
+        func find(_ view: NSView) -> ShortcutRecorderView? {
+            if let recorder = view as? ShortcutRecorderView { return recorder }
+            for sub in view.subviews { if let found = find(sub) { return found } }
+            return nil
+        }
+        return find(content)
+    }
+
+    /// The Quick Detour section's warning line: the visible label just below the recorder.
+    private func warningText() -> String? {
+        guard let recorder = recorderView(), let container = recorder.superview else { return nil }
+        let labels = container.subviews.compactMap { $0 as? SettingsWrappingLabel }
+            .filter { !$0.isHidden && $0.frame.maxY < recorder.frame.minY + 1 && $0.frame.maxY > recorder.frame.minY - 30 }
+        return labels.first?.stringValue
+    }
+
+    private func logRect(identifier: String) {
+        guard let window = SettingsWindowController.shared.window, let content = window.contentView else { return }
+        func find(_ view: NSView) -> NSView? {
+            if view.accessibilityIdentifier() == identifier { return view }
+            for sub in view.subviews { if let found = find(sub) { return found } }
+            return nil
+        }
+        guard let view = find(content) else { return log("RECT \(identifier) none") }
+        let inWindow = view.convert(view.bounds, to: nil)
+        let onScreen = window.convertToScreen(inWindow)
+        let height = NSScreen.screens[0].frame.height
+        // CG global coordinates: top-left origin.
+        let x = Int(onScreen.midX), y = Int(height - onScreen.midY)
+        log("RECT \(identifier) \(x) \(y) window=\(window.windowNumber)")
+    }
+}
