      cmd "variant $VAR"
      cmd activate; sleep 1
      kill -USR1 $OPID; sleep 1.2
      cmd "state V-$VAR-before"
      hotkey; sleep 1
      cmd "state V-$VAR-panel"
      require_panel_key V-$VAR-panel
      $IN type "127.0.0.1:8932/q.html"; sleep 0.5
      $IN key 36; sleep 2.5
      cmd "state V-$VAR-after"
    done
