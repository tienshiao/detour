    import AppKit
    import Carbon

    // usage: hk <keyCode> <carbonMods> <options> <seconds> <tag>
    let args = CommandLine.arguments
    let keyCode = UInt32(args[1])!
    let mods = UInt32(args[2])!
    let options = UInt32(args[3])!
    let seconds = Double(args[4])!
    let tag = args[5]
    print("[\(tag)] pid \(getpid()) postEventAccess=\(CGPreflightPostEventAccess()) listenAccess=\(CGPreflightListenEventAccess()) axTrusted=\(AXIsProcessTrusted())")
    var spec = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
    let st0 = InstallEventHandler(GetApplicationEventTarget(), { _, event, _ in
        var hk = EventHotKeyID()
        GetEventParameter(event, EventParamName(kEventParamDirectObject), EventParamType(typeEventHotKeyID), nil, MemoryLayout<EventHotKeyID>.size, nil, &hk)
        print("[\(CommandLine.arguments[5])] HOTKEY PRESSED id=\(hk.id) at \(Date())")
        fflush(stdout)
        return noErr
    }, 1, &spec, nil, nil)
    var ref: EventHotKeyRef?
    let st = RegisterEventHotKey(keyCode, mods, EventHotKeyID(signature: 0x54455354, id: 1), GetApplicationEventTarget(), OptionBits(options), &ref)
    print("[\(tag)] install=\(st0) register=\(st) ref=\(String(describing: ref))")
    // same process, second registration
    var ref2: EventHotKeyRef?
    let st2 = RegisterEventHotKey(keyCode, mods, EventHotKeyID(signature: 0x54455354, id: 2), GetApplicationEventTarget(), 0, &ref2)
    print("[\(tag)] same-process second register=\(st2)")
    if ref2 != nil { UnregisterEventHotKey(ref2) }
    fflush(stdout)
    let app = NSApplication.shared
    app.setActivationPolicy(.accessory)
    DispatchQueue.main.asyncAfter(deadline: .now() + seconds) {
        if let ref { print("[\(tag)] unregister=\(UnregisterEventHotKey(ref))") }
        fflush(stdout)
        exit(0)
    }
    app.run()

