    #!/bin/bash
    # TASK-193.2 runtime driver. Real input through the HID event tap (input tool);
    # Detour's harness answers commands (cmd-N files) and logs state.
    set -u
    S=/private/tmp/claude-501/-Users-tma-Projects-browser-MyBrowser/20483124-f109-4f1c-ac33-b193eaf9d147/scratchpad/task193-2
    APP=/Users/tma/Projects/browser/MyBrowser/.derived/Build/Products/Debug/Detour.app
    V=$S/run; OUT=$S/out
    mkdir -p "$V" "$OUT"
    rm -f "$V"/cmd-* "$V"/verify.log "$V"/other.log "$V"/hold.log
    IN=$S/hk/input
    N=0
    LOGF=$V/verify.log

    cmd() {
      N=$((N+1)); echo "$*" > "$V/cmd-$N"
      for i in $(seq 1 150); do grep -q "DONE $N\$" "$LOGF" 2>/dev/null && return 0; sleep 0.1; done
      echo "TIMEOUT cmd $N: $*"; return 1
    }
    last_state() { grep "STATE $1 " "$LOGF" | tail -1; }
    hotkey() { $IN key 111 cotf; }   # Ctrl-Opt-Cmd-F12
    shoot_window() { screencapture -x -o -l "$2" "$OUT/$1.png"; echo "SHOT $1"; }
    shoot_rect() { screencapture -x -R "$2" "$OUT/$1.png"; echo "SHOT $1 $2"; }
    panel_rect() {  # the panel's frame, grown by 40 pt, from the last STATE line named $1
      last_state "$1" | sed -E 's/.*panelFrameCG=([0-9,-]+).*/\1/' | awk -F, '{printf "%d,%d,%d,%d", $1-40, $2-40, $3+80, $4+80}'
    }
    require_panel_key() {
      if ! last_state "$1" | grep -q "panelKey=true"; then echo "ABORT: panel not key at $1"; finish; exit 1; fi
    }

    finish() {
      cmd "enable 0"; sleep 0.3
      cmd "quit"
      for i in $(seq 1 50); do kill -0 $DPID 2>/dev/null || break; sleep 0.2; done
      kill -0 $DPID 2>/dev/null && { echo "Detour $DPID still running; killing"; kill $DPID; }
      [ -n "${OPID:-}" ] && kill $OPID 2>/dev/null
      [ -n "${HPID:-}" ] && kill $HPID 2>/dev/null
      kill $SPID 2>/dev/null
      # The registration went with the process: an exclusive one now succeeds.
      $S/hk/hk 111 6400 1 0.5 AFTER | grep "register="
      echo "finished"
    }

    # Fixture server
    ( cd $S/fixture && exec python3 -m http.server 8932 --bind 127.0.0.1 > $V/server.log 2>&1 ) &
    SPID=$!
    sleep 1

    DETOUR_GLOBAL_HOTKEY=1 DETOUR_DATA_DIR=DetourVerify1932 DETOUR_VERIFY_DIR=$V DETOUR_VERIFY_FIXTURE=http://127.0.0.1:8932/ \
      "$APP/Contents/MacOS/Detour" > $V/detour.out 2>&1 &
    DPID=$!
    echo "Detour pid $DPID"
    for i in $(seq 1 100); do grep -q HARNESS "$LOGF" 2>/dev/null && break; sleep 0.2; done
    sleep 2

    cmd setup; sleep 2
    cmd "hotkey 111 6400 -"; cmd "enable 1"; sleep 0.3
    cmd "state registered"
    cmd activate; sleep 1
    cmd "state detour-active"

    $S/other/other $V/other.log 1000 700 > /dev/null 2>&1 &
    OPID=$!
    sleep 2.5
    OTHER_CG=$(grep LAUNCHED $V/other.log | sed -E 's/.*cgFrame=([0-9,]+).*/\1/')
    echo "Other pid $OPID frame $OTHER_CG"
    # A point on the Other window, near its bottom-left corner (away from the panel).
    CX=$(echo $OTHER_CG | awk -F, '{print $1+60}'); CY=$(echo $OTHER_CG | awk -F, '{print $2+$4-60}')

    # A: the hotkey from another app, typing, submit.
    cmd "state A0-other-front"
    hotkey; sleep 1
    cmd "state A1-panel-over-other"
    shoot_rect A1-panel-over-other-light "$(panel_rect A1-panel-over-other)"
    require_panel_key A1-panel-over-other
    $IN type "127.0.0.1:8932/q.html"; sleep 0.6
    cmd "state A2-typed"
    $IN key 36; sleep 2.5
    cmd "state A3-after-submit"

    # B: Escape returns focus to the other app.
    kill -USR1 $OPID; sleep 1.2
    cmd "state B0-other-again"
    hotkey; sleep 1
    cmd "state B1-panel"
    $IN key 53; sleep 1
    cmd "state B2-after-escape"

    # C: clicking away.
    hotkey; sleep 1
    cmd "state C1-panel"
    $IN click $CX $CY $OPID; sleep 1
    cmd "state C2-after-click-away"

    # D: the hotkey toggles.
    hotkey; sleep 1
    cmd "state D1-toggle-open"
    hotkey; sleep 1
    cmd "state D2-toggle-closed"

    # E: Detour frontmost: one panel; the menu key equivalent when the hotkey is off.
    cmd activate; sleep 1
    cmd "state E0-detour-front"
    hotkey; sleep 1
    cmd "state E1-hotkey-in-detour"
    $IN key 53; sleep 0.6
    cmd "enable 0"; sleep 0.3
    cmd "state E2-off"
    hotkey; sleep 1
    cmd "state E3-menu-key-equivalent"
    hotkey; sleep 1
    cmd "state E4-menu-key-equivalent-again"
    cmd "enable 1"; sleep 0.3

    # F: the TASK-193.1 order (activate, then open), for comparison.
    cmd closeqd; sleep 0.5
    cmd "variant old"
    kill -USR1 $OPID; sleep 1.2
    cmd "state F0-old-before"
    hotkey; sleep 1
    cmd "state F1-old-panel"
    require_panel_key F1-old-panel
    $IN type "127.0.0.1:8932/r.html"; sleep 0.6
    $IN key 36; sleep 2.5
    cmd "state F2-old-after-submit"
    cmd "variant new"
    cmd closeqd; sleep 0.5

    # A again in dark, for the capture.
    cmd "appearance dark"
    kill -USR1 $OPID; sleep 1.2
    hotkey; sleep 1
    cmd "state A4-panel-over-other-dark"
    shoot_rect A4-panel-over-other-dark "$(panel_rect A4-panel-over-other-dark)"
    $IN key 53; sleep 0.6
    cmd "appearance light"

    echo "PHASE1 DONE"
    if [ "${PHASE2:-1}" = "1" ]; then
      . $S/run2.sh
    fi
    finish

