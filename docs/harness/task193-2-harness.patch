    # TASK-193.2 driver, part 2: Settings (sourced by run.sh).
    settings_window() { grep "SETTINGS windowNumber" "$LOGF" | tail -1 | sed -E 's/.*windowNumber=([0-9]+).*/\1/'; }
    # Not in a subshell: cmd counts commands in N.
    rect_of() { cmd "rect $1"; RX=$(grep "RECT $1 " "$LOGF" | tail -1 | awk '{print $4}'); RY=$(grep "RECT $1 " "$LOGF" | tail -1 | awk '{print $5}'); }
    click_checkbox() { rect_of quickDetourHotKeyEnabled; $IN click $RX $RY $DPID; }
    click_recorder() { rect_of quickDetourHotKeyShortcut; $IN click $RX $RY $DPID; }
    show_settings() { cmd settings; sleep 1.5; }

    show_settings
    SW=$(settings_window)
    cmd "state G0-settings"
    shoot_window G0-settings-light $SW
    cmd "appearance dark"; sleep 0.8
    shoot_window G0-settings-dark $SW
    cmd "appearance light"; sleep 0.5


    # Turning it off unregisters at once; the hotkey from the other app does nothing.
    click_checkbox; sleep 0.8
    cmd "state G1-unchecked"
    kill -USR1 $OPID; sleep 1.2
    hotkey; sleep 1
    cmd "state G2-off-from-other"
    show_settings
    click_checkbox; sleep 0.8
    cmd "state G3-checked"

    # Changing it re-registers at once: record Ctrl-Opt-Cmd-F11.
    click_recorder; sleep 0.6
    cmd "state G4-recording"
    $IN key 103 cotf; sleep 0.8
    cmd "state G5-recorded-F11"
    kill -USR1 $OPID; sleep 1.2
    hotkey; sleep 1
    cmd "state G6-old-shortcut-from-other"
    $IN key 103 cotf; sleep 1
    cmd "state G7-new-shortcut-from-other"
    $IN key 53; sleep 0.6

    # A menu shortcut is refused while recording; Escape cancels.
    show_settings
    click_recorder; sleep 0.6
    $IN key 17 c; sleep 0.8
    cmd "state G8-refused-cmd-t"
    shoot_window G8-refused-light $SW
    $IN key 53; sleep 0.6
    cmd "state G9-cancelled"

    # A conflict: another process holds Ctrl-Opt-Cmd-F12 exclusively.
    $S/hk/hk 111 6400 1 60 HOLD > $V/hold.log 2>&1 &
    HPID=$!
    sleep 1.5
    # Recording it is not possible while the holder has it (its hotkey takes the
    # press first), so the setting changes from F11 to F12 through the harness.
    click_recorder; sleep 0.6
    hotkey; sleep 1
    cmd "state H0-recording-held-shortcut"
    $IN key 53; sleep 0.5
    cmd "hotkey 111 6400 -"; sleep 0.5
    cmd "state H1-conflict"
    shoot_window H1-conflict-light $SW
    cmd "appearance dark"; sleep 0.8
    shoot_window H1-conflict-dark $SW
    cmd "appearance light"; sleep 0.5
    hotkey; sleep 1   # goes to the holder
    cmd "state H2-pressed-while-held"
    kill $HPID; HPID=""; sleep 0.5
    kill -USR1 $OPID; sleep 1.2
    show_settings      # Detour becomes active again: the refused shortcut is retried
    cmd "state H3-after-retry"

    # Delete clears: no shortcut, no menu key equivalent.
    click_recorder; sleep 0.6
    $IN key 51; sleep 0.8
    cmd "state H4-cleared"
    shoot_window H4-cleared-light $SW
    click_recorder; sleep 0.6
    hotkey; sleep 0.8
    cmd "state H5-rerecorded-F12"
    cmd closesettings
    echo "PHASE2 DONE"

