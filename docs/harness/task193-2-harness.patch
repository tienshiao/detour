    #!/bin/bash
    # TASK-193.2 review follow-up: Debug builds without the opt-in; the recorder ending on a click elsewhere.
    set -u
    S=/private/tmp/claude-501/-Users-tma-Projects-browser-MyBrowser/20483124-f109-4f1c-ac33-b193eaf9d147/scratchpad/task193-2
    APP=/Users/tma/Projects/browser/MyBrowser/.derived/Build/Products/Debug/Detour.app
    V=$S/run3; OUT=$S/out3; IN=$S/hk/input
    mkdir -p "$V" "$OUT"
    LOGF=$V/verify.log
    N=0
    cmd() {
      N=$((N+1)); echo "$*" > "$V/cmd-$N"
      for i in $(seq 1 150); do grep -q "DONE $N\$" "$LOGF" 2>/dev/null && return 0; grep -q "EXIT" "$LOGF" 2>/dev/null && [ "$1" = quit ] && return 0; sleep 0.1; done
      echo "TIMEOUT cmd $N: $*"; return 1
    }
    rect_of() { cmd "rect $1"; RX=$(grep "RECT $1 " "$LOGF" | tail -1 | awk '{print $4}'); RY=$(grep "RECT $1 " "$LOGF" | tail -1 | awk '{print $5}'); }
    winpoint() { cmd "winpoint $1 $2"; PX=$(grep "WINPOINT" "$LOGF" | tail -1 | awk '{print $3}'); PY=$(grep "WINPOINT" "$LOGF" | tail -1 | awk '{print $4}'); }
    click_checkbox() { rect_of quickDetourHotKeyEnabled; $IN click $RX $RY $DPID; }
    click_recorder() { rect_of quickDetourHotKeyShortcut; $IN click $RX $RY $DPID; }
    settings_window() { grep "SETTINGS windowNumber" "$LOGF" | tail -1 | sed -E 's/.*windowNumber=([0-9]+).*/\1/'; }
    launch() {  # $1: opt-in value or empty
      rm -f "$V"/cmd-* "$LOGF"; N=0
      if [ -n "$1" ]; then
        DETOUR_GLOBAL_HOTKEY=$1 DETOUR_DATA_DIR=DetourVerify1932 DETOUR_VERIFY_DIR=$V "$APP/Contents/MacOS/Detour" > $V/detour-$2.out 2>&1 &
      else
        DETOUR_DATA_DIR=DetourVerify1932 DETOUR_VERIFY_DIR=$V "$APP/Contents/MacOS/Detour" > $V/detour-$2.out 2>&1 &
      fi
      DPID=$!
      for i in $(seq 1 100); do grep -q HARNESS "$LOGF" 2>/dev/null && break; sleep 0.2; done
      sleep 2; echo "Detour $2 pid $DPID"
    }
    stop() {
      cmd "enable 0"; sleep 0.3; cmd quit
      for i in $(seq 1 50); do kill -0 $DPID 2>/dev/null || break; sleep 0.2; done
      kill -0 $DPID 2>/dev/null && { echo "killing $DPID"; kill $DPID; }
      cp "$LOGF" "$V/verify-$1.log"
    }

    # 1. Debug build without DETOUR_GLOBAL_HOTKEY: nothing registers, Settings says why.
    launch "" noopt
    cmd "hotkey 111 6400 -"; cmd "enable 1"; sleep 0.3
    cmd settings; sleep 1.5
    cmd "state N1-debug-no-opt-in"
    SW=$(settings_window)
    screencapture -x -o -l $SW $OUT/N1-debug-no-opt-in-light.png
    cmd "appearance dark"; sleep 0.8
    screencapture -x -o -l $SW $OUT/N1-debug-no-opt-in-dark.png
    cmd "appearance light"
    $IN key 111 cotf; sleep 1
    cmd "state N2-pressed"
    $IN key 53; sleep 0.5
    stop noopt
    $S/hk/hk 111 6400 1 0.5 FREE | grep "register="

    # 2. Opted in: a click elsewhere ends recording and resumes the hotkey.
    launch 1 optin
    cmd "hotkey 111 6400 -"; cmd "enable 1"; sleep 0.3
    cmd settings; sleep 1.5
    cmd "state R0-registered"
    click_recorder; sleep 0.6
    cmd "state R1-recording"
    click_checkbox; sleep 0.8
    cmd "state R2-after-checkbox"
    click_checkbox; sleep 0.8
    cmd "state R3-checkbox-again"
    click_recorder; sleep 0.6
    cmd "state R4-recording"
    rect_of quickDetourHotKeyShortcut; $IN click $((RX+220)) $RY $DPID; sleep 0.8
    cmd "state R5-after-empty-space"
    click_recorder; sleep 0.6
    cmd "state R6-recording"
    winpoint 199 55; $IN click $PX $PY $DPID; sleep 1.2
    cmd "state R7-after-general-toolbar-item"
    $IN key 111 cotf; sleep 1
    cmd "state R8-hotkey-works"
    $IN key 53; sleep 0.5
    stop optin
    $S/hk/hk 111 6400 1 0.5 FREE | grep "register="
    pgrep -fl "Debug/Detour.app" || echo "no debug Detour left"

