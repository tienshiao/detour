+// MARK: - TEMP TASK-129 verify harness — DO NOT COMMIT
+extension AppDelegate {
+    func runVerify129IfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = Date()
+        func log(_ line: String) {
+            let data = Data((String(format: "%7.3f ", Date().timeIntervalSince(start)) + line + "\n").utf8)
+            if let handle = try? FileHandle(forWritingTo: logURL) {
+                handle.seekToEndOfFile(); handle.write(data); try? handle.close()
+            } else {
+                try? data.write(to: logURL)
+            }
+        }
+        func snap(_ name: String) {
+            let view = wc.tabSidebar.view
+            guard let layer = view.layer,
+                  let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: Int(view.bounds.width), pixelsHigh: Int(view.bounds.height),
+                                             bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
+                                             colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0),
+                  let ctx = NSGraphicsContext(bitmapImageRep: rep) else { log("snap failed \(name)"); return }
+            layer.render(in: ctx.cgContext)
+            try? rep.representation(using: .png, properties: [:])?.write(to: URL(fileURLWithPath: outDir).appendingPathComponent(name + ".png"))
+        }
+        func after(_ t: TimeInterval, _ block: @escaping () -> Void) { DispatchQueue.main.asyncAfter(deadline: .now() + t, execute: block) }
+        let sb = wc.tabSidebar
+        func trace(_ label: String, _ id: UUID) {
+            for i in 0..<22 { after(Double(i) * 0.025) { log("\(label) +\(i * 25)ms " + sb.debug129State(id)) } }
+        }
+        log("harness armed")
+        after(3) {
+            guard let space = wc.activeSpace else { log("no active space"); return }
+            var tabs: [BrowserTab] = []
+            for name in ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"] {
+                tabs.append(TabStore.shared.addTab(in: space, url: URL(string: "data:text/html,<title>\(name)</title>\(name)")!))
+            }
+            after(3) {
+                let ids = sb.tabItems.compactMap { $0.tabs.first?.id }
+                let base = sb.tabItems.count - 6
+                log("base " + sb.debug129State(ids[base])); snap("0-base")
+                // 1. hint, then synchronous reorder: first seeded tab to the gap above the fifth
+                guard let p1 = sb.debug129BeginDrag(itemIndex: base) else { log("beginDrag failed"); return }
+                after(0.4) {
+                    log("hint " + sb.debug129State(p1.itemID)); snap("1-hint")
+                    let row = sb.rowForNormalTab(at: base + 4)
+                    let ok = sb.debug129Drop(p1, row: row, at: sb.debug129GapPoint(aboveRow: row))
+                    log("reorder accepted=\(ok)")
+                    trace("reorder", p1.itemID)
+                    sb.debug129EndDrag()
+                }
+                after(1.5) { snap("2-reordered") }
+                // 2. deferred transaction: pin a tab (drop above the separator row)
+                after(2.5) {
+                    let id = sb.tabItems[base + 1].tabs.first!.id
+                    guard let p2 = sb.debug129BeginDrag(itemIndex: base + 1) else { log("beginDrag2 failed"); return }
+                    let ok = sb.debug129Drop(p2, row: 1, at: sb.debug129GapPoint(aboveRow: 1))
+                    log("pin accepted=\(ok)")
+                    trace("pin", id)
+                    sb.debug129EndDrag()
+                }
+                after(4.0) { snap("3-pinned") }
+                // 3. favorite via the hint
+                after(5.0) {
+                    let id = sb.tabItems[base + 2].tabs.first!.id
+                    guard let p3 = sb.debug129BeginDrag(itemIndex: base + 2) else { log("beginDrag3 failed"); return }
+                    let point = NSPoint(x: sb.view.convert(NSPoint(x: sb.view.bounds.midX, y: 0), to: nil).x, y: sb.debug129GapPoint(aboveRow: 0).y + 20)
+                    let ok = sb.debug129FavoriteDrop(p3, at: point)
+                    log("favorite accepted=\(ok) at \(point)")
+                    trace("favorite", id)
+                    sb.debug129EndDrag()
+                }
+                after(6.5) { snap("4-favorite"); log("done") }
+            }
+        }
     }
