+
+    /// Window-coordinate point on the top edge of `row`, x at 60% of the width.
+    func debug129GapPoint(aboveRow row: Int) -> NSPoint {
+        let r = tableView.rect(ofRow: row)
+        return tableView.convert(NSPoint(x: r.minX + r.width * 0.5, y: r.minY), to: nil)
+    }
