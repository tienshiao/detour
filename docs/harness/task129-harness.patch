+              let tab = tabItems[itemIndex].tabs.first, let spaceID = activeSpaceID else { return nil }
+        let visualRect = cellView.bounds.insetBy(dx: -6, dy: 1)
+        let image = NSImage(size: visualRect.size)
+        image.lockFocus()
+        UIConstants.hoverBackgroundColor.setFill()
+        NSBezierPath(roundedRect: NSRect(origin: .zero, size: visualRect.size), xRadius: 6, yRadius: 6).fill()
+        if let rep = cellView.bitmapImageRepForCachingDisplay(in: cellView.bounds) {
+            cellView.cacheDisplay(in: cellView.bounds, to: rep)
+            rep.draw(in: NSRect(origin: NSPoint(x: -visualRect.origin.x, y: -visualRect.origin.y), size: cellView.bounds.size))
+        }
+        image.unlockFocus()
