+// TEMP TASK-246 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask246HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.2f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        func pause(_ seconds: Double) async { try? await Task.sleep(for: .seconds(seconds)) }
+        guard let window = wc.window else { return log("no window") }
+        func allSubviews(_ view: NSView) -> [NSView] { view.subviews + view.subviews.flatMap(allSubviews) }
+        func palette() -> CommandPaletteView? {
+            allSubviews(window.contentView!).compactMap { $0 as? CommandPaletteView }.first
+        }
+        func key(_ code: UInt16, _ chars: String) {
+            guard let e = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [],
+                                           timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: window.windowNumber, context: nil,
+                                           characters: chars, charactersIgnoringModifiers: chars,
+                                           isARepeat: false, keyCode: code) else { return }
+            window.firstResponder?.keyDown(with: e)
+        }
+        func typeText(_ text: String) async { for ch in text { await pause(0.12); key(0, String(ch)) } }
+        func rows(_ label: String) {
+            let field = (window.firstResponder as? NSTextView)?.string ?? "?"
+            log("\(label): field=\"\(field)\"")
+            guard let table = palette().flatMap({ allSubviews($0).compactMap { $0 as? NSTableView }.first }) else {
+                return log("  no palette table")
+            }
+            for row in 0 ..< table.numberOfRows {
+                let texts = table.view(atColumn: 0, row: row, makeIfNecessary: false)
+                    .map { allSubviews($0).compactMap { ($0 as? NSTextField)?.stringValue }.filter { !$0.isEmpty } } ?? []
+                log("  row \(row): \(texts.joined(separator: " | "))")
+            }
+        }
+        let titles = [("https://roadmap.example/q3", "Quarterly Roadmap Review"),
+                      ("https://cv.example/", "Résumé Builder"),
+                      ("https://ru.example/", "Привет мир — главная")]
+        Task { @MainActor in
+            await pause(3)
+            guard let spaceID = wc.activeSpaceID else { return log("no active space") }
+            let spaceKey = spaceID.uuidString
+            for (url, title) in titles {
+                HistoryDatabase.shared.recordVisit(url: url, title: title, faviconURL: nil, spaceID: spaceKey)
+            }
+            log("seeded \(titles.count) titled visits in space \(spaceKey)")
+            await pause(1)
+            // The History page's and chrome.history's search: the SQL function this task changed.
+            for query in ["roadm", "REVIEW", "resum", "привет", "мир", "zzznothing"] {
+                let hits = HistoryDatabase.shared.searchVisits(query: query, spaceIDs: [spaceKey], limit: 50)
+                log("searchVisits \(query): \(hits.map(\.title))")
+                let urls = HistoryDatabase.shared.searchURLs(query: query, spaceIDs: [spaceKey], limit: 50)
+                log("searchURLs \(query): \(urls.map(\.title))")
+            }
+            // The palette: Cmd+T and type a title word.
+            for query in ["roadm", "resum", "привет"] {
+                await pause(0.5)
+                NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil)
+                log("Cmd+T")
+                await typeText(query)
+                await pause(1.5)
+                rows("palette after typing \(query)")
+                key(53, "\u{1B}"); key(53, "\u{1B}"); key(53, "\u{1B}")
+                log("Escape x3")
+            }
+            await pause(0.5)
+            log("done")
+        }
+    }
+}
+#endif
