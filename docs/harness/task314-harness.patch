TASK-314 runtime harness, second version (2026-11-09). It replaces the first
(a quarantine Open-in harness that did not reproduce the bug). Temporary code,
never committed to Detour/. Gated on DETOUR_VERIFY_DIR, DETOUR_DATA_DIR and
DETOUR_VERIFY_URL (the link to open); DETOUR_VERIFY_MODE picks the scenario:

  same    window on the first space; openLink(url, .openInSpace(first space));
          log the tab against its row every change for 20 s, then close it
  other   the same, with the window on a second space first
  bg      the same, with Detour hidden first (a link from another app)
  zombie  window A on Work; window B on Home, closed while the harness still
          holds it (stands in for whatever kept the user's window alive); then
          the link into Home. Before the fix: B was re-shown, its row kept the
          address, and closing left a ghost row. After the fix: the link goes
          to A, the row follows the title, and the close removes it.
  leak    B opened and closed with only a weak reference: B is freed within
          1 s (no leak in the plain case); logs B's address for
          `leaks --traceTree=<addr> <pid>`

    git apply docs/harness/task314-harness.patch && xcodegen generate
    xcodebuild -scheme Detour -configuration Debug -derivedDataPath .derived build
    printf 'https://example.com/' > $H/url.txt; run.sh zombie DetourVerifyNNN
    git apply -R docs/harness/task314-harness.patch && xcodegen generate

Live diagnosis of a running production app without a debugger, also used
here: the Accessibility API (AXIsProcessTrusted was already true) reads each
sidebar table's rows, visible rows and selection (axdump/axwatch/axvis below,
compiled with swiftc), and CGWindowListCopyWindowInfo(.optionAll) lists
closed-but-alive windows as off-screen windows.

--- run.sh ---
    #!/bin/zsh
    H=/private/tmp/claude-501/-Users-tma-Projects-browser-MyBrowser/4c02c093-62fa-4604-852f-8d16dbdb08e3/scratchpad/task314b
    MODE=$1; DD=$2
    [ -n "$DD" ] || { echo "no data dir"; exit 1; }
    APP=/Users/tma/Projects/browser/MyBrowser/.derived/Build/Products/Debug/Detour.app
    LOG=$H/out/verify-$MODE.log
    rm -f -- $LOG
    DETOUR_DATA_DIR=$DD DETOUR_VERIFY_DIR=$H/out DETOUR_VERIFY_MODE=$MODE DETOUR_VERIFY_URL="$(cat $H/url.txt)" \
      "$APP/Contents/MacOS/Detour" > $H/out/stderr-$MODE.log 2>&1 &
    PID=$!
    echo "launched $PID"
    seen=0
    for i in $(seq 1 240); do
      sleep 0.25
      [ -f $LOG ] || continue
      total=$(wc -l < $LOG)
      if [ $total -gt $seen ]; then
        sed -n "$((seen+1)),${total}p" $LOG | while read -r line; do
          case "$line" in
            *"SHOOT "*) set -- ${=line#*SHOOT }; screencapture -x -o -l $2 $H/out/$1.png && echo "shot $1";;
          esac
        done
        seen=$total
      fi
      if grep -q "\] done" $LOG; then break; fi
      kill -0 $PID 2>/dev/null || { echo "app exited"; break; }
    done
    sleep 1
    kill $PID 2>/dev/null; echo "killed $PID"

--- axwatch.swift (usage: axwatch <pid> <seconds> <log> <windowNumber>) ---
    import ApplicationServices
    import Foundation
    let pid = pid_t(CommandLine.arguments[1])!
    let seconds = Double(CommandLine.arguments[2])!
    let out = CommandLine.arguments[3]
    let app = AXUIElementCreateApplication(pid)
    func attr(_ e: AXUIElement, _ a: String) -> AnyObject? { var v: AnyObject?; return AXUIElementCopyAttributeValue(e, a as CFString, &v) == .success ? v : nil }
    func str(_ e: AXUIElement, _ a: String) -> String? { attr(e, a) as? String }
    func children(_ e: AXUIElement) -> [AXUIElement] { (attr(e, kAXChildrenAttribute) as? [AXUIElement]) ?? [] }
    func pos(_ e: AXUIElement) -> CGPoint { var p = CGPoint.zero; if let v = attr(e, kAXPositionAttribute) { AXValueGetValue(v as! AXValue, .cgPoint, &p) }; return p }
    func texts(_ e: AXUIElement, depth: Int = 0) -> [String] {
        var out: [String] = []
        if str(e, kAXRoleAttribute) == kAXStaticTextRole, let v = str(e, kAXValueAttribute), !v.isEmpty { out.append(v) }
        if depth < 6 { for c in children(e) { out += texts(c, depth: depth + 1) } }
        return out
    }
    func tables(_ e: AXUIElement, depth: Int, into: inout [AXUIElement]) {
        let role = str(e, kAXRoleAttribute)
        if role == kAXTableRole { into.append(e); return }
        if depth < 25 { for c in children(e) { tables(c, depth: depth + 1, into: &into) } }
    }
    func snapshot() -> String {
        var s = ""
        for w in (attr(app, kAXWindowsAttribute) as? [AXUIElement]) ?? [] {
            let title = str(w, kAXTitleAttribute) ?? ""
            let wx = pos(w).x
            s += "WINDOW \(title)\n"
            var ts: [AXUIElement] = []; tables(w, depth: 0, into: &ts)
            for t in ts {
                let rows = (attr(t, kAXRowsAttribute) as? [AXUIElement]) ?? []
                if rows.count > 60 { continue }   // the archive page
                let selected = ((attr(t, kAXSelectedRowsAttribute) as? [AXUIElement]) ?? []).map { pos($0).y }
                let visible = abs(pos(t).x - wx) < 40 ? " ON-SCREEN" : ""
                s += "  table x+\(Int(pos(t).x - wx))\(visible)\n"
                for r in rows {
                    let label = texts(r).joined(separator: " | ")
                    if label.isEmpty { continue }
                    s += "    \(selected.contains(pos(r).y) ? "*" : " ") \(label.prefix(90))\n"
                }
            }
        }
        return s
    }
    let start = Date()
    var last = ""
    let fmt = DateFormatter(); fmt.dateFormat = "HH:mm:ss.SSS"
    while Date().timeIntervalSince(start) < seconds {
        let s = snapshot()
        if s != last {
            let stamp = fmt.string(from: Date())
            let line = "=== \(stamp)\n\(s)"
            if let h = FileHandle(forWritingAtPath: out) { h.seekToEndOfFile(); h.write(line.data(using: .utf8)!); try? h.close() }
            else { try? line.write(toFile: out, atomically: true, encoding: .utf8) }
            let shot = Process(); shot.launchPath = "/usr/sbin/screencapture"
            shot.arguments = ["-x", "-o", "-l", CommandLine.arguments[4], (out as NSString).deletingLastPathComponent + "/watch-\(stamp.replacingOccurrences(of: ":", with: "")).png"]
            try? shot.run(); shot.waitUntilExit()
            last = s
        }
        Thread.sleep(forTimeInterval: 0.5)
    }

