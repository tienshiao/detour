+// TEMP TASK-314 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    func runTask314HarnessIfRequested(_ wc: BrowserWindowController) {
+        let env = ProcessInfo.processInfo.environment
+        guard let outDir = env["DETOUR_VERIFY_DIR"], env["DETOUR_DATA_DIR"] != nil,
+              let link = env["DETOUR_VERIFY_URL"].flatMap(URL.init(string:)) else { return }
+        let mode = env["DETOUR_VERIFY_MODE"] ?? "same"   // same | other (window on another space first)
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify-\(mode).log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%7.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        let store = TabStore.shared
+        var target = wc
+        @MainActor func sleep(_ s: Double) async { try? await Task.sleep(nanoseconds: UInt64(s * 1_000_000_000)) }
+        func shoot(_ name: String) async {
+            guard let window = target.window else { return }
+            await sleep(0.2)
+            log("SHOOT \(mode)-\(name) \(window.windowNumber)")
+            await sleep(1.0)
+        }
+        func short(_ s: String?) -> String { String((s ?? "nil").prefix(70)) }
+        func state(_ space: Space) -> String {
+            let table = target.tabSidebar.tableView
+            let cells = (0..<table.numberOfRows).map { row -> String in
+                (table.view(atColumn: 0, row: row, makeIfNecessary: false) as? TabCellView).map { short($0.titleLabel.stringValue) } ?? "·"
+            }
+            return "active=\(target.activeSpace?.name ?? "nil") store=\(space.tabs.map { short($0.title) }) "
+                + "sidebar.tabs=\(target.tabSidebar.tabs.map { short($0.title) }) rows=\(table.numberOfRows) cells=\(cells) "
+                + "selRows=\(Array(table.selectedRowIndexes)) sel=\(short(target.selectedTab?.title))"
+        }
+
+        Task { @MainActor in
+            await sleep(2.5)
+            NSApp.appearance = NSAppearance(named: .aqua)
+            guard let home = store.nonIncognitoSpaces.first else { return log("no space") }
+            if mode == "other" {
+                let other = store.nonIncognitoSpaces.first { $0.id != home.id && $0.profileID == home.profileID }
+                    ?? store.addSpace(name: "Other", emoji: "💾", colorHex: "8E8E93", profileID: home.profileID)
+                wc.setActiveSpace(id: other.id)
+            } else {
+                wc.setActiveSpace(id: home.id)
+            }
+            await sleep(0.5)
+            var zombieBefore: Set<UUID>? = nil
+            if mode == "leak" {
+                // Only a weak reference here, so nothing of the harness keeps B alive.
+                weak var weakB: BrowserWindowController?
+                var address = ""
+                do {
+                    let b = self.createNewWindow(showing: home)
+                    weakB = b
+                    address = String(format: "0x%lx", UInt(bitPattern: Unmanaged.passUnretained(b).toOpaque()))
+                }
+                await sleep(1.0)
+                weakB?.window?.performClose(nil)
+                for i in 0..<6 {
+                    await sleep(1.0)
+                    log("leak check \(i): B alive=\(weakB != nil) listed=\(NSApp.browserWindowControllersFrontToBack.contains { $0 === weakB })")
+                }
+                log("LEAK B=\(address) pid=\(ProcessInfo.processInfo.processIdentifier) alive=\(weakB != nil)")
+                await sleep(90)
+                log("done")
+                return
+            }
+            if mode == "zombie" {
+                // Window A (wc) on Work; window B on Home, then closed the way a person closes it.
+                let work = store.nonIncognitoSpaces.first { $0.id != home.id && $0.profileID == home.profileID }
+                    ?? store.addSpace(name: "Work", emoji: "💾", colorHex: "8E8E93", profileID: home.profileID)
+                wc.setActiveSpace(id: work.id)
+                let b = self.createNewWindow(showing: home)
+                b.window?.setFrameOrigin(NSPoint(x: (wc.window?.frame.minX ?? 0) + 60, y: (wc.window?.frame.minY ?? 0) - 40))
+                await sleep(1.0)
+                weak var weakB = b
+                let bNumber = b.window?.windowNumber ?? 0
+                b.window?.performClose(nil)
+                await sleep(1.5)
+                let listed = NSApp.browserWindowControllersFrontToBack
+                log("closed B (#\(bNumber)): B alive=\(weakB != nil) B visible=\(weakB?.window?.isVisible ?? false) "
+                    + "frontToBack=\(listed.map { "\($0.window?.windowNumber ?? 0)@\($0.activeSpace?.name ?? "-")\($0.window?.isVisible == true ? "" : "(closed)")" }) A=#\(wc.window?.windowNumber ?? 0)")
+                wc.window?.makeKeyAndOrderFront(nil)
+                await sleep(0.5)
+                zombieBefore = Set(home.tabs.map(\.id))
+                log("start mode=zombie A active=\(wc.activeSpace?.name ?? "nil")")
+                self.openLink(link, routedTo: .openInSpace(home.id))
+                await sleep(0.3)
+                let placedIn = NSApp.browserWindowControllersFrontToBack.first
+                log("placed in #\(placedIn?.window?.windowNumber ?? 0) revivedB=\(placedIn === weakB) visible=\(placedIn?.window?.isVisible ?? false) "
+                    + "key=\(NSApp.keyWindow?.windowNumber ?? 0)")
+                if let placedIn { target = placedIn }
+            }
+            let before = zombieBefore ?? Set(home.tabs.map(\.id))
+            if mode == "bg" { NSApp.hide(nil); await sleep(1.5); log("hidden: active=\(NSApp.isActive) visible=\(wc.window?.isVisible ?? false) occl=\(wc.window?.occlusionState.contains(.visible) ?? false)") }
+            log("start mode=\(mode) \(state(home))")
+            if mode != "zombie" { self.openLink(link, routedTo: .openInSpace(home.id)) }
+            guard let tab = home.tabs.first(where: { !before.contains($0.id) }) else { return log("no new tab") }
+            var lastURL = "", lastTitle = "", lastCells = ""
+            // Every change of the tab, and of the sidebar's cells, for 20 s.
+            for i in 0..<400 {
+                let u = tab.url?.absoluteString ?? "nil", t = tab.title
+                let cells = state(home)
+                if u != lastURL || t != lastTitle || cells != lastCells {
+                    log("tab url=\(short(u)) title=\(short(t)) loading=\(tab.isLoading) fav=\(tab.favicon != nil) | \(cells)")
+                    lastURL = u; lastTitle = t; lastCells = cells
+                }
+                if i == 40 { await shoot("01-2s") }
+                await sleep(0.05)
+            }
+            log("final: \(state(home))")
+            await shoot("02-final")
+            target.selectTab(id: tab.id)
+            await sleep(0.3)
+            target.closeCurrentTab(nil)
+            await sleep(1.0)
+            log("after close: \(state(home))")
+            await shoot("03-after-close")
+            log("done")
+        }
+    }
+}
+#endif
