+// TEMP TASK-290 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask290HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        func log(_ line: String) {
+            let data = Data((line + "\n").utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) { h.seekToEndOfFile(); h.write(data); try? h.close() }
+            else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 3.0
+        func at(_ dt: TimeInterval, _ block: @escaping @MainActor @Sendable () -> Void) {
+            clock += dt
+            Timer.scheduledMainTimer(withTimeInterval: clock, repeats: false) { _ in block() }
+        }
+        guard let window = wc.window else { return log("no window") }
+        func key(_ chars: String) {
+            guard let e = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [],
+                                           timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: window.windowNumber, context: nil,
+                                           characters: chars, charactersIgnoringModifiers: chars,
+                                           isARepeat: false, keyCode: 0) else { return }
+            window.firstResponder?.keyDown(with: e)
+        }
+        func chip() -> String {
+            guard let p = wc.commandPaletteView else { return "no palette" }
+            let rgb = SiteColor.RGB(p.siteSearchChip.fill)
+            return String(format: "site=%@ fill=(%.2f %.2f %.2f) text=%@", p.activeSiteSearch?.name ?? "nil",
+                          rgb?.red ?? -1, rgb?.green ?? -1, rgb?.blue ?? -1,
+                          p.siteSearchChip.textColor == .white ? "white" : "dark")
+        }
+        at(0) {
+            guard let spaceID = wc.activeSpaceID else { return log("no space") }
+            HistoryDatabase.shared.recordVisit(url: "https://www.youtube.com/", title: "YouTube",
+                                               faviconURL: "https://www.youtube.com/favicon.ico",
+                                               spaceID: spaceID.uuidString, typed: true)
+            NSApp.activate(ignoringOtherApps: true); window.makeKeyAndOrderFront(nil)
+            log("space color \(wc.activeSpace?.colorHex ?? "?")")
+        }
+        at(1.0) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); key("y"); key("t"); key(" "); log("yt: \(chip())") }
+        at(2.5) { key("c"); key("a"); key("t"); key("s"); log("after icon: \(chip())"); log("SHOOT \(window.windowNumber) youtube") }
+        at(2.5) {
+            wc.dismissCommandPalette()
+            NSApp.appearance = NSAppearance(named: .darkAqua)
+            NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); key("g"); key("h"); key(" "); key("x")
+            log("gh: \(chip())")
+        }
+        at(2.0) { log("gh later: \(chip())"); log("SHOOT \(window.windowNumber) github-dark") }
+        at(2.5) { log("done") }
+    }
+}
+#endif
