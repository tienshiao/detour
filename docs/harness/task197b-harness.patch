+// TEMP TASK-197b verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    func runTask197bHarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"],
+              let port = ProcessInfo.processInfo.environment["DETOUR_VERIFY_PORT"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        // Steps run in order; each waits until every capture requested so far
+        // exists, so a slow watcher cannot shoot a later state.
+        var steps: [(TimeInterval, () -> Void)] = []
+        var requestedShots: [String] = []
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) { steps.append((dt, block)) }
+        func runStep(_ index: Int) {
+            guard index < steps.count else { return }
+            let missing = requestedShots.filter { !FileManager.default.fileExists(atPath: "\(outDir)/\($0).png") }
+            let delay = missing.isEmpty ? steps[index].0 : 0.2
+            let timer = Timer(timeInterval: delay, repeats: false) { _ in
+                if missing.isEmpty { steps[index].1(); runStep(index + 1) } else { runStep(index) }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window, let space = wc.activeSpace, let profile = space.profile else {
+            return log("no window/space")
+        }
+        let store = TabStore.shared
+        func allSubviews(_ view: NSView) -> [NSView] {
+            view.subviews + view.subviews.flatMap(allSubviews)
+        }
+        func local(_ host: String, _ path: String) -> URL { URL(string: "http://\(host):\(port)/\(path)")! }
+        func dataPage(_ title: String) -> URL {
+            let html = "<meta name=color-scheme content='light dark'><title>\(title)</title><h1>\(title)</h1>"
+            return URL(string: "data:text/html," + html.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed)!)!
+        }
+        var tabs: [String: BrowserTab] = [:]
+        var second: BrowserWindowController?
+        var space2: Space?
+
+        func r(_ rect: NSRect) -> String {
+            String(format: "%.1f,%.1f,%.1f,%.1f", rect.minX, rect.minY, rect.width, rect.height)
+        }
+        func title(_ id: UUID?) -> String {
+            guard let id else { return "nil" }
+            return tabs.first { $0.value.id == id }.map { "\($0.key)" } ?? id.uuidString.prefix(8).description
+        }
+        /// Every visible row and tile of `controller`'s sidebar: host line, borders, frames.
+        func state(_ name: String, _ controller: BrowserWindowController, _ label: String) {
+            guard let w = controller.window, let content = w.contentView else { return }
+            let views = allSubviews(content)
+            let table = controller.tabSidebar.tableView
+            log("\(name) \(label) selectedTab=\(title(controller.selectedTabID)) tableSelectedRow=\(table.selectedRow) "
+                + "hazard=\(DevModePalette.current.hazard.usingColorSpace(.sRGB).map { String(format: "%.0f,%.0f,%.0f", $0.redComponent * 255, $0.greenComponent * 255, $0.blueComponent * 255) } ?? "?")")
+            let cells = views.compactMap { $0 as? TabCellView }
+                .filter { $0.window != nil && !$0.isHiddenOrHasHiddenAncestor && !$0.visibleRect.isEmpty }
+            for cell in cells {
+                let frame = cell.convert(cell.bounds, to: nil)
+                let sides = cell.devModeBorderFrames.map { f -> String in
+                    if f.width > cell.bounds.width * 0.75 { return "row" }
+                    return f.maxX <= cell.bounds.midX ? "left" : "right"
+                }
+                let host = cell.hostLineLabel.isHidden ? "-" : cell.hostLineLabel.stringValue
+                let rowSelected = (cell.superview as? NSTableRowView)?.isSelected ?? false
+                var t = cell.titleLabel.stringValue
+                if !cell.splitTitleLabel.isHidden { t += " | " + cell.splitTitleLabel.stringValue }
+                log("\(name) \(label)   ROW \"\(t)\" rowSelected=\(rowSelected) cellSelected=\(cell.isRowSelected) "
+                    + "host=\(host) borders=\(sides) frame=\(r(frame)) title=\(r(cell.titleLabel.convert(cell.titleLabel.bounds, to: nil))) "
+                    + "hostLine=\(r(cell.hostLineLabel.convert(cell.hostLineLabel.bounds, to: nil)))")
+            }
+            let tiles = views.compactMap { $0 as? FavoriteTileView }
+                .filter { $0.window != nil && !$0.isHiddenOrHasHiddenAncestor && !$0.visibleRect.isEmpty }
+            for tile in tiles {
+                log("\(name) \(label)   TILE \"\(tile.favorite.title)\" selected=\(tile.isSelected) border=\(tile.showsDevModeBorder) "
+                    + "frame=\(r(tile.convert(tile.bounds, to: nil)))")
+            }
+        }
+        func shoot(_ name: String, _ controller: BrowserWindowController? = nil) {
+            let c = controller ?? wc
+            guard let w = c.window else { return }
+            state(name, c, c === wc ? "w1" : "w2")
+            requestedShots.append(name)
+            log("SHOOT \(name) \(w.windowNumber)")
+        }
+        func clickRow(titled t: String) {
+            let table = wc.tabSidebar.tableView
+            guard let cell = allSubviews(table).compactMap({ $0 as? TabCellView }).first(where: { $0.titleLabel.stringValue == t }) else {
+                return log("no row \(t)")
+            }
+            let row = table.row(for: cell)
+            table.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
+            log("clicked row \(row) \"\(t)\" (table selection path)")
+        }
+
+        // MARK: Seed (on the 2x screen if there is one)
+        at(0) {
+            NSApp.activate(ignoringOtherApps: true)
+            NSApp.appearance = NSAppearance(named: .aqua)
+            let screen = NSScreen.screens.first { $0.backingScaleFactor >= 2 } ?? window.screen ?? NSScreen.main!
+            let f = screen.visibleFrame
+            window.setFrame(NSRect(x: f.minX + 20, y: f.maxY - 20 - 640, width: 760, height: 640), display: true)
+            tabs["dev"] = store.addTab(in: space, url: local("localhost", "app.html"))
+            tabs["api"] = store.addTab(in: space, url: local("127.0.0.1", "api.html"))
+            tabs["remote"] = store.addTab(in: space, url: dataPage("Remote Docs"))
+            tabs["splitA"] = store.addTab(in: space, url: local("localhost", "split.html"))
+            tabs["splitB"] = store.addTab(in: space, url: dataPage("Reference"))
+            tabs["pin"] = store.addTab(in: space, url: local("localhost", "pin.html"))
+            tabs["dormant"] = store.addTab(in: space, url: local("localhost", "dormant.html"))
+            tabs["fav"] = store.addTab(in: space, url: local("localhost", "fav.html"))
+            log("seeded: screens \(NSScreen.screens.map { "\($0.localizedName) \($0.backingScaleFactor)x" }) window scale \(window.backingScaleFactor) frame \(r(window.frame))")
+        }
+        at(3.5) {
+            store.createSplit(draggedTabID: tabs["splitB"]!.id, targetTabID: tabs["splitA"]!.id, edge: .right, in: space)
+            for tab in space.tabs where !tabs.values.contains(where: { $0 === tab }) {
+                store.closeTab(id: tab.id, in: space, undoable: false)
+            }
+            store.pinTab(id: tabs["pin"]!.id, in: space)
+            store.pinTab(id: tabs["dormant"]!.id, in: space)
+            store.closePinnedTab(id: tabs["dormant"]!.id, in: space, undoable: false)
+            _ = store.moveTabToFavorites(id: tabs["fav"]!.id, from: space, profileID: profile.id)
+            store.undoManager.removeAllActions()
+            wc.selectTab(id: tabs["dev"]!.id)
+            window.makeKeyAndOrderFront(nil)
+            log("arranged: tabs=\(space.tabs.map { $0.title }) pinned=\(space.pinnedEntries.map { "\($0.pinnedTitle) live=\($0.isLive)" }) favorites=\(profile.favorites.map(\.title))")
+        }
+        for (p, appearance) in [("L", NSAppearance.Name.aqua), ("D", .darkAqua)] {
+            at(1.5) {
+                NSApp.appearance = NSAppearance(named: appearance)
+                wc.selectTab(id: tabs["dev"]!.id)
+            }
+            at(1.0) { shoot("\(p)-1-dev-selected") }
+            // The click path: the table's selection changes first, then the window follows.
+            at(0.5) { clickRow(titled: "API Server") }
+            at(1.0) { shoot("\(p)-2-other-dev-selected") }
+            at(0.5) { wc.selectTab(id: tabs["remote"]!.id) }
+            at(1.0) { shoot("\(p)-3-normal-selected") }
+            // The split selected with its NON-dev pane focused, then the dev pane.
+            at(0.5) { wc.selectTab(id: tabs["splitB"]!.id) }
+            at(1.0) { shoot("\(p)-4a-split-selected-remote-pane") }
+            at(0.5) { wc.selectTab(id: tabs["splitA"]!.id) }
+            at(1.0) { shoot("\(p)-4b-split-selected-dev-pane") }
+            at(0.5) { wc.selectTab(id: tabs["dev"]!.id) }
+            at(1.0) { shoot("\(p)-4c-split-unselected") }
+            at(0.5) { wc.selectTab(id: tabs["fav"]!.id) }
+            at(1.0) { shoot("\(p)-5a-fav-selected") }
+            at(0.5) { wc.selectTab(id: tabs["pin"]!.id) }
+            at(1.0) { shoot("\(p)-5b-pinned-selected-fav-unselected") }
+        }
+        // MARK: 7 — space switch and back
+        at(1.0) {
+            NSApp.appearance = NSAppearance(named: .aqua)
