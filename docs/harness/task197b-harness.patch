+        at(1.5) { shoot("L-7a-space2-dev-selected") }
+        at(0.5) { wc.setActiveSpace(id: space.id) }
+        at(1.5) { shoot("L-7b-back-to-space1") }
+        // MARK: 6 — a second window on the same space, its own selection
+        at(0.5) {
