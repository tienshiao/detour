+                let timer = Timer(timeInterval: t, repeats: false) { _ in log(String(format: "  17 after sleep +%.2f: ", t) + barState()) }
+                RunLoop.main.add(timer, forMode: .common)
+            }
+        }
+        at(0.8) {
+            guard let slept else { return log("17: no retained web view") }
+            let playing = (slept.value(forKey: "_isPlayingAudio") as? NSNumber)?.boolValue ?? false
+            slept.requestMediaPlaybackState { state in
+                slept.evaluateJavaScript("(() => { const e = document.querySelector('audio'); return 'paused=' + e.paused + ' t=' + e.currentTime.toFixed(1) })()") { result, _ in
+                    log("17 released web view +0.8 s: _isPlayingAudio=\(playing) playbackState=\(state.rawValue) page: \(result ?? "nil")")
+                }
+            }
+        }
+        at(0.7) { slept = nil; close(sm) }
+
+        }
+        // 12b (focused runs only). A playing Media Session tab navigated away, back, and closed.
+        if onlyLongList {
+            var nav: BrowserTab!
+            at(0.5) { nav = store.addTab(in: homeSpace, url: url("ms.html?nav")); wc.selectTab(id: nav.id); log("12b: nav tab \(nav.id.uuidString.prefix(8)) selected") }
+            at(3.0) { wc.selectTab(id: blank.id); log("12b: left nav") }
+            at(1.0) { log("12b playing, left: " + barState()); dumpPlaying("12b left") }
+            at(0.3) { watchClear(nav, "12b blank"); nav.load(url("blank.html?nav2")); log("12b: nav -> blank.html?nav2") }
+            at(1.0) { log("12b +1.0: " + barState()); dumpPlaying("12b +1.0") }
+            at(1.5) { log("12b +2.5: " + barState()); dumpPlaying("12b +2.5") }
+            at(0.5) { nav.webView?.goBack(); log("12b: goBack") }
+            at(2.0) { probe(nav, "12b after back"); log("12b after back: " + barState()); dumpPlaying("12b after back") }
+            at(0.5) { close(nav) }
+            at(1.0) { log("12b closed +1: " + barState()); dumpPlaying("12b closed +1") }
+            at(2.5) { log("12b closed +3.5: " + barState()); dumpPlaying("12b closed +3.5") }
+        }
+        // 15. A long list that scrolls, with the bar (the coordinator's follow-up).
+        var longSpace: Space!
+        var player: BrowserTab!
+        var longTabs: [BrowserTab] = []
+        func listState() -> String {
+            let tv = wc.tabSidebar.tableView
+            guard let sv = tv.enclosingScrollView, let page = sv.superview else { return "no scroll view" }
+            let clip = sv.contentView
+            let last = tv.numberOfRows - 1
+            let lastRect = tv.rect(ofRow: last)
+            let visible = clip.documentVisibleRect
+            let lastVisible = lastRect.intersection(visible)
+            var probeRect = clip.bounds
+            probeRect.origin.y = 1e7
+            let maxY = clip.constrainBoundsRect(probeRect).origin.y
+            let shadows = page.subviews.filter { $0 is FadeShadowView }.map { ($0, $0.convert($0.bounds, to: nil)) }
+            let bottom = shadows.min { $0.1.minY < $1.1.minY }
+            let clipWin = clip.convert(clip.bounds, to: nil)
+            let barWin = bar.convert(bar.bounds, to: nil)
+            func r(_ rect: NSRect) -> String { String(format: "y %.1f-%.1f", rect.minY, rect.maxY) }
+            return String(format: "offset=%.1f max=%.1f atEnd=%@ clipH=%.1f lastRowVisibleH=%.1f (of %.0f)", clip.bounds.origin.y, maxY,
+                          abs(clip.bounds.origin.y - maxY) < 0.5 ? "yes" : "NO", clip.bounds.height,
+                          lastVisible.isNull ? 0 : lastVisible.height, lastRect.height)
+                + " | win: list \(r(clipWin)) bottomShadow alpha=\(String(format: "%.2f", bottom?.0.alphaValue ?? -1)) \(bottom.map { r($0.1) } ?? "-") bar(hidden=\(bar.isHidden) alpha=\(String(format: "%.2f", bar.alphaValue))) \(r(barWin))"
+        }
+        func scrollListToEnd() {
+            let tv = wc.tabSidebar.tableView
+            guard let sv = tv.enclosingScrollView else { return }
+            let clip = sv.contentView
+            var probeRect = clip.bounds
+            probeRect.origin.y = 1e7
+            clip.scroll(to: NSPoint(x: clip.bounds.origin.x, y: clip.constrainBoundsRect(probeRect).origin.y))
+            sv.reflectScrolledClipView(clip)
+        }
+        func sample(_ label: String, _ times: [TimeInterval]) {
+            for t in times {
+                let timer = Timer(timeInterval: t, repeats: false) { _ in log(String(format: "  %@ +%.2f: ", label, t) + listState()) }
+                RunLoop.main.add(timer, forMode: .common)
+            }
+        }
+        func hitReport() -> String {
+            let tv = wc.tabSidebar.tableView
+            guard let frameView = window.contentView?.superview else { return "" }
+            let lastRect = tv.rect(ofRow: tv.numberOfRows - 1)
+            let barWin = bar.convert(bar.bounds, to: nil)
+            let points: [(String, NSPoint)] = [
+                ("lastRow lower quarter", tv.convert(NSPoint(x: lastRect.midX, y: lastRect.maxY - lastRect.height * 0.25), to: nil)),
+                ("bar top +1 inside", NSPoint(x: barWin.midX, y: barWin.maxY - 1)),
+                ("bar top -1 outside", NSPoint(x: barWin.midX, y: barWin.maxY + 1)),
+            ]
+            return points.map { name, p in
+                let hit = frameView.hitTest(p)
+                let owner = hit == nil ? "nil" : hit!.isDescendant(of: bar) ? "bar" : hit!.isDescendant(of: tv) ? "table" : String(describing: type(of: hit!))
+                return " | hit \(name) (y \(String(format: "%.1f", p.y))): \(owner)"
+            }.joined()
+        }
+        at(1.0) {
+            player = store.addTab(in: homeSpace, url: url("plain.html?long"))
+            wc.selectTab(id: player.id)
+            log("STEP 15: long list; the player is in the home space")
+            dumpPlaying("STEP 15 start")
+        }
+        at(3.0) {
+            longSpace = store.addSpace(name: "Long", emoji: "📜", colorHex: "#8B5BEF", profileID: homeSpace.profileID)
+            for i in 0..<30 { longTabs.append(store.addTab(in: longSpace, url: url("blank.html?row=\(i)"))) }
+            wc.setActiveSpace(id: longSpace.id, selectTab: false)
+            wc.selectTab(id: longTabs[0].id)
+            log("space Long with 30 tabs, first selected")
+        }
+        at(2.0) { log("bar while the player plays: " + barState()); run(player, "document.getElementById('a').pause()"); log("player paused: the bar hides after the grace") }
+        at(3.0) { scrollListToEnd() }
+        at(0.5) { log("15.1 scrolled to the end, no bar: " + listState()); log(barState()); shoot("long-end-nobar") }
+        at(2.5) { run(player, "document.getElementById('a').play()"); log("player plays: the bar appears"); sample("show", [0.02, 0.06, 0.1, 0.15, 0.2, 0.3, 0.5]) }
+        at(1.0) { log("15.1 after show: " + listState()); log(barState()); shoot("long-end-bar") }
+        at(2.5) {
+            let tv = wc.tabSidebar.tableView
+            tv.scrollRowToVisible(tv.numberOfRows / 2)
+        }
+        at(0.5) { log("15.2 mid-list with the bar: " + listState()); shoot("long-mid-bar") }
+        at(2.5) { scrollListToEnd() }
+        at(0.5) { log("15.3 at the end, before expanding: " + listState() + hitReport()); bar.setExpanded(true, animated: true) }
+        at(0.6) { log("15.3 expanded: " + listState() + hitReport()); shoot("long-end-expanded") }
+        at(2.5) { bar.setExpanded(false, animated: true) }
+        at(0.6) { log("15.3 collapsed: " + listState() + hitReport()) }
+        at(0.5) {
+            let sidebar: TabSidebarViewController = wc.tabSidebar
+            let tv = sidebar.tableView
+            let moved = longTabs[3]
+            let payload = SidebarDragPayload(kind: .normalTab, itemID: moved.id, spaceID: longSpace.id, sidebarID: sidebar.sidebarID)
+            let pasteboard = NSPasteboard(name: NSPasteboard.Name("task192-drag"))
+            pasteboard.clearContents()
+            let item = NSPasteboardItem()
+            item.setString(payload.pasteboardString!, forType: tabReorderPasteboardType)
+            pasteboard.writeObjects([item])
+            let lastRow = tv.numberOfRows - 1
+            let lastRect = tv.rect(ofRow: lastRow)
+            let location = tv.convert(NSPoint(x: lastRect.midX, y: lastRect.maxY - lastRect.height * 0.25), to: nil)
+            let info = Task192StubDragInfo(pasteboard: pasteboard, location: location, window: window)
+            let hit = window.contentView?.superview?.hitTest(location)
+            let operation = sidebar.tableView(tv, validateDrop: info, proposedRow: lastRow + 1, proposedDropOperation: .above)
+            let accepted = sidebar.tableView(tv, acceptDrop: info, row: lastRow + 1, dropOperation: .above)
+            let index = longSpace.tabs.firstIndex { $0.id == moved.id } ?? -1
+            log("15.4 drop tab 3 below the last row (window y \(String(format: "%.1f", location.y)), hit \(hit.map { $0.isDescendant(of: tv) ? "table" : $0.isDescendant(of: bar) ? "bar" : "\(type(of: $0))" } ?? "nil")): validateDrop=\(operation.rawValue) acceptDrop=\(accepted) -> index \(index) of \(longSpace.tabs.count)")
+        }
+        at(1.5) { log("15.4 after the drop: " + listState()) }
+        at(0.5) { scrollListToEnd() }
+        at(0.5) { log("15.1r at the end, before hiding: " + listState()); run(player, "document.getElementById('a').pause()"); log("player paused: the bar hides after the grace"); sample("hide", [1.7, 1.8, 1.9, 2.0, 2.1, 2.2, 2.4, 2.8]) }
+        at(3.5) { log("15.1r after hide: " + listState()); shoot("long-end-hidden") }
+        at(1.0) {
+            wc.setActiveSpace(id: homeSpace.id)
+            for tab in longTabs { close(tab) }
+            close(player)
+            log("closed the long list")
+        }
+        at(1.5) {
+            HTTPCookieStorage.shared.deleteCookie(jarCookie)
+            URLCache.shared.removeCachedResponse(for: URLRequest(url: url("art.png")))
+            log("done")
+        }
+    }
+}
