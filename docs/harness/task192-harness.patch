+/// Step 17: called from `pauseAllMediaPlayback` on any BrowserWebView.
+var task192PauseHook: ((WKWebView) -> Void)?
+
+extension BrowserWebView {
+    override func pauseAllMediaPlayback(completionHandler: (() -> Void)? = nil) {
+        task192PauseHook?(self)
+        super.pauseAllMediaPlayback(completionHandler: completionHandler)
+    }
+}
