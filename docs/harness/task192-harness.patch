+// TEMP TASK-192 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    func runTask192HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let port = ProcessInfo.processInfo.environment["DETOUR_VERIFY_PORT"] ?? "8892"
+        let onlyLongList = ProcessInfo.processInfo.environment["DETOUR_VERIFY_ONLY"] == "longlist"
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%7.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 4.0
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) {
+            clock += dt
+            let timer = Timer(timeInterval: clock, repeats: false) { _ in block() }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window else { return log("no window") }
+        window.setFrame(NSRect(x: 80, y: 80, width: 1100, height: 760), display: true)
+        let store = TabStore.shared
+        let bar = wc.tabSidebar.nowPlayingBar
+        func url(_ path: String, host: String = "127.0.0.1") -> URL { URL(string: "http://\(host):\(port)/\(path)")! }
+        func allSubviews(_ view: NSView) -> [NSView] { view.subviews + view.subviews.flatMap(allSubviews) }
+        func barButton(_ label: String, in w: BrowserWindowController = wc) -> NSButton? {
+            allSubviews(w.tabSidebar.nowPlayingBar).compactMap { $0 as? NSButton }.first { $0.accessibilityLabel() == label }
+        }
+        func click(_ label: String, in w: BrowserWindowController = wc) {
+            guard let button = barButton(label, in: w) else { return log("CLICK \(label): no such button") }
+            button.performClick(nil)
+            log("CLICK \(label)\(w === wc ? "" : " (window B)")")
+        }
+        func barState(_ w: BrowserWindowController = wc) -> String {
+            let b = w.tabSidebar.nowPlayingBar
+            guard let model = b.model, !b.isHidden else { return "BAR hidden (shown=\(String(describing: w.nowPlaying.shownTabID)))" }
+            guard w.nowPlaying.shownTabID != nil else { return "BAR hiding (alpha=\(b.alphaValue), view not yet hidden)" }
+            let labels = allSubviews(b).compactMap { $0 as? NSButton }.filter { !$0.isHidden }
+                .map { "\($0.accessibilityLabel() ?? "?")\($0.isEnabled ? "" : "(off)")" }
+            return "BAR alpha=\(String(format: "%.2f", b.alphaValue)) shown=\(w.nowPlaying.shownTabID == model.tabID) title=\"\(model.title)\" artist=\(model.artist ?? "-") artwork=\(model.artwork != nil) playing=\(model.isPlaying) muted=\(model.isMuted) prev=\(model.canGoPrevious) next=\(model.canGoNext) expanded=\(b.isExpanded) buttons=\(labels)"
+        }
+        func probe(_ tab: BrowserTab?, _ label: String, element: String = "document.querySelector('audio, video')") {
+            guard let tab, let webView = tab.webView else { return log("PROBE \(label): no web view") }
+            let muted = (webView.value(forKey: "_mediaMutedState") as? NSNumber)?.intValue ?? -1
+            webView.requestMediaPlaybackState { state in
+                webView.evaluateJavaScript("""
+                    (() => { const e = \(element); const parts = [];
+                      if (e) parts.push('paused=' + e.paused + ' muted=' + e.muted + ' t=' + e.currentTime.toFixed(1));
+                      if (window.ctx) parts.push('ctx=' + ctx.state);
+                      if (window.__log) parts.push('log=[' + __log.join(' | ') + ']');
+                      return parts.join(' '); })()
+                    """) { result, _ in
+                    log("PROBE \(label): isPlayingAudio=\(tab.isPlayingAudio) pageMuted=\(muted) playbackState=\(state.rawValue) pip=\(tab.isInPictureInPicture) heldByBar=\(tab.isPausedFromBar) suspendedByBar=\(tab.isMediaSuspendedFromBar) page: \(result ?? "nil")")
+                }
+            }
+        }
+        // A cookie in the app's shared jar: the favicon fetch (URLSession.shared)
+        // sends it; the artwork fetch must not.
+        let jarCookie = HTTPCookie(properties: [.domain: "127.0.0.1", .path: "/", .name: "sharedjar192", .value: "1"])!
+        func cacheReport(_ artwork: String) -> String {
+            let art = URLCache.shared.cachedResponse(for: URLRequest(url: url(artwork))) != nil
+            let fav = URLCache.shared.cachedResponse(for: URLRequest(url: url("art.png"))) != nil
+            return "URLCache.shared: artwork \(artwork) cached=\(art); favicon art.png cached=\(fav)"
+        }
+        /// Polls every 10 ms until the tab's Media Session report is gone.
+        func watchClear(_ tab: BrowserTab, _ label: String) {
+            let started = ProcessInfo.processInfo.systemUptime
+            var committed: TimeInterval?
+            let timer = Timer(timeInterval: 0.01, repeats: true) { timer in
+                let elapsed = ProcessInfo.processInfo.systemUptime - started
+                if committed == nil, tab.webView?.url?.lastPathComponent != "ms.html" { committed = elapsed }
+                if tab.mediaSession == nil {
+                    timer.invalidate()
+                    log(String(format: "CLEAR \(label): session nil at +%.3f s (web view URL changed at +%.3f s, isLoading=\(tab.isLoading))", elapsed, committed ?? -1))
+                    DispatchQueue.main.async { DispatchQueue.main.async { log("CLEAR \(label) bar: " + barState() + " barTabIsThisTab=\(wc.nowPlaying.shownTabID == tab.id) session now=\(tab.mediaSession?.title ?? "nil")"); dumpPlaying("CLEAR \(label)") } }
+                } else if elapsed > 4 {
+                    timer.invalidate()
+                    log("CLEAR \(label): still set after 4 s: \(String(describing: tab.mediaSession))")
+                }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        func dumpPlaying(_ label: String) {
+            for space in store.spaces {
+                for tab in space.tabs + space.pinnedTabs + (space.profile?.favoriteTabs ?? []) where tab.isPlayingAudio || tab.mediaSession != nil || tab.playbackSession != nil {
+                    log("  TAB[\(label)] space=\(space.name) id=\(tab.id.uuidString.prefix(8)) title=\(tab.title) url=\(tab.url?.absoluteString ?? "-") playing=\(tab.isPlayingAudio) session=\(tab.mediaSession?.title ?? "nil") run=\(tab.playbackSession.map { "\($0.startedAt.timeIntervalSince1970)" } ?? "nil") webView=\(tab.webView != nil)")
+                }
+            }
+            log("  shown=\(wc.nowPlaying.shownTabID?.uuidString.prefix(8) ?? "nil")")
+        }
+        func shoot(_ name: String, _ w: NSWindow? = nil) {
+            let shotWindow = w ?? window
+            let screenH = (shotWindow.screen ?? NSScreen.screens[0]).frame.maxY
+            let f = shotWindow.frame
+            log("SHOOT \(name) \(shotWindow.windowNumber) \(Int(f.minX)),\(Int(screenH - f.maxY)),\(Int(f.width)),\(Int(f.height))")
+            // In-process render of the sidebar too: works while the screen is
+            // locked (screencapture returns black then), but draws no glass.
+            let controller = (w?.windowController as? BrowserWindowController) ?? wc
+            let view = controller.tabSidebar.view
+            view.layoutSubtreeIfNeeded()
+            guard let layer = view.layer else { return log("RENDER \(name): no layer") }
+            let scale = w?.backingScaleFactor ?? window.backingScaleFactor
+            let size = view.bounds.size
+            guard let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: Int(size.width * scale), pixelsHigh: Int(size.height * scale),
+                                             bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
+                                             colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0),
+                  let ctx = NSGraphicsContext(bitmapImageRep: rep) else { return }
+            let cg = ctx.cgContext
+            cg.scaleBy(x: scale, y: scale)
+            let background = (view.effectiveAppearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua)
+                ? NSColor(white: 0.16, alpha: 1) : NSColor(white: 0.93, alpha: 1)
+            cg.setFillColor(background.cgColor)
+            cg.fill(CGRect(origin: .zero, size: size))
+            if view.isFlipped { cg.translateBy(x: 0, y: size.height); cg.scaleBy(x: 1, y: -1) }
+            layer.render(in: cg)
+            let url = URL(fileURLWithPath: outDir).appendingPathComponent("render-\(name).png")
+            try? rep.representation(using: .png, properties: [:])?.write(to: url)
+            log("RENDER \(name) \(url.lastPathComponent)")
+        }
+        func run(_ tab: BrowserTab?, _ js: String) { tab?.webView?.evaluateJavaScript(js) }
+
+        // 16. Which URLSession each artwork fetch goes through: the loader's two
+        // private fetchers, read by Mirror, and the fetch seam wrapped to look the
+        // new task up in each session.
