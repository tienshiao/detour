TASK-192 runtime harness: the now-playing bar. Temporary code, never
committed to Detour/. Needs two local servers and media fixtures:

    SP=<scratch>/www; SP2=<scratch>/www2; mkdir -p $SP $SP2
    ffmpeg -f lavfi -i "sine=frequency=330:sample_rate=44100" -t 120 -af volume=0.3 -c:a aac $SP/tone.m4a
    ffmpeg -f lavfi -i "sine=frequency=520:sample_rate=44100" -t 120 -af volume=0.3 -c:a aac $SP2/tone2.m4a
    ffmpeg -f lavfi -i testsrc=size=640x360:rate=30 -f lavfi -i sine=frequency=440 -t 120 \
        -c:v libx264 -pix_fmt yuv420p -c:a aac -af volume=0.3 -shortest $SP/video.mp4
    ffmpeg -f lavfi -i "color=c=orange:s=256x256" -frames:v 1 $SP/art.png
    # Pages (every element at volume 0.05, each keeps window.__log):
    #   ms.html      <audio src=tone.m4a loop>, MediaMetadata {title 'Fixture Track One',
    #                artist 'Detour Test Band', artwork art.png}, handlers previoustrack /
    #                nexttrack (log, change the title) and play / pause (log, play/pause)
    #   plain.html   the same audio, no Media Session
    #   video.html   <video src=video.mp4 loop>, logs webkitpresentationmodechanged
    #   iframe.html  <iframe src=http://127.0.0.1:8893/inner.html>; inner.html plays tone2.m4a
    #   webaudio.html  OscillatorNode -> GainNode(0.05), window.ctx, start() resumes it
    #   blank.html   any page
    #   (2026-10-25) ms.html's artwork is art.png?artwork=<track> (a distinct URL per
    #   track, apart from the favicon art.png); big.png: 1600x1600 noise PNG, 3.7 MB
    #   (ffmpeg nullsrc + geq random); doc.pdf: a one-page PDF written by hand.
    # Servers: a SimpleHTTPRequestHandler subclass (server192.py, in the scratchpad)
    # that logs each request's Cookie header, sets `page192=<port>` on HTML
    # responses and Cache-Control: max-age=3600 on PNGs:
    python3 -I server192.py 8892 $SP &
    python3 -I server192.py 8893 $SP2 &
    git apply docs/harness/task192-harness.patch && xcodegen generate
    xcodebuild -scheme Detour -configuration Debug build -derivedDataPath .derived
    rm -r -- ~/Library/Application\ Support/DetourVerify192   # restored tabs from an
        # earlier run (a focused run leaves its seeded ms.html open) play on the bar
    DETOUR_DATA_DIR=DetourVerify192 DETOUR_VERIFY_DIR="$OUT" DETOUR_VERIFY_PORT=8892 \
        [DETOUR_VERIFY_ONLY=longlist] \
        caffeinate -d -i .derived/Build/Products/Debug/Detour.app/Contents/MacOS/Detour &
    # DETOUR_VERIFY_ONLY=longlist runs only step 12b and step 15 (about 50 s).
    # A watcher runs `screencapture -x -o -l <windowNumber> $OUT/<name>.png` for each
    # "SHOOT <name> <windowNumber> <x,y,w,h>" line, falling back to -R with the
    # rect; parse the fields after "SHOOT", not by column: timestamps under
    # 100 s are space-padded ("[  13.504]"), which shifted the columns and is
    # why every capture before step 6 used to fail. (The harness also writes an in-process
    # render-<name>.png of the sidebar, which draws no glass content); wait for
    # "done" (about 2 minutes), kill that pid and the servers.
    git apply -R docs/harness/task192-harness.patch && xcodegen generate

