+extension AppDelegate {
+    @MainActor func runTask1864HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"],
+              let port = ProcessInfo.processInfo.environment["DETOUR_VERIFY_PORT"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var steps: [(TimeInterval, () -> Void)] = []
+        var requestedShots: [String] = []
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) { steps.append((dt, block)) }
+        func runStep(_ index: Int) {
+            guard index < steps.count else { return }
+            let missing = requestedShots.filter { !FileManager.default.fileExists(atPath: "\(outDir)/\($0).png") }
+            let delay = missing.isEmpty ? steps[index].0 : 0.2
+            let timer = Timer(timeInterval: delay, repeats: false) { _ in
+                if missing.isEmpty { steps[index].1(); runStep(index + 1) } else { runStep(index) }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window, let space = wc.activeSpace else { return log("no window/space") }
+        let store = TabStore.shared
+        let appURL = URL(string: "http://localhost:\(port)/app.html")!
+        let apiURL = URL(string: "http://localhost:\(port)/api.html")!
+        var tabs: [String: BrowserTab] = [:]
+
+        WebInspectorToggler.shared.onSettled = { webView, tab, action in
+            let owner = tabs.first { $0.value.webView === webView }?.key ?? "?"
+            log("  settled: pane=\(owner) requested=\(tab.rawValue) action=\(action.map { "\($0)" } ?? "TIMEOUT")")
+        }
+
+        func r(_ rect: NSRect) -> String {
+            String(format: "(%.0f,%.0f %.0fx%.0f)", rect.minX, rect.minY, rect.width, rect.height)
+        }
+        func shoot(_ name: String, _ w: NSWindow?) {
+            requestedShots.append(name)
+            log("SHOOT \(name) \(w?.windowNumber ?? -1)")
+        }
+        func group(_ key: String) -> DevToolbarInspectorGroup? {
+            tabs[key]?.webViewContainer?.devToolbar?.inspectorGroup
+        }
+        /// The inspector of a pane: visible, docked or not, where, and the
+        /// frontend's own selected tab.
+        func state(_ label: String, _ key: String) {
+            guard let tab = tabs[key], let webView = tab.webView, let control = WebInspectorControl(webView: webView) else {
+                return log("\(label) [\(key)]: no inspector")
+            }
+            let frontend = control.frontendWebView
+            let place: String
+            if let frontend {
+                if frontend.superview === tab.webViewContainer {
+                    place = "docked in its own container \(r(frontend.frame)), page \(r(webView.frame)), toolbar \(tab.webViewContainer?.devToolbar.map { r($0.frame) } ?? "none")"
+                } else if frontend.window != nil {
+                    place = "in window '\(frontend.window?.title ?? "")' \(type(of: frontend.window!)) (own window: \(frontend.window !== window))"
+                } else { place = "frontend not in a window" }
+            } else { place = "no frontend web view" }
+            let picker = control.isElementSelectionActive
+            let tint = group(key)?.elementPickerButton?.contentTintColor == .controlAccentColor ? "accent" : "secondary"
+            let base = "\(label) [\(key)]: visible=\(control.isVisible) attached=\(control.isAttached) \(place) picker=\(picker) pickerButton=\(tint) focused=\(wc.selectedTab.flatMap { t in tabs.first { $0.value === t }?.key } ?? "?")"
+            guard frontend != nil else { return log(base + " tab=-") }
+            control.evaluateInFrontend(WebInspectorControl.selectedTabScript) { result in
+                log(base + " tab=\(result.map { "\"\($0)\"" } ?? "err")")
+            }
+        }
+        func press(_ key: String, _ button: KeyPath<DevToolbarInspectorGroup, HoverButton?>, _ name: String) {
+            guard let b = group(key)?[keyPath: button] else { return log("press \(name) [\(key)]: no button") }
+            log("press \(name) [\(key)]")
+            b.performClick(nil)
+        }
+        var eventNumber = 100
+        func post(_ type: NSEvent.EventType, at point: NSPoint) {
+            eventNumber += 1
+            guard let e = NSEvent.mouseEvent(with: type, location: point, modifierFlags: [],
