    #!/bin/zsh
    # run.sh <light|dark>: launches the harness build, serves SHOOT lines from the
    # log with screencapture -l (Detour's own windows only), kills only the
    # launched PID.
    SP=/private/tmp/claude-501/-Users-tma-Projects-browser-MyBrowser/953f551f-71df-4025-b208-16f0ecfa685a/scratchpad/task194/harness
    AP=$1
    APP=/Users/tma/Projects/browser/MyBrowser/.derived/Build/Products/Debug/Detour.app
    LOG=$SP/out/verify-$AP.log
    rm -f -- $LOG
    DETOUR_DATA_DIR=DetourVerify1940 DETOUR_VERIFY_DIR=$SP/out DETOUR_VERIFY_APPEARANCE=$AP \
      DETOUR_VERIFY_DIRECT=${DIRECT:-0} DETOUR_VERIFY_PORT=8794 DETOUR_VERIFY_SERVER_LOG=$SP/out/server.log DETOUR_VERIFY_DOWNLOADS=$SP/downloads \
      "$APP/Contents/MacOS/Detour" > $SP/out/stderr-$AP.log 2>&1 &
    PID=$!
    echo "launched $PID"
    seen=0
    for i in $(seq 1 1200); do
      sleep 0.5
      [ -f $LOG ] || continue
      total=$(wc -l < $LOG)
      if [ $total -gt $seen ]; then
        sed -n "$((seen+1)),${total}p" $LOG | while read -r line; do
          case "$line" in
            *"SHOOT "*) set -- ${=line#*SHOOT }; screencapture -x -o -l $2 $SP/out/$1.png && echo "shot $1";;
          esac
        done
        seen=$total
      fi
      if grep -q "^\[.*\] done" $LOG; then break; fi
      kill -0 $PID 2>/dev/null || { echo "app exited"; break; }
    done
    sleep 1
    kill $PID 2>/dev/null; echo "killed $PID"

