--- server.py (scratch fixture) ---
    # TASK-194 harness fixture: sets a cookie, reports what a page sees, logs the
    # Cookie header of every request. Usage: python3 -I server.py PORT LOGFILE
    import sys
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    
    PORT = int(sys.argv[1])
    LOG = sys.argv[2]
    
    PROBE = """<html><head><script>
    let stored = null; try { stored = localStorage.getItem('qd'); } catch (e) {}
    document.title = 'cookie:' + (document.cookie.includes('qd=') ? 'yes' : 'no') + ' storage:' + (stored ? 'yes' : 'no');
    </script></head><body style="font: 15px -apple-system; padding: 24px">
    <h2>Cookie probe</h2><p id="r"></p><script>document.getElementById('r').textContent = document.title + ' / ' + location.href;</script>
    <p><a id="dl" href="/report.txt" download="report.txt">Download report.txt</a></p>
    <p><a id="tracked" href="/probe?id=1&utm_source=newsletter&utm_medium=email">A tracked link</a></p>
    <p><a id="other" href="http://localhost:%d/probe?other=1">Another site</a></p>
    </body></html>"""
    
    SET = """<html><head><script>
    try { localStorage.setItem('qd', 'quarantined'); } catch (e) {}
    document.title = 'Set';
    </script></head><body style="font: 15px -apple-system; padding: 24px"><h2>Signed in (quarantined)</h2>
    <p>This page set the cookie qd=quarantined and wrote localStorage.</p></body></html>"""
    
    LINKS = """<html><head><title>Links</title></head><body style="font: 15px -apple-system; padding: 24px">
    <h2>Links</h2><p><a id="quarantine-click" href="http://localhost:%d/probe?clicked=1">Open the other site (routed to Quarantine)</a></p>
    </body></html>"""
    
    FP = """<html><head><title>Fingerprint</title><script>
    window.fingerprint = async () => {
      const c = document.createElement('canvas'); c.width = 200; c.height = 50;
      const g = c.getContext('2d'); g.fillStyle = '#f60'; g.fillRect(10,10,100,30);
      g.fillStyle = '#069'; g.font = '14px Helvetica'; g.fillText('quarantine', 2, 15);
      const d = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(c.toDataURL()));
      const hex = Array.from(new Uint8Array(d)).map(b => b.toString(16).padStart(2,'0')).join('').slice(0,16);
      return JSON.stringify({canvas: hex, screen: [screen.width, screen.height], ua: navigator.userAgent});
    };
    </script></head><body>fingerprint</body></html>"""
    
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def do_GET(self):
            with open(LOG, 'a') as f:
                f.write("%s %s cookie=%s\n" % (self.headers.get('Host'), self.path, self.headers.get('Cookie')))
            path = self.path.split('?')[0]
            headers = {'Content-Type': 'text/html; charset=utf-8'}
            status = 200
            if path == '/set':
                body = SET; headers['Set-Cookie'] = 'qd=quarantined; Path=/; Max-Age=3600'
            elif path == '/probe': body = PROBE % PORT
            elif path == '/links': body = LINKS % PORT
            elif path == '/fp': body = FP
            elif path == '/report.txt': body = 'quarantined report\n'; headers['Content-Type'] = 'text/plain'
            elif path == '/redirect':
                status = 302; body = ''; headers['Location'] = 'http://localhost:%d/set' % PORT
            else: status = 404; body = 'not found'
            data = body.encode()
            self.send_response(status)
            for k, v in headers.items(): self.send_header(k, v)
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
    
    ThreadingHTTPServer(('127.0.0.1', PORT), H).serve_forever()

