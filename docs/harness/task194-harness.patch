+                await sleep(1.5)
+                let files = (try? FileManager.default.contentsOfDirectory(atPath: DownloadManager.shared.downloadsDirectory.path)) ?? []
+                let listed = DownloadManager.shared.items.filter { $0.filename == "report.txt" }.map { "\($0.state) scope=\($0.scope)" }
+                log("7 \(answer): files=\(files) listed=\(listed)")
+            }
+
+            // 8. Fingerprinting: the same page in a quarantine and in Home.
+            q2.load(URL(string: base + "/fp")!, typed: false)
+            let fpTab = store.addTab(in: home, url: URL(string: base + "/fp")!)
+            wc.selectTab(id: fpTab.id)
+            _ = await waitFor("fp pages") { q2.tab?.title == "Fingerprint" && fpTab.title == "Fingerprint" && fpTab.isLoading == false && q2.tab?.isLoading == false }
+            let qfp = try? await q2.tab?.webView?.callAsyncJavaScript("return await window.fingerprint()", contentWorld: .page)
+            let nfp = try? await fpTab.webView?.callAsyncJavaScript("return await window.fingerprint()", contentWorld: .page)
+            log("8 fingerprint quarantine=\(String(describing: qfp)) normal=\(String(describing: nfp))")
+
+            // 9. Settings > Links: Quarantine offered and chosen.
+            SettingsWindowController.shared.showLinksPane()
+            await sleep(1.5)
+            await shoot("06-links-pane", SettingsWindowController.shared.window)
+            SettingsWindowController.shared.window?.close()
+
+            // 10. Close: nothing archived, nothing in history.
+            q2.window?.performClose(nil)
+            _ = await waitFor("all quarantines closed") { quarantines().isEmpty }
+            let historyAfter = (try? await HistoryDatabase.shared.dbQueue.read { try Int.fetchOne($0, sql: "SELECT COUNT(*) FROM historyVisit v JOIN historyURL u ON u.id = v.urlID WHERE u.url LIKE '%localhost%'") }) ?? -1
+            log("10 history localhost visits=\(historyAfter) (all before \(historyBefore)) archive \(archiveBefore)->\(store.archiveEntries().count)")
+            let homeCookies = await home.profile!.dataStore.httpCookieStore.allCookies().map(\.name)
+            log("10 Home profile cookies: \(homeCookies)")
+            for id in [mailRoute?.id, clickRoute?.id].compactMap({ $0 }) { routes.removeRoute(id: id) }
+            log("done")
+        }
+    }
+
+    private func appDelegateOpen(_ urls: [URL], app: String) {
+        openExternalURLs(urls, sourceApp: app)
+    }
+}
+
+private func allTexts(_ view: NSView) -> [String] {
+    var out: [String] = []
+    if let field = view as? NSTextField, !field.stringValue.isEmpty { out.append(field.stringValue) }
+    if let button = view as? NSButton, !button.title.isEmpty { out.append("[\(button.title)]") }
+    for sub in view.subviews { out += allTexts(sub) }
+    return out
+}
