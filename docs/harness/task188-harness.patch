+// TEMP TASK-188 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask188HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"],
+              let port = ProcessInfo.processInfo.environment["DETOUR_VERIFY_PORT"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 3.0
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) {
+            clock += dt
+            let timer = Timer(timeInterval: clock, repeats: false) { _ in block() }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window else { return log("no window") }
+        func allSubviews(_ view: NSView) -> [NSView] {
+            view.subviews + view.subviews.flatMap(allSubviews)
+        }
+        let store = TabStore.shared
+        var offTab: BrowserTab?    // 127.0.0.1: the switch turned off
+        var onTab: BrowserTab?     // localhost: no setting
+        var otherTab: BrowserTab?
+        func describe(_ tab: BrowserTab?) -> String {
+            guard let tab else { return "nil" }
+            return "host=\(tab.url?.host ?? "-") playing=\(tab.isPlayingAudio) title=\"\(tab.title)\""
+        }
+        func popoverWindow() -> NSWindow? {
+            NSApp.windows.first { $0.isVisible && String(describing: type(of: $0)).contains("Popover") }
+        }
+        func popoverSwitches() -> [NSSwitch] {
+            guard let content = popoverWindow()?.contentView else { return [] }
+            return allSubviews(content).compactMap { $0 as? NSSwitch }
+        }
+        func showPopover() {
+            wc.tabSidebarDidRequestShowSettings(wc.tabSidebar, sourceButton: wc.tabSidebar.fauxAddressBar)
+        }
+        func closePopover() {
+            popoverWindow()?.orderOut(nil)
+            NSApp.windows.filter { String(describing: type(of: $0)).contains("Popover") }.forEach { $0.close() }
+        }
+        func shoot(_ name: String) {
+            guard let w = popoverWindow() else { return log("SHOOT \(name): no popover") }
+            log("SHOOT \(name) \(window.windowNumber) \(w.windowNumber)")
+        }
+        func override(_ host: String) -> String {
+            let profileID = wc.activeSpace?.profile?.id ?? UUID()
+            return String(describing: SiteSettingsStore.shared.override(.pictureInPicture, forHost: host, profileID: profileID))
+        }
+
+        at(0) {
+            guard let space = wc.activeSpace else { return log("no active space") }
+            offTab = store.addTab(in: space, url: URL(string: "http://127.0.0.1:\(port)/video.html"))
+            onTab = store.addTab(in: space, url: URL(string: "http://localhost:\(port)/video.html"))
+            otherTab = store.addTab(in: space, url: URL(string: "http://127.0.0.1:\(port)/blank.html"))
+            log("seeded")
+        }
+        // Leg 1: no setting — leaving a playing tab enters PiP.
+        at(1.0) { wc.selectTab(id: onTab!.id); log("selected on-tab") }
+        at(4.0) { log("on-tab before leaving: \(describe(onTab))") }
+        at(0.2) { wc.selectTab(id: otherTab!.id); log("left on-tab") }
+        at(2.5) { log("RESULT default site, after leaving: \(describe(onTab))") }
+
+        // Leg 2: the popover, light, then turn 127.0.0.1 off with its switch.
+        at(0.5) { NSApp.appearance = NSAppearance(named: .aqua); wc.selectTab(id: offTab!.id); log("selected off-tab") }
+        at(4.0) {
+            log("off-tab before: \(describe(offTab)) override=\(override("127.0.0.1"))")
+            showPopover()
+        }
+        at(1.0) {
+            let switches = popoverSwitches()
+            log("popover switches=\(switches.count) states=\(switches.map { $0.state == .on }) enabled=\(switches.map(\.isEnabled))")
+            shoot("popover-light-before")
+        }
+        at(2.0) {
+            guard let pip = popoverSwitches().last else { return log("no PiP switch") }
+            pip.performClick(nil)
+            log("clicked PiP switch: state=\(pip.state == .on) override=\(override("127.0.0.1")) sub=\(override("a.127.0.0.1"))")
+            log("db rows: \(AppDatabase.shared.loadSiteSettings().map { "\($0.site) \($0.setting) \($0.value)" })")
+        }
+        at(0.5) { shoot("popover-light-off") }
+        at(2.0) { closePopover() }
+        at(0.5) { wc.selectTab(id: otherTab!.id); log("left off-tab") }
+        at(2.5) { log("RESULT switch off, after leaving: \(describe(offTab))") }
+
+        // Leg 3: dark popover, turn it back on, leave again.
+        at(0.5) { NSApp.appearance = NSAppearance(named: .darkAqua); wc.selectTab(id: offTab!.id); log("back to off-tab") }
+        at(3.0) { log("off-tab: \(describe(offTab))"); showPopover() }
+        at(1.0) { shoot("popover-dark-off") }
+        at(2.0) {
+            guard let pip = popoverSwitches().last else { return log("no PiP switch") }
+            pip.performClick(nil)
+            log("clicked PiP switch: state=\(pip.state == .on) override=\(override("127.0.0.1"))")
+            log("db rows: \(AppDatabase.shared.loadSiteSettings().map { "\($0.site) \($0.setting) \($0.value)" })")
+        }
+        at(0.5) { shoot("popover-dark-on") }
+        at(2.0) { closePopover(); wc.evaluateResetTitle(offTab) }
+        at(0.5) { wc.selectTab(id: otherTab!.id); log("left off-tab (switch on again)") }
+        at(2.5) { log("RESULT switch back on, after leaving: \(describe(offTab))") }
+        at(1.0) { log("done") }
+    }
+}
+
+extension BrowserWindowController {
+    func evaluateResetTitle(_ tab: BrowserTab?) {
+        tab?.webView?.evaluateJavaScript("document.title = 'Video'")
+    }
+}
+#endif
