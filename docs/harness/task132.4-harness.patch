+    func runTallishCheck() async {
+        log("== TASK-150 a document taller than its body, just over 600 pt ==")
+        guard let webView = await openPopup("tttttttttttttttttttttttttttttttt") else { return }
+        log("TALLISH, as presented: \(mode(webView)) \(await metrics(webView))")
+        log("    page: " + (await js(webView, "const b = document.body; return 'body=' + Math.max(b.offsetHeight, b.scrollHeight) + ' document=' + document.documentElement.scrollHeight + ' inner=' + innerHeight;")))
+        var samples: [String] = []
+        for _ in 0..<16 {
+            await sleep(0.25)
+            let height = webView.window.map { Int($0.frame.height) } ?? -1
+            let reach = await js(webView, "window.scrollTo(0, 100); const y = Math.round(scrollY); window.scrollTo(0, 0); return String(y);")
+            samples.append("\(ExtensionPopoverController.isPageScrolling(webView) ? "S" : "-")/\(height)/\(reach)")
+        }
+        log("    mode / popover window height / scrollTo(0,100) every 0.25 s for 4 s: \(samples)")
+        await wheelFromTop(webView, "tallish popup")
+        await scrollIntoView(webView, id: "footer")
+        _ = await js(webView, "window.scrollTo(0, 1000); return '';")
+        await sleep(0.3)
+        log("    scrolled to the bottom: scrollY=\(Int(await scrollY(webView))) footer rect=\(await elementRect(webView, id: "footer") ?? [])")
+        if await clickAndReport(webView, "footer") {
+            log("    after clicking the footer: \(await js(webView, "return document.getElementById('status').textContent;"))")
+        }
+        await snapshot(webView, "tallish-bottom")
+        await closePopup()
+    }
