+    /// Close a popover the way the responder chain does (`performClose:`).
+    func closePopover(of webView: WKWebView) async {
+        // The NSPopover itself: in the responder chain after its content, or
+        // (failing that) behind the popover window's private accessor.
+        var found: NSPopover?
+        var responder: NSResponder? = webView
+        var hops = 0
+        while let current = responder, found == nil, hops < 40 {
+            found = current as? NSPopover
+            responder = current.nextResponder
+            hops += 1
+        }
+        var how = "responder chain"
+        if found == nil, let window = webView.window, window.responds(to: NSSelectorFromString("_popover")) {
+            found = window.value(forKey: "_popover") as? NSPopover
+            how = "popover window's _popover"
+        }
+        guard let popover = found else {
+            log("    close: could not find the NSPopover of the popup"); return
+        }
+        // Without the close animation: with the screen locked it never ends,
+        // and popoverDidClose is only sent when it has.
+        popover.animates = false
+        popover.performClose(nil)
+        await sleep(1.2)
+        log("    closed the popover (performClose: on the NSPopover, found through the \(how), not animated): popup still in a window: \(webView.window != nil); view scrolling mode: \(ExtensionPopoverController.isPageScrolling(webView))")
+    }
+
+    func popover(of webView: WKWebView) -> NSPopover? {
+        var responder: NSResponder? = webView
+        var hops = 0
+        while let current = responder, hops < 40 {
+            if let popover = current as? NSPopover { return popover }
+            responder = current.nextResponder
+            hops += 1
+        }
+        return nil
+    }
+
+    func mode(_ webView: WKWebView) -> String {
+        "scrollingMode=\(ExtensionPopoverController.isPageScrolling(webView)) uiDelegate=\(webView.uiDelegate.map { String(describing: Unmanaged.passUnretained($0 as AnyObject).toOpaque()) } ?? "nil")"
+    }
