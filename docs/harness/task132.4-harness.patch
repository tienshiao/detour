+
+extension AppDelegate {
+    /// Env-gated: `DETOUR_DNR_HARNESS_DIR` (output directory) and
+    /// `DETOUR_DNR_HARNESS_URL` (header-echoing fixture URL).
+    /// `DETOUR_DNR_HARNESS_ACTIVATE=1` activates the app for the clicks and
+    /// re-activates the previously frontmost app afterwards.
+    func runDNRPopupHarnessIfRequested(_ wc: BrowserWindowController) {
+        let env = ProcessInfo.processInfo.environment
+        guard let outDir = env["DETOUR_DNR_HARNESS_DIR"], let fixture = env["DETOUR_DNR_HARNESS_URL"] else { return }
+        let extID = env["DETOUR_DNR_HARNESS_EXT"] ?? "abcdefghijklmnopabcdefghijklmnop"
+        let activate = env["DETOUR_DNR_HARNESS_ACTIVATE"] == "1"
+        Task { @MainActor in
+            let harness = DNRPopupHarness(wc: wc, outDir: URL(fileURLWithPath: outDir), fixture: fixture,
+                                          extID: extID, activate: activate)
+            await harness.run()
+            harness.log("DONE")
+        }
+    }
