+    func run() async {
+        try? FileManager.default.createDirectory(at: outDir, withIntermediateDirectories: true)
+        log("START fixture=\(fixture) ext=\(extID) activate=\(activate) delivery=\(directDelivery ? "direct to the web view" : "posted")")
+        log("    \(focusState(nil))")
+        await sleep(3) // the workers start
+
+        let previousApp = NSWorkspace.shared.frontmostApplication
+        if ProcessInfo.processInfo.environment["DETOUR_DNR_HARNESS_FRONT"] == "1" {
+            // In front of other apps' windows WITHOUT activating: the user's
+            // app stays frontmost and keeps the keyboard.
+            if let screen = NSScreen.main ?? NSScreen.screens.first {
+                let visible = screen.visibleFrame
+                let size = NSSize(width: min(760, visible.width), height: min(740, visible.height))
+                wc.window?.setFrame(NSRect(x: visible.maxX - size.width, y: visible.minY, width: size.width, height: size.height),
+                                    display: true)
+            }
+            wc.window?.orderFrontRegardless()
+            await sleep(0.8)
+            log("ordered the window front regardless, bottom-right corner (no activation, not key): \(wc.window?.frame ?? .zero)")
+        }
+        if activate {
+            NSApp.activate(ignoringOtherApps: true)
+            wc.window?.makeKeyAndOrderFront(nil)
+            await sleep(0.5)
+            log("ACTIVATED the app for the clicks (previous frontmost: \(previousApp?.localizedName ?? "nil"))")
+        }
+        defer {
+            if activate, let previousApp { previousApp.activate(options: []) }
+        }
+
+        if ProcessInfo.processInfo.environment["DETOUR_DNR_HARNESS_SIZING"] != "0" {
+            await runPopupSizingChecks()
+        }
+        if ProcessInfo.processInfo.environment["DETOUR_DNR_HARNESS_REVIEW"] != "0" {
+            await runTallishCheck()
+            await runReclickChecks()
+        }
+        guard ProcessInfo.processInfo.environment["DETOUR_DNR_HARNESS_EXPLORER"] != "0" else { return }
+
+        log("== API Explorer popup ==")
+        guard let webView = await openPopup(extID) else { return }
+        log("popup presented: url=\(webView.url?.absoluteString ?? "nil") windowClass=\(type(of: webView.window!))")
+        log("    \(focusState(webView))")
+        log("TALL (API Explorer), as presented: \(await metrics(webView))")
+        await installMeasureAndObserver(webView)
+        log("TALL (API Explorer), with the resize observer: \(await metrics(webView))")
+        log("sections present: " + (await js(webView, "return Array.from(document.querySelectorAll('h2')).map((h) => h.textContent).filter((t) => /declarative|interim/i.test(t)).join(' | ');")))
+        await snapshot(webView, "popup-top")
+        await wheelFromTop(webView, "API Explorer popup")
+
+        // Before any button: does a click land where it is aimed? Aimed at the
+        // section's heading, which does nothing when clicked.
+        _ = await js(webView, """
+            const heading = Array.from(document.querySelectorAll('h2')).find((h) => /declarative/i.test(h.textContent));
+            heading.id = 'harness-dnr-heading';
+            return '';
+            """)
+        _ = await postClick(webView, id: "harness-dnr-heading")
+        await sleep(0.6)
+        let landed = await js(webView, "return JSON.stringify((window.__harnessClicks || []).slice(-1));")
+        log("mapping check: aimed at the section heading; the page saw \(landed)")
+        guard await clickCount(webView, id: "harness-dnr-heading") > 0 else {
+            log("ABORT: a click does not land on the element it is aimed at; no button was clicked")
+            await closePopup()
+            return
+        }
+
+        await step(webView, "dnr-probe", button: "btn-dnr-probe", result: "res-dnr")
+        log("    \(focusState(webView))")
+
+        await setURL(webView, marker: "before")
+        await step(webView, "dnr-fetch-before", button: "btn-dnr-fetch", result: "res-dnr")
