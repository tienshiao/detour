+            guard let second = await clickToolbarButton(extID) else { return }
+            log("TALL, second click while open: same web view=\(second === first) \(mode(second)) \(await metrics(second))")
+            await wheelFromTop(second, "re-opened popup")
+            // Sample the mode for a while: a late close of the first popover must not flip it.
+            var samples: [String] = []
+            for _ in 0..<8 {
+                await sleep(0.4)
+                samples.append("\(ExtensionPopoverController.isPageScrolling(second) ? "S" : "-")\(await js(second, "window.scrollTo(0, 200); const y = Math.round(scrollY); window.scrollTo(0, 0); return String(y);"))")
+            }
+            log("    mode / scrollTo(0,200) over 3.2 s after the re-click: \(samples)")
+            await scrollIntoView(second, id: "btn-interim-probe")
+            if await clickAndReport(second, "btn-interim-probe") {
+                await sleep(1.0)
+                log("    below-the-fold Probe after the re-click shows \((await js(second, "return document.getElementById('res-interim').textContent;")).count) chars (scrollY \(Int(await scrollY(second))))")
+            }
+            await snapshot(second, "reclick-tall")
+            await closePopover(of: second)
+        }
+
+        log("== TASK-150 re-click on a popup that grew, then fits again ==")
+        let growID = "gggggggggggggggggggggggggggggggg"
+        if let first = await clickToolbarButton(growID) {
+            log("GROW, first click: \(mode(first)) \(await metrics(first))")
+            if await clickAndReport(first, "grow") {
+                await sleep(1.2)
+                log("GROW, grown: \(mode(first)) \(await metrics(first))")
+            }
+            // Second click while the grown popup is open: the page reloads small.
+            guard let second = await clickToolbarButton(growID) else { return }
+            log("GROW, second click while open and grown (page reloaded, fits): same web view=\(second === first) \(mode(second)) \(await metrics(second))")
+            await snapshot(second, "reclick-grow-fits")
+            // Grown again and closed while scrolling: the next opening must fit.
+            if await clickAndReport(second, "grow") {
+                await sleep(1.2)
+                log("GROW, grown again: \(mode(second)) \(await metrics(second))")
+            }
+            await closePopover(of: second)
+            if let third = await clickToolbarButton(growID) {
+                log("GROW, opened again after closing while scrolling: same web view=\(third === second) \(mode(third)) \(await metrics(third))")
+                await snapshot(third, "reopen-grow-fits")
+                await closePopover(of: third)
+            }
+        }
+    }
