+    func runReclickChecks() async {
+        log("== TASK-150 re-click while a tall popup is open ==")
+        if let first = await clickToolbarButton(extID) {
+            log("TALL, first click: \(mode(first)) \(await metrics(first))")
+            await wheelFromTop(first, "first presentation")
