+    /// The controller's measure function and resize observer, installed in the
+    /// document the popup ended up with. The controller installs its own 50 ms
+    /// after `reload()`, and for a small static popup that lands in a document
+    /// the reload then replaces (measured: `__detourMeasureBody` is gone and the
+    /// popover stays 100 x 100) — a separate, older problem. This is the same
+    /// script, so the controller's resize handler is what gets exercised.
+    func installMeasureAndObserver(_ webView: WKWebView) async {
+        let installed = await js(webView, """
+            window.__detourMeasureBody = function() {
+                const body = document.body;
+                if (!body) return {width: 0, height: 0};
+                const doc = document.documentElement;
+                const style = window.getComputedStyle(body);
+                const marginV = parseFloat(style.marginTop) + parseFloat(style.marginBottom);
+                return {
+                    width: Math.ceil(Math.max(body.scrollWidth, doc.scrollWidth)),
+                    height: Math.ceil(Math.max(body.offsetHeight, body.scrollHeight, doc.scrollHeight) + marginV),
+                    contentHeight: Math.ceil(Math.max(body.offsetHeight, body.scrollHeight) + marginV)
+                };
+            };
+            const before = !!window.__detourResizeObserver;
+            if (!before) {
+                const handler = window.webkit.messageHandlers.extensionPopupResize;
+                window.__detourResizeObserver = new ResizeObserver(() => handler.postMessage(window.__detourMeasureBody()));
+                window.__detourResizeObserver.observe(document.body);
+            }
+            return before ? 'the observer the controller installed was already there' : 'installed by the harness (the one the controller installed was lost to the reload)';
+            """)
+        log("    resize observer: \(installed)")
+        await sleep(1.0)
+    }
