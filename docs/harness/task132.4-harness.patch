+    /// Size, mode and scrollability of a presented popup, in one line.
+    func metrics(_ webView: WKWebView) async -> String {
+        let maximum = (webView.value(forKey: "sizeToContentAutoSizeMaximumSize") as? NSValue)?.sizeValue
+        let page = await js(webView, """
+            const d = document.documentElement, b = document.body.getBoundingClientRect();
+            window.scrollTo(0, 300);
+            await new Promise((r) => setTimeout(r, 120));
+            const reached = Math.round(window.scrollY);
+            window.scrollTo(0, 0);
+            return 'inner=' + innerWidth + 'x' + innerHeight + ' docScroll=' + d.scrollWidth + 'x' + d.scrollHeight
+                + ' body=' + Math.round(b.width) + 'x' + Math.round(b.height)
+                + ' classicScrollbarWidth=' + (innerWidth - d.clientWidth)
+                + ' scrollTo(0,300)->' + reached
+                + ' measure=' + (window.__detourMeasureBody ? JSON.stringify(window.__detourMeasureBody()) : 'no-function')
+                + ' resizeObserver=' + (window.__detourResizeObserver ? 'installed' : 'none');
+            """)
+        let popoverSize = webView.window.map { "\(Int($0.frame.width))x\(Int($0.frame.height))" } ?? "nil"
+        return "webView=\(Int(webView.frame.width))x\(Int(webView.frame.height)) popoverWindow=\(popoverSize) "
+            + "sizeToContentMax=\(maximum.map { "\(Int($0.width))x\(Int($0.height))" } ?? "nil") \(page)"
+    }
+
+    /// A wheel event as the pointer over the popup makes it: the event has no
+    /// window, so its location is read as window coordinates of the point given.
+    func wheelOverPopup(_ webView: WKWebView, deltaY: Int32) {
+        guard let cg = CGEvent(scrollWheelEvent2Source: nil, units: .pixel, wheelCount: 1, wheel1: deltaY, wheel2: 0, wheel3: 0) else { return }
+        let inWindow = webView.convert(NSPoint(x: webView.bounds.midX, y: webView.bounds.midY), to: nil)
+        let primaryHeight = NSScreen.screens.first?.frame.height ?? 0
+        cg.location = CGPoint(x: inWindow.x, y: primaryHeight - inWindow.y)
+        guard let event = NSEvent(cgEvent: cg) else { return }
+        webView.scrollWheel(with: event)
+    }
+
+    /// Wheel events from the top of the page: does the page move?
+    func wheelFromTop(_ webView: WKWebView, _ label: String) async {
+        _ = await js(webView, "window.scrollTo(0, 0); return '';")
+        await sleep(0.3)
+        var trace: [Int] = []
+        for _ in 0..<5 {
+            wheelOverPopup(webView, deltaY: -120)
+            await sleep(0.35)
+            trace.append(Int(await scrollY(webView)))
+        }
+        log("    \(label): five wheel events of -120 from the top -> scrollY \(trace)")
+        _ = await js(webView, "window.scrollTo(0, 0); return '';")
+        await sleep(0.2)
+    }
+
+    func clickAndReport(_ webView: WKWebView, _ id: String) async -> Bool {
+        let before = await clickCount(webView, id: id)
+        guard await postClick(webView, id: id) else { return false }
+        var delivered = false
+        for _ in 0..<20 where !delivered {
+            await sleep(0.1)
+            delivered = await clickCount(webView, id: id) > before
+        }
+        log("    click #\(id): trusted click reached the page: \(delivered)")
+        return delivered
+    }
