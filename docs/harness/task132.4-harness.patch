+@MainActor
+private final class DNRPopupHarness {
+    let wc: BrowserWindowController
+    let outDir: URL
+    let fixture: String
+    let extID: String
+    let activate: Bool
+    var popover: ExtensionPopoverController?
+    var eventNumber = 9000
+    let directDelivery = ProcessInfo.processInfo.environment["DETOUR_DNR_HARNESS_DELIVERY"] != "post"
+    var shot = 0
+
+    init(wc: BrowserWindowController, outDir: URL, fixture: String, extID: String, activate: Bool) {
+        self.wc = wc; self.outDir = outDir; self.fixture = fixture; self.extID = extID; self.activate = activate
+    }
+
+    func log(_ line: String) {
+        let url = outDir.appendingPathComponent("harness.log")
+        let data = Data((line + "\n").utf8)
+        if let handle = try? FileHandle(forWritingTo: url) {
+            handle.seekToEndOfFile(); handle.write(data); try? handle.close()
+        } else {
+            try? data.write(to: url)
+        }
+    }
+
+    func sleep(_ seconds: Double) async {
+        try? await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
+    }
+
+    func js(_ webView: WKWebView, _ body: String, _ arguments: [String: Any] = [:]) async -> String {
+        do {
+            let value = try await webView.callAsyncJavaScript(body, arguments: arguments, in: nil, contentWorld: .page)
+            return value.map { "\($0)" } ?? "<nil>"
+        } catch {
+            return "<js error: \(error.localizedDescription)>"
+        }
+    }
+
+    func focusState(_ webView: WKWebView?) -> String {
+        let front = NSWorkspace.shared.frontmostApplication?.localizedName ?? "nil"
+        return "app active=\(NSApp.isActive) frontmost=\(front) mainWindowKey=\(wc.window?.isKeyWindow ?? false) "
+            + "popupWindowKey=\(webView?.window?.isKeyWindow ?? false) popupWindowVisible=\(webView?.window?.isVisible ?? false)"
+    }
+
+    func snapshot(_ webView: WKWebView, _ name: String) async {
+        shot += 1
+        let file = String(format: "%02d-%@.png", shot, name)
+        do {
+            let configuration = WKSnapshotConfiguration()
+            configuration.rect = webView.visibleRect
+            let image = try await webView.takeSnapshot(configuration: configuration)
+            guard let tiff = image.tiffRepresentation, let rep = NSBitmapImageRep(data: tiff),
+                  let png = rep.representation(using: .png, properties: [:]) else {
+                log("    snapshot \(file): could not encode"); return
+            }
+            try png.write(to: outDir.appendingPathComponent(file))
+            log("    snapshot \(file) \(Int(image.size.width))x\(Int(image.size.height))")
+        } catch {
+            log("    snapshot \(file) failed: \(error.localizedDescription)")
+        }
+    }
+
+    /// A real mouse click on an element of the popup: mouse-down and mouse-up
+    /// NSEvents posted to the application queue at the element's centre.
+    func postClick(_ webView: WKWebView, id: String) async -> Bool {
+        await scrollIntoView(webView, id: id)
+        guard let parts = await elementRect(webView, id: id), let window = webView.window else {
+            log("    click \(id): no element rect or no window"); return false
+        }
+        guard webView.bounds.contains(NSPoint(x: parts[0], y: parts[1])) else {
+            log("    click \(id): the button is NOT in the visible part of the popup (centre \(Int(parts[0])),\(Int(parts[1])), visible \(webView.visibleRect))")
+            return false
+        }
+        let point = webView.convert(NSPoint(x: parts[0], y: parts[1]), to: nil)
+        for type in [NSEvent.EventType.leftMouseDown, .leftMouseUp] {
+            eventNumber += 1
+            guard let event = NSEvent.mouseEvent(
+                with: type, location: point, modifierFlags: [], timestamp: ProcessInfo.processInfo.systemUptime,
+                windowNumber: window.windowNumber, context: nil, eventNumber: eventNumber, clickCount: 1,
+                pressure: type == .leftMouseDown ? 1 : 0) else { return false }
+            if directDelivery {
+                // Straight to the web view's own mouse handlers: an inactive
+                // app's event queue does not hand mouse events to its windows.
+                if type == .leftMouseDown { webView.mouseDown(with: event) } else { webView.mouseUp(with: event) }
+            } else {
+                NSApp.postEvent(event, atStart: false)
+            }
+            await sleep(0.06)
+        }
+        log("    click \(id): \(directDelivery ? "delivered to the web view" : "posted") at css (\(Int(parts[0])),\(Int(parts[1]))) size \(Int(parts[2]))x\(Int(parts[3])) -> window \(Int(point.x)),\(Int(point.y))")
+        return true
+    }
+
+    /// Centre x, centre y, width, height of an element, in web view points
+    /// (the visible viewport: y grows downwards from the top of the popup).
+    func elementRect(_ webView: WKWebView, id: String) async -> [Double]? {
+        let rect = await js(webView, """
+            const el = document.getElementById(id);
+            if (!el) return '';
+            const r = el.getBoundingClientRect();
+            return (r.left + r.width / 2) + ',' + (r.top + r.height / 2) + ',' + r.width + ',' + r.height;
+            """, ["id": id])
+        let parts = rect.split(separator: ",").compactMap { Double($0) }
+        return parts.count == 4 ? parts : nil
+    }
+
+    func scrollY(_ webView: WKWebView) async -> Double {
+        Double(await js(webView, "return String(window.scrollY);")) ?? -1
+    }
+
+    /// Bring an element into the visible part of the popup the way a user
+    /// does: scroll-wheel events delivered to the popup's web view.
+    func scrollIntoView(_ webView: WKWebView, id: String) async {
+        let height = Double(webView.bounds.height)
+        var wheels = 0
+        var stuck = 0
+        let start = await scrollY(webView)
+        while wheels < 60 {
+            guard let parts = await elementRect(webView, id: id) else { log("    scroll to \(id): no element"); return }
+            let offset = parts[1] - height / 2          // > 0: the element is below the middle
+            if abs(offset) < 120 { break }
+            let delta = Int32(max(-240, min(240, -offset)))
+            let before = await scrollY(webView)
+            wheelOverPopup(webView, deltaY: delta)
+            wheels += 1
+            // The first wheel of a run is answered a little later than the rest.
+            var moved = false
+            for _ in 0..<8 where !moved {
+                await sleep(0.06)
+                moved = await scrollY(webView) != before
+            }
+            if !moved {
+                // The end of the page, or wheel events do not scroll it; a
+                // first wheel may also just be swallowed, so try a few.
+                stuck += 1
+                if stuck >= 4 { break }
+            } else {
+                stuck = 0
+            }
+        }
+        let end = await scrollY(webView)
+        if let parts = await elementRect(webView, id: id), parts[1] < 0 || parts[1] > height {
+            let scripted = await js(webView, "document.getElementById(id).scrollIntoView({ block: 'center' }); await new Promise((r) => setTimeout(r, 150)); return String(window.scrollY);", ["id": id])
+            log("    scroll to \(id): \(wheels) wheel event(s) moved the page from y=\(Int(start)) to \(Int(end)) but the element is still out of view; FELL BACK to scrollIntoView() -> y=\(scripted)")
+        } else if wheels > 0 {
+            log("    scroll to \(id): \(wheels) wheel event(s) scrolled the page from y=\(Int(start)) to y=\(Int(end))")
+        }
+        await sleep(0.2)
+    }
+
+    func clickCount(_ webView: WKWebView, id: String) async -> Int {
+        Int(await js(webView, "return String((window.__harnessClicks || []).filter((c) => c.id === id && c.trusted).length);",
+                     ["id": id])) ?? -1
+    }
+
+    /// Click a button with real events (again once if the first click only
+    /// woke the window), wait for its result box to settle, log what it shows.
+    func step(_ webView: WKWebView, _ label: String, button: String, result: String, settle: Double = 0.4) async {
+        log("STEP \(label): button #\(button)")
+        let before = await clickCount(webView, id: button)
+        var delivered = false
+        for attempt in 1...3 where !delivered {
+            if attempt == 2, webView.window?.isKeyWindow == false {
+                // Not activation: the app stays in the background, only its
+                // own notion of the key window changes.
+                webView.window?.makeKey()
+                await sleep(0.2)
+                log("    made the popup window key WITHOUT activating the app: \(focusState(webView))")
+            }
+            guard await postClick(webView, id: button) else { break }
+            for _ in 0..<20 where !delivered {
+                await sleep(0.1)
+                delivered = await clickCount(webView, id: button) > before
+            }
+            log("    attempt \(attempt): trusted click event reached the page: \(delivered); last click seen: " + (await js(webView, "return JSON.stringify((window.__harnessClicks || []).slice(-1));")))
+        }
+        guard delivered else { log("    FAILED: the click never reached the page. \(focusState(webView))"); return }
+        // The result box settles when its text stops changing.
+        var last = ""
+        var stable = 0
+        let start = Date()
+        while stable < 3 && Date().timeIntervalSince(start) < 15 {
+            await sleep(0.25)
+            let text = await js(webView, "const el = document.getElementById(id); return el.classList.contains('visible') ? (el.classList.contains('error') ? '[ERROR STYLE] ' : '') + el.textContent : '';", ["id": result])
+            if text == last && !text.isEmpty { stable += 1 } else { stable = 0; last = text }
+        }
+        await sleep(settle)
+        log("    popup shows in #\(result) (\(last.count) chars):")
+        for line in last.split(separator: "\n", omittingEmptySubsequences: false) { log("      | \(line)") }
+        await scrollIntoView(webView, id: result)
+        await snapshot(webView, label)
+    }
+
+    func setURL(_ webView: WKWebView, marker: String) async {
+        let url = fixture + "?step=" + marker
+        _ = await js(webView, """
+            const input = document.getElementById('input-dnr-url');
+            input.value = url;
+            input.dispatchEvent(new Event('input', { bubbles: true }));
+            return '';
+            """, ["url": url])
+        log("    URL field set (by script) to \(url)")
+    }
