+            window.__harnessClicks = [];
+            document.addEventListener('click', (e) => {
+                window.__harnessClicks.push({ id: e.target && e.target.id, trusted: e.isTrusted });
+            }, true);
+            return '';
+            """)
+        return webView
+    }
