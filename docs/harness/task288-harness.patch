+// TEMP TASK-288 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask288HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 3.0
+        func at(_ dt: TimeInterval, _ block: @escaping @MainActor @Sendable () -> Void) {
+            clock += dt
+            Timer.scheduledMainTimer(withTimeInterval: clock, repeats: false) { _ in block() }
+        }
+        func entries() -> String {
+            SiteSearchStore.shared.entries.map { "\($0.name)|\($0.keyword)|\($0.urlTemplate)|d=\($0.isDiscovered)" }
+                .joined(separator: "; ")
+        }
+        let site = URL(string: "http://127.0.0.1:8288/")!
+        at(0) {
+            log("start: \(entries())")
+            guard let space = wc.activeSpace else { return log("no space") }
+            let tab = TabStore.shared.addTab(in: space)
+            wc.selectTab(id: tab.id)
+            tab.load(site)
+            log("normal tab loading \(site)")
+        }
+        at(4) { log("after first load: \(entries())") }
+        at(0.5) {
+            wc.selectedTab?.load(URL(string: "http://127.0.0.1:8288/search/?q=x")!)
+            log("normal tab: second page")
+        }
+        at(3) { log("after second page: \(entries())") }
+        at(0.5) {
+            self.createNewIncognitoWindow()
+            guard let pwc = NSApp.windows.compactMap({ $0.windowController as? BrowserWindowController })
+                .first(where: { $0.isIncognito }), let space = pwc.activeSpace else { return log("no private wc") }
+            let tab = TabStore.shared.addTab(in: space)
+            pwc.selectTab(id: tab.id)
+            tab.load(URL(string: "http://localhost:8288/")!)
+            log("private tab loading http://localhost:8288/ (space incognito=\(space.isIncognito))")
+        }
+        at(4) { log("after private load: \(entries())") }
+        at(0.5) {
+            let settings = SettingsWindowController.shared
+            settings.showWindow(nil)
+            if let item = settings.window?.toolbar?.items.first(where: { $0.itemIdentifier.rawValue == "search" }) {
+                settings.perform(Selector(("selectPane:")), with: item)
+            }
+            NSApp.activate(ignoringOtherApps: true)
+            settings.window?.makeKeyAndOrderFront(nil)
+            log("settings shown")
+        }
+        at(2) { log("SHOOT \(SettingsWindowController.shared.window?.windowNumber ?? -1) settings") }
+        at(3) { log("done") }
+    }
+}
+#endif
