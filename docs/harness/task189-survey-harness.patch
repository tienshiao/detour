--- /dev/null
+++ b/.task189/watch.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# Usage: watch.sh OUTDIR — shoots each "SHOOT <name> <windowNumber>" line of OUTDIR/verify.log
+OUT="$1"; LOG="$OUT/verify.log"
+LOCK=${LOCK_CHECK:-true}   # optional screen-lock probe that prints locked=...
+n=0
+for i in $(seq 1 3000); do
+  if [ -f "$LOG" ]; then
+    total=$(wc -l < "$LOG" | tr -d ' ')
+    if [ "$total" -gt "$n" ]; then
+      sed -n "$((n+1)),${total}p" "$LOG" > "$OUT/.new"
+      n=$total
+      while read -r line; do
+        case "$line" in
+          *"SHOOT "*)
+            rest=${line#*SHOOT }; name=${rest% *}; wn=${rest##* }
+            lk=$($LOCK)
+            screencapture -x -o -l "$wn" "$OUT/$name.png"
+            echo "$name wn=$wn $lk" >> "$OUT/shots.txt" ;;
+          *"] done"*) echo finished; exit 0 ;;
+        esac
+      done < "$OUT/.new"
+    fi
+  fi
+  sleep 0.2
+done
+echo timeout
