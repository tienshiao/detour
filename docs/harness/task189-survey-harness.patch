+order = {
+ "general": ["general"],
+ "spaces": ["spaces-default", "spaces-long", "spaces-many", "spaces-many-dragged", "spaces-capped"],
+ "profiles": ["profiles-normal", "profiles-private", "profiles-customUA-warning", "profiles-externalApps-several",
+              "profiles-extensions", "profiles-everything", "profiles-everything-scrolled", "profiles-private-extensions",
+              "profiles-capped", "profiles-capped-scrolled"],
+ "extensions": ["extensions-none", "extensions-only-tall", "extensions-uninstalled", "extensions-one", "extensions-big", "extensions-pending", "extensions-many",
