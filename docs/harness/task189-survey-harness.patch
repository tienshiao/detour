+            }
+        }
+        at(0.5) {
+            guard let home = homeScreen, shortScreen() != nil else { return }
+            sw().setFrameTopLeftPoint(NSPoint(x: home.visibleFrame.midX - 370, y: home.visibleFrame.maxY - 60))
+        }
+        at(1.5) { log("SCREEN back-home screen=\(sw().screen?.localizedName ?? "?") window=\(rect(sw().frame)) content=\(contentHeight()) max=\(sw().contentMaxSize.height)") }
+        at(0.5) { showPane("general") }
+        at(0.5) { log("done") }
+        runStep(0)
+    }
