+        /// Logs the window's height (from the window server, on a background
+        /// thread, since an animated setFrame blocks the main thread) every
+        /// 10 ms while `block` runs a pane switch.
+        func sampleSwitch(_ label: String, _ block: @escaping () -> Void) {
+            let windowID = CGWindowID(sw().windowNumber)
+            let lock = NSLock()
+            var samples: [String] = []
+            var running = true
+            let t0 = ProcessInfo.processInfo.systemUptime
+            DispatchQueue.global(qos: .userInteractive).async {
+                while true {
+                    lock.lock(); let go = running; lock.unlock()
+                    if !go { break }
+                    if let info = CGWindowListCopyWindowInfo([.optionIncludingWindow], windowID) as? [[String: Any]],
+                       let b = info.first?[kCGWindowBounds as String] as? [String: Any], let h = b["Height"] as? Double,
+                       let y = b["Y"] as? Double {
+                        let line = String(format: "%.0f(top %.0f)@%.0fms", h, y, (ProcessInfo.processInfo.systemUptime - t0) * 1000)
+                        lock.lock(); if samples.last?.hasPrefix(String(format: "%.0f(", h)) != true { samples.append(line) }; lock.unlock()
+                    }
+                    usleep(10_000)
+                }
+            }
+            let before = sw().frame
+            // Who resizes the window during the switch (debugging snaps).
+            let resizeObserver = NotificationCenter.default.addObserver(forName: NSWindow.didResizeNotification, object: sw(), queue: nil) { _ in
+                let stack = Thread.callStackSymbols.dropFirst(1).prefix(40)
+                    .filter { $0.contains("Detour") && !$0.contains("Task189") }
+                    .map { $0.split(separator: " ").dropFirst(3).prefix(1).joined() }
+                log("RESIZE \(label) h=\(sw().frame.height) via=\(stack.prefix(6).joined(separator: " < "))")
+            }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) { NotificationCenter.default.removeObserver(resizeObserver) }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) {
+                block()
+                let after = sw().frame
+                let elapsed = (ProcessInfo.processInfo.systemUptime - t0) * 1000
+                DispatchQueue.main.asyncAfter(deadline: .now() + 0.9) {
+                    lock.lock(); running = false; let list = samples; lock.unlock()
+                    log("SWITCH \(label) before=\(rect(before)) after=\(rect(sw().frame)) atReturn=\(rect(after)) returnedAt=\(Int(elapsed))ms topKept=\(abs(before.maxY - after.maxY) < 0.5) distinctHeights=\(list.count) samples=\(list.joined(separator: " "))")
+                }
+            }
+        }
+        func postMouse(_ type: NSEvent.EventType, _ p: NSPoint) {
+            guard let e = NSEvent.mouseEvent(with: type, location: p, modifierFlags: [],
+                                             timestamp: ProcessInfo.processInfo.systemUptime,
+                                             windowNumber: sw().windowNumber, context: nil, eventNumber: 0,
+                                             clickCount: 1, pressure: type == .leftMouseUp ? 0 : 1) else { return }
+            NSApp.postEvent(e, atStart: false)
+        }
+        /// Drags from `start` (window coordinates) by (dx, dy) in 10 steps.
+        func drag(_ label: String, from start: NSPoint, dx: CGFloat, dy: CGFloat) {
+            let before = sw().frame
+            postMouse(.leftMouseDown, start)
+            for i in 1...10 {
+                postMouse(.leftMouseDragged, NSPoint(x: start.x + dx * CGFloat(i) / 10, y: start.y + dy * CGFloat(i) / 10))
+            }
+            postMouse(.leftMouseUp, NSPoint(x: start.x + dx, y: start.y + dy))
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) {
+                let after = sw().frame
+                log("DRAG \(label) by=(\(dx),\(dy)) before=\(rect(before)) after=\(rect(after)) content=\(contentHeight()) min=\(sw().contentMinSize) max=\(sw().contentMaxSize)")
+            }
+        }
+
+        if ProcessInfo.processInfo.environment["TASK189_SWITCH_ONLY"] != nil {
+            steps = Array(steps.prefix(2))  // launch + open Settings only
+        }
+        // Pane switches re-fit and animate, keeping the top edge.
+        at(0.5) { showPane("general") }
+        at(1.0) { sampleSwitch("general->profiles") { showPane("profiles") } }
+        at(1.0) { sampleSwitch("profiles->contentblocker") { showPane("contentblocker") } }
+        at(1.0) { sampleSwitch("contentblocker->spaces") { showPane("spaces") } }
+        if ProcessInfo.processInfo.environment["TASK189_SWITCH_ONLY"] != nil {
+            at(1.0) { sampleSwitch("spaces->general") { showPane("general") } }
+            at(1.0) { sampleSwitch("general->extensions") { showPane("extensions") } }
+            at(1.0) { sampleSwitch("extensions->general") { showPane("general") } }
+            at(1.0) { sampleSwitch("general->contentblocker") { showPane("contentblocker") } }
+            at(1.0) { sampleSwitch("contentblocker->extensions") { showPane("extensions") } }
