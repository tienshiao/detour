+#!/usr/bin/env python3
+"""TASK-189 survey: read the harness's per-state JSON dumps and list clips,
+truncations, overlaps and gaps (window coordinates, origin bottom-left)."""
+import json, sys, glob, os
+
+CONTAINERS = {"NSView", "NSStackView", "NSGridView", "NSClipView", "FlippedView", "FlippedClipView",
+              "NSTableRowView", "NSTableCellView", "_NSKeyboardFocusClipView", "NSTableBackgroundView",
+              "TintedBannerView", "_NSBoxCustomView", "SettingsGroupBoxView", "SettingsListContainerView"}
+SKIP = {"NSScroller", "_NSScrollViewContentBackgroundView", "NSTableHeaderView", "_NSCornerView",
+        "NSScrollerImpPairView", "_NSSplitViewSpanningAccessoryHostingView"}
+
+
+def r2(r):
+    return {"x": r[0], "y": r[1], "w": r[2], "h": r[3], "maxX": r[0] + r[2], "maxY": r[1] + r[3]}
+
+
+def inter(a, b):
+    w = min(a["maxX"], b["maxX"]) - max(a["x"], b["x"])
+    h = min(a["maxY"], b["maxY"]) - max(a["y"], b["y"])
+    return (w, h) if w > 0 and h > 0 else (0, 0)
+
+
+def label(n):
+    t = n.get("text")
+    t = "" if t is None else (t[:38] + "…" if len(t) > 40 else t)
+    return f'{n["cls"]}#{n["id"]}"{t}"'
+
+
+def analyze(path):
+    d = json.load(open(path))
+    nodes = {n["id"]: n for n in d["nodes"]}
+    for n in nodes.values():
+        n["F"] = r2(n["frame"]); n["V"] = r2(n["visible"]); n["A"] = r2(n.get("align", n["frame"]))
+    children = {}
+    for n in nodes.values():
+        children.setdefault(n["parent"], []).append(n["id"])
+
+    def ancestors(n):
+        out = []
+        p = n["parent"]
+        while p != -1:
+            out.append(nodes[p]); p = nodes[p]["parent"]
+        return out
+
+    def in_skip(n):
+        return any(a["cls"] in SKIP for a in ancestors(n)) or n["cls"] in SKIP
+
+    content = r2(d["contentFrame"])
+    # visibleRect is not usable (macOS 14+ views do not clip by default, so it can
+    # extend past the bounds): clip each frame by its clip-view ancestors and the content.
+    CLIPPERS = ("NSClipView", "FlippedClipView", "_NSKeyboardFocusClipView")
+    def isect(a, b):
+        x, y = max(a["x"], b["x"]), max(a["y"], b["y"])
+        mx, my = min(a["maxX"], b["maxX"]), min(a["maxY"], b["maxY"])
+        return {"x": x, "y": y, "maxX": max(x, mx), "maxY": max(y, my), "w": max(0, mx - x), "h": max(0, my - y)}
+    for n in nodes.values():
+        v = isect(n["F"], content)
+        p = n["parent"]
+        while p != -1:
+            if nodes[p]["cls"] in CLIPPERS:
+                v = isect(v, nodes[p]["F"])
+            p = nodes[p]["parent"]
+        n["V"] = v
+    out = []
+    P = lambda s: out.append(s)
+    P(f'== {d["name"]}  pane={d["pane"]} preferred={d["preferred"]} window={d["windowFrame"]} content={d["contentFrame"]}')
+    if "natural" in d:
+        P(f'  FIT natural={d["natural"]} paneMinimum={d["paneMinimum"]} contentMin={d["contentMinSize"]} contentMax={d["contentMaxSize"]} screenOverride={d["screenOverride"]}')
+    defects = []
+    leaves = [n for n in nodes.values() if n["cls"] not in CONTAINERS and not in_skip(n)
+              and n["cls"] not in ("NSScrollView",) and n["parent"] != -1]
+    # Rows of tables are measured separately; only label text inside table cells is checked for truncation.
+    def in_table(n):
+        return any(a["cls"] == "NSTableView" for a in ancestors(n))
+    def clip_ancestor(n):
+        for a in ancestors(n):
+            if a["cls"] in ("NSClipView", "FlippedClipView", "_NSKeyboardFocusClipView"):
+                return a
+        return None
+
+    # 1. Clipping: visible smaller than frame.
+    for n in leaves:
+        F = n["A"] if n["cls"] in ("NSTextField", "NSButton", "NSPopUpButton", "NSSwitch") else n["F"]
+        V = isect(F, n["V"]) if False else n["V"]
+        # visible part of the alignment rect
+        V = {"w": max(0, min(F["maxX"], n["V"]["maxX"]) - max(F["x"], n["V"]["x"]) if n["V"]["w"] > 0 else 0),
+             "h": max(0, min(F["maxY"], n["V"]["maxY"]) - max(F["y"], n["V"]["y"]) if n["V"]["h"] > 0 else 0)}
+        if n["cls"] == "NSTableView":
+            continue
+        dw, dh = F["w"] - V["w"], F["h"] - V["h"]
+        if dw > 0.5 or dh > 0.5:
+            ca = clip_ancestor(n)
+            if in_table(n) and dw <= 0.5:
+                continue  # a table row scrolled out of view
+            kind = "HCLIP" if dw > 0.5 else "VCLIP"
+            where = "inside scroll view" if ca else "hard (no scroll view)"
+            if ca and kind == "VCLIP":
+                # vertical clip inside a vertically scrolling view: reachable by scrolling
+                sv = nodes[ca["parent"]] if ca["parent"] in nodes else None
+                where = "scrolls (vertical scroll view)" + ("" if sv and sv.get("scrollerShown") else " - scroller NOT shown")
+            defects.append(f'{kind} {label(n)} frame={n["frame"]} visible={[round(v,1) for v in n["visible"]]} cut w={dw:.1f} h={dh:.1f} [{where}]')
+        # outside window content entirely?
+        if F["x"] < content["x"] - 0.5 or F["maxX"] > content["maxX"] + 0.5 or F["y"] < content["y"] - 0.5 or F["maxY"] > content["maxY"] + 0.5:
+            if not clip_ancestor(n):
+                defects.append(f'OUTSIDE-CONTENT {label(n)} frame={n["frame"]}')
+
+    # 1b. A child that extends past its (non-scrolling) parent's frame.
+    for n in nodes.values():
+        if n["parent"] in (-1,) or in_skip(n):
+            continue
+        par = nodes[n["parent"]]
+        if par["cls"] in CLIPPERS or par["cls"] in ("NSScrollView", "NSTableView", "NSTableRowView"):
+            continue
+        F, PF = n["A"], par["F"]
+        over = [F["x"] < PF["x"] - 0.5 and f'left {PF["x"]-F["x"]:.1f}', F["maxX"] > PF["maxX"] + 0.5 and f'right {F["maxX"]-PF["maxX"]:.1f}',
+                F["y"] < PF["y"] - 0.5 and f'bottom {PF["y"]-F["y"]:.1f}', F["maxY"] > PF["maxY"] + 0.5 and f'top {F["maxY"]-PF["maxY"]:.1f}']
+        over = [o for o in over if o]
+        if over and n["cls"] != "_NSBoxSeparatorView":
+            defects.append(f'PAST-PARENT {label(n)} beyond {label(par)}: {", ".join(over)}')
+
+    # 2. Text that does not fit its frame.
+    for n in nodes.values():
+        if n["cls"] != "NSTextField" or in_skip(n) or n.get("editable"):
+            continue
+        F = n["F"]
+        if n.get("wraps"):
+            if n.get("needHeight", 0) > F["h"] + 0.5:
+                defects.append(f'TEXT-VCUT {label(n)} needs h={n["needHeight"]:.1f} has {F["h"]:.1f}')
+        else:
+            nw = n.get("needWidth", 0)
+            if nw > F["w"] + 0.5 and n.get("text"):
+                mode = {0: "wordWrap", 1: "charWrap", 2: "clipping", 3: "truncHead", 4: "truncTail", 5: "truncMiddle"}.get(n.get("lineBreak"), n.get("lineBreak"))
+                defects.append(f'TEXT-TRUNC({mode}) {label(n)} needs w={nw:.1f} has {F["w"]:.1f}{" (table cell)" if in_table(n) else ""}')
+    for n in leaves:
+        if n["cls"] in ("NSPopUpButton", "NSButton") and n["intrinsic"][0] > 0 and n["intrinsic"][0] > n["F"]["w"] + 0.5:
+            defects.append(f'SQUEEZED {label(n)} intrinsic w={n["intrinsic"][0]:.1f} frame w={n["F"]["w"]:.1f}')
+
+    # 3. Overlaps between on-screen leaves (not ancestor/descendant).
+    vis = [n for n in leaves if n["V"]["w"] > 0.5 and n["V"]["h"] > 0.5 and n["cls"] != "NSTableView"]
+    for i, a in enumerate(vis):
+        anc_a = {x["id"] for x in ancestors(a)}
+        for b in vis[i + 1:]:
+            if b["id"] in anc_a or a["id"] in {x["id"] for x in ancestors(b)}:
+                continue
+            w, h = inter(a["V"] if a["cls"] == "NSBox" else r2_align_vis(a), b["V"] if b["cls"] == "NSBox" else r2_align_vis(b))
+            if w > 1 and h > 1:
+                defects.append(f'OVERLAP {label(a)} x {label(b)} by {w:.1f}x{h:.1f}')
+
+    # 4. Scroll views: overflow.
+    for n in nodes.values():
+        if n["cls"] != "NSScrollView" or in_skip(n):
+            continue
+        doc, clip = n.get("docFrame") or [0, 0, 0, 0], n["clipBounds"]
+        ov_h = doc[3] - clip[3]; ov_w = doc[2] - clip[2]
+        inner = [nodes[c]["cls"] for c in children.get(n["id"], [])]
+        desc = f'SCROLL {label(n)} frame={[round(v) for v in n["frame"]]} doc={[round(v) for v in doc]} clip={[round(v) for v in clip]} scroller={n.get("scrollerShown")}'
+        if ov_h > 0.5: desc += f' OVERFLOW-V {ov_h:.0f}'
+        if ov_w > 0.5: desc += f' OVERFLOW-H {ov_w:.0f} (no horizontal scroller)'
+        P("  " + desc)
+
+    # 5. Gaps: vertical stacks and grids.
+    for n in nodes.values():
+        if in_skip(n):
+            continue
+        if n["cls"] == "NSStackView" and n.get("orientation") == "v":
+            par = nodes.get(n["parent"])
+            if par:
+                for sib in children.get(par["id"], []):
+                    if nodes[sib]["cls"] == "SettingsListContainerView":
+                        P(f'  COLUMN #{n["id"]} top vs list top: {nodes[sib]["F"]["maxY"] - n["F"]["maxY"]:+.1f} (+ = column starts lower)')
+            arr = [nodes[i] for i in n.get("arranged", [])]
+            if len(arr) < 2:
+                continue
+            gaps = []
+            for a, b in zip(arr, arr[1:]):
+                gaps.append(f'{a["A"]["y"] - b["A"]["maxY"]:.1f}')
+            top = n["F"]["maxY"] - arr[0]["A"]["maxY"]; bot = arr[-1]["A"]["y"] - n["F"]["y"]
+            P(f'  VSTACK #{n["id"]} spacing={n["spacing"]} insets={n["insets"]} n={len(arr)} first="{label(arr[0])}" gaps={gaps} top={top:.1f} bottom={bot:.1f}')
+        if n["cls"] == "NSGridView" and "grid" in n:
+            rows = []
+            for ri, row in enumerate(n["grid"]["rows"]):
+                if row["hidden"]:
+                    continue
+                cells = [nodes[c] for c in row["cells"] if c in nodes]
+                slots = [nodes.get(c) for c in row["cells"]]
+                if not cells:
+                    continue
+                top = max(c["A"]["maxY"] for c in cells); bottom = min(c["A"]["y"] for c in cells)
+                lab = next((c.get("text") for c in cells if c.get("text")), "")
+                rows.append((ri, top, bottom, lab, slots))
+            gaps = [f'{a[2] - b[1]:.1f}' for a, b in zip(rows, rows[1:])]
+            col0 = [cs[0] for _, _, _, _, cs in rows if cs and cs[0] is not None]
+            col0w = max((c["F"]["w"] for c in col0), default=0)
+            col1x = min((cs[1]["A"]["x"] for _, _, _, _, cs in rows if len(cs) > 1 and cs[1] is not None), default=0)
+            col0x = min((c["A"]["x"] for c in col0), default=0)
+            P(f'  GRID #{n["id"]} rowSpacing={n["grid"]["rowSpacing"]} colSpacing={n["grid"]["columnSpacing"]} col0 width={col0w:.1f} col0 x={col0x:.1f} col1 x(window)={col1x:.1f} frame={[round(v) for v in n["frame"]]}')
+            P('    rows: ' + "; ".join(f'r{ri} "{(lab or "")[:18]}" h={t-b:.1f}' for ri, t, b, lab, _ in rows))
+            # Label vs control: centre offset and first-baseline offset (label minus control, + = label higher).
+            offs = []
+            for ri, _, _, lab, cs in rows:
+                if len(cs) > 1 and cs[0] is not None and cs[1] is not None and cs[0].get("text"):
+                    a, b = cs[0], cs[1]
+                    dc = (a["A"]["y"] + a["A"]["h"] / 2) - (b["A"]["y"] + b["A"]["h"] / 2)
+                    db = (a["baseline"] - b["baseline"]) if "baseline" in a and "baseline" in b else None
+                    offs.append(f'r{ri} centre={dc:+.1f} baseline={"n/a" if db is None else f"{db:+.1f}"}')
+            P('    label-vs-control: ' + "; ".join(offs))
+            # Detail column top vs a sibling list container's top.
+            par = nodes.get(n["parent"])
+            if par:
+                for sib in children.get(par["id"], []):
+                    sn = nodes[sib]
+                    if sn["cls"] in ("SettingsListContainerView",) or (sn["cls"] == "NSView" and sn["F"]["w"] == 220):
+                        P(f'    grid top vs list top: {sn["F"]["maxY"] - n["F"]["maxY"]:+.1f} (+ = grid starts lower)')
+            P(f'    gaps: {gaps}')
+
+    # 6. Pane margins from the on-screen leaves.
+    onscreen = [n for n in vis if not in_table(n)]
+    if onscreen:
+        left = min(n["V"]["x"] for n in onscreen) - content["x"]
+        right = content["maxX"] - max(n["V"]["maxX"] for n in onscreen)
+        top = content["maxY"] - max(n["V"]["maxY"] for n in onscreen)
+        bottom = min(n["V"]["y"] for n in onscreen) - content["y"]
+        P(f'  MARGINS (visible leaves) left={left:.1f} right={right:.1f} top={top:.1f} bottom={bottom:.1f}')
+    tops = [nodes[c] for c in children.get(0, [])]
+    P('  TOP-LEVEL: ' + "; ".join(f'{label(t)} {[round(v) for v in t["frame"]]}' for t in tops))
+    amb = [label(n) for n in nodes.values() if n.get("ambiguous")]
+    if amb:
+        defects.append("AMBIGUOUS " + ", ".join(amb[:10]))
+    for x in defects:
+        P("  ! " + x)
+    return "\n".join(out), defects
+
+
+def r2_align_vis(n):
+    # alignment rect, intersected with the visible rect
+    A, V = n["A"], n["V"]
+    x, y = max(A["x"], V["x"]), max(A["y"], V["y"])
+    mx, my = min(A["maxX"], V["maxX"]), min(A["maxY"], V["maxY"])
+    return {"x": x, "y": y, "maxX": mx, "maxY": my, "w": mx - x, "h": my - y}
+
+
+if __name__ == "__main__":
+    d = sys.argv[1]
+    files = sorted(glob.glob(os.path.join(d, "*.json")), key=os.path.getmtime)
+    for f in files:
+        text, _ = analyze(f)
+        print(text)
+        print()
