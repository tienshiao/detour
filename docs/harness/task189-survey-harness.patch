+++ b/.task189/borders.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""TASK-189 defect 9: sample each list container's left border pixel against the
+pane background just outside it, in every capture of DIR (light and dark).
+Usage: borders.py DIR"""
+import json, glob, os, subprocess, sys
+
+d = sys.argv[1]
+
+
+def pixel(png, x, y):
+    out = subprocess.check_output(["magick", png, "-format", f"%[fx:int(255*p{{{x},{y}}}.r)],%[fx:int(255*p{{{x},{y}}}.g)],%[fx:int(255*p{{{x},{y}}}.b)]", "info:"])
+    return tuple(int(v) for v in out.decode().split(","))
+
+
+for path in sorted(glob.glob(os.path.join(d, "*.json"))):
+    png = path[:-5] + ".png"
+    if not os.path.exists(png):
+        continue
+    meta = json.load(open(path))
+    win_h = meta["windowFrame"][3]
+    scale = int(subprocess.check_output(["magick", "identify", "-format", "%w", png]).decode()) / meta["windowFrame"][2]
+    for n in meta["nodes"]:
+        f = n["frame"]
+        is_list = n["cls"] in ("SettingsListContainerView", "SettingsGroupBoxView") or (n["cls"] == "NSView" and abs(f[2] - 220) < 0.5 and f[3] > 100)
+        if not is_list:
+            continue
+        y = int((win_h - (f[1] + f[3] / 2)) * scale)
+        border = pixel(png, int(f[0] * scale), y)
+        outside = pixel(png, int((f[0] - 4) * scale), y)
+        contrast = max(abs(a - b) for a, b in zip(border, outside))
+        print(f'{os.path.basename(path)[:-5]:40s} {n["cls"]:26s} border={border} outside={outside} max-channel-diff={contrast}')
