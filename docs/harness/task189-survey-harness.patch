+++ b/Detour/App/Task189Harness.swift
@@ -0,0 +1,592 @@
+// TEMP TASK-189 Settings layout survey harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    func runTask189HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        // Steps run in order; each waits until every capture requested so far
+        // exists, so a slow watcher cannot shoot a later state.
+        var steps: [(TimeInterval, () -> Void)] = []
+        var requestedShots: [String] = []
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) { steps.append((dt, block)) }
+        func runStep(_ index: Int) {
+            guard index < steps.count else { return }
+            let missing = requestedShots.filter { !FileManager.default.fileExists(atPath: "\(outDir)/\($0).png") }
+            let delay = missing.isEmpty ? steps[index].0 : 0.2
+            let timer = Timer(timeInterval: delay, repeats: false) { _ in
+                if missing.isEmpty { steps[index].1(); runStep(index + 1) } else { runStep(index) }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        func allSubviews(_ view: NSView) -> [NSView] {
+            view.subviews + view.subviews.flatMap(allSubviews)
+        }
+        let settings = SettingsWindowController.shared
+        let store = TabStore.shared
+        func sw() -> NSWindow { settings.window! }
+
+        // MARK: Measurement
+
+        func rect(_ r: NSRect) -> [Double] { [Double(r.minX), Double(r.minY), Double(r.width), Double(r.height)] }
+        func text(of view: NSView) -> String? {
+            if let p = view as? NSPopUpButton { return p.titleOfSelectedItem }
+            if let b = view as? NSButton { return b.title.isEmpty ? (b.image?.accessibilityDescription ?? "") : b.title }
+            if let t = view as? NSTextField { return t.stringValue }
+            if let b = view as? NSBox { return b.boxType == .separator ? "<separator>" : "<box>" }
+            return nil
+        }
+        func shouldDescend(_ view: NSView) -> Bool {
+            if view is NSTableView || view is NSScrollView || view is NSClipView { return true }
+            if view is NSControl || view is NSScroller || view is NSTableHeaderView { return false }
+            return true
+        }
+        func dumpPane(_ name: String) {
+            let window = sw()
+            guard let content = window.contentView else { return log("\(name): no content view") }
+            window.layoutIfNeeded()
+            var ids: [ObjectIdentifier: Int] = [:]
+            var nodes: [[String: Any]] = []
+            var queue: [(NSView, Int)] = [(content, -1)]
+            var visited: [NSView] = []
+            while !queue.isEmpty {
+                let (view, parent) = queue.removeFirst()
+                if view.isHidden { continue }
+                let id = nodes.count
+                ids[ObjectIdentifier(view)] = id
+                visited.append(view)
+                var node: [String: Any] = [
+                    "id": id, "parent": parent, "cls": "\(type(of: view))",
+                    "frame": rect(view.convert(view.bounds, to: nil)),
+                    "visible": rect(view.convert(view.visibleRect, to: nil)),
+                    "ambiguous": view.hasAmbiguousLayout,
+                ]
+                if let sv = view.superview {
+                    let align = sv.convert(view.alignmentRect(forFrame: view.frame), to: nil)
+                    node["align"] = rect(align)
+                    // First baseline in window coordinates (alignment-rect top minus the offset).
+                    if view is NSControl {
+                        node["baseline"] = Double(align.maxY - view.firstBaselineOffsetFromTop)
+                    }
+                }
+                let ics = view.intrinsicContentSize
+                node["intrinsic"] = [Double(ics.width), Double(ics.height)]
+                if let t = text(of: view) { node["text"] = t }
+                if let tf = view as? NSTextField {
+                    node["lineBreak"] = tf.lineBreakMode.rawValue
+                    node["wraps"] = tf.cell?.wraps ?? false
+                    node["maxLines"] = tf.maximumNumberOfLines
+                    node["editable"] = tf.isEditable
+                    node["bezeled"] = tf.isBezeled
+                    if let cell = tf.cell {
+                        let need = cell.cellSize(forBounds: NSRect(x: 0, y: 0, width: tf.bounds.width, height: 10_000))
+                        node["needHeight"] = Double(need.height)
+                        let one = cell.cellSize(forBounds: NSRect(x: 0, y: 0, width: 10_000, height: 10_000))
+                        node["needWidth"] = Double(one.width)
+                    }
+                    node["fontSize"] = Double(tf.font?.pointSize ?? 0)
+                }
+                if let c = view as? NSControl { node["controlSize"] = c.controlSize.rawValue; node["enabled"] = c.isEnabled }
+                if let s = view as? NSScrollView {
+                    node["docFrame"] = s.documentView.map { rect($0.frame) } ?? []
+                    node["clipBounds"] = rect(s.contentView.bounds)
+                    node["scrollerShown"] = (s.verticalScroller.map { !$0.isHidden } ?? false) && s.hasVerticalScroller
+                }
+                if let st = view as? NSStackView {
+                    node["orientation"] = st.orientation == .vertical ? "v" : "h"
+                    node["spacing"] = Double(st.spacing)
+                    node["insets"] = [Double(st.edgeInsets.top), Double(st.edgeInsets.left),
+                                      Double(st.edgeInsets.bottom), Double(st.edgeInsets.right)]
+                }
+                if let tv = view as? NSTableView { node["rows"] = tv.numberOfRows; node["rowHeight"] = Double(tv.rowHeight) }
+                nodes.append(node)
+                if shouldDescend(view) {
+                    for sub in view.subviews { queue.append((sub, id)) }
+                }
+            }
+            // Second pass: structure references (grid rows, stack arranged order).
+            for view in visited {
+                guard let id = ids[ObjectIdentifier(view)] else { continue }
+                if let grid = view as? NSGridView {
+                    var rows: [[String: Any]] = []
+                    for r in 0..<grid.numberOfRows {
+                        let row = grid.row(at: r)
+                        var cells: [Int] = []
+                        for c in 0..<grid.numberOfColumns {
+                            if let cv = grid.cell(atColumnIndex: c, rowIndex: r).contentView, let cid = ids[ObjectIdentifier(cv)] {
+                                cells.append(cid)
+                            } else { cells.append(-1) }
+                        }
+                        rows.append(["hidden": row.isHidden, "cells": cells])
+                    }
+                    nodes[id]["grid"] = ["rows": rows, "rowSpacing": Double(grid.rowSpacing),
+                                         "columnSpacing": Double(grid.columnSpacing)]
+                }
+                if let st = view as? NSStackView {
+                    nodes[id]["arranged"] = st.arrangedSubviews.compactMap { ids[ObjectIdentifier($0)] }
+                    nodes[id]["customSpacing"] = st.arrangedSubviews.compactMap { sub -> Double? in
+                        guard ids[ObjectIdentifier(sub)] != nil else { return nil }
+                        return Double(st.customSpacing(after: sub))
+                    }
+                }
+            }
+            let paneVC = window.contentViewController
+            let pane = paneVC as? SettingsPaneViewController
+            let meta: [String: Any] = [
+                "natural": pane.map { Double($0.naturalContentHeight) } ?? -1,
+                "paneMinimum": pane.flatMap { $0.minimumContentHeight.map(Double.init) } ?? -1,
+                "contentMinSize": [Double(window.contentMinSize.width), Double(window.contentMinSize.height)],
+                "contentMaxSize": [Double(window.contentMaxSize.width), Double(window.contentMaxSize.height)],
+                "screenOverride": settings.screenUsableHeightOverride.map(Double.init) ?? -1,
+                "name": name,
+                "pane": paneVC.map { "\(type(of: $0))" } ?? "nil",
+                "preferred": paneVC.map { [Double($0.preferredContentSize.width), Double($0.preferredContentSize.height)] } ?? [],
+                "windowFrame": rect(window.frame),
+                "contentLayoutRect": rect(window.contentLayoutRect),
+                "contentFrame": rect(content.convert(content.bounds, to: nil)),
+                "appearance": NSApp.effectiveAppearance.name.rawValue,
+                "screen": rect(window.screen?.visibleFrame ?? .zero),
+                "nodes": nodes,
+            ]
+            if let data = try? JSONSerialization.data(withJSONObject: meta, options: [.sortedKeys]) {
+                try? data.write(to: URL(fileURLWithPath: "\(outDir)/\(name).json"))
+            }
+            let ambiguous = nodes.filter { ($0["ambiguous"] as? Bool) == true }.map { $0["cls"] as? String ?? "?" }
+            log("MEASURE \(name) pane=\(meta["pane"]!) window=\(rect(window.frame)) content=\(rect(content.bounds)) natural=\(meta["natural"]!) min=\(window.contentMinSize.height) max=\(window.contentMaxSize.height) nodes=\(nodes.count) ambiguous=\(ambiguous)")
+        }
+        func shoot(_ name: String) {
+            requestedShots.append(name)
+            log("SHOOT \(name) \(sw().windowNumber)")
+        }
+
+        // MARK: Driving
+
+        func contentHeight() -> Double { Double(sw().contentLayoutRect.height) }
+
+        func showPane(_ id: String) {
+            guard let item = sw().toolbar?.items.first(where: { $0.itemIdentifier.rawValue == id }),
+                  let action = item.action else { return log("no toolbar item \(id)") }
+            NSApp.sendAction(action, to: item.target, from: item)
+        }
+        func paneTable() -> NSTableView? {
+            guard let view = sw().contentViewController?.view else { return nil }
+            return allSubviews(view).compactMap { $0 as? NSTableView }.first
+        }
+        let profileList: () -> [Profile] = {
+            store.profiles.filter { !$0.isIncognito || $0.id == TabStore.incognitoProfileID }
+        }
+        func selectProfile(_ id: UUID) {
+            guard let vc = sw().contentViewController as? ProfilesSettingsViewController,
+                  let table = paneTable(),
+                  let i = profileList().firstIndex(where: { $0.id == id }) else { return log("selectProfile failed") }
+            table.selectRowIndexes(IndexSet(integer: i), byExtendingSelection: false)
+            vc.tableViewSelectionDidChange(Notification(name: NSTableView.selectionDidChangeNotification, object: table))
+        }
+        func selectExtension(_ extID: String) {
+            guard let vc = sw().contentViewController as? ExtensionsSettingsViewController,
+                  let table = paneTable(),
+                  let i = ExtensionManager.shared.extensions.firstIndex(where: { $0.id == extID }) else { return log("selectExtension failed") }
+            table.selectRowIndexes(IndexSet(integer: i), byExtendingSelection: false)
+            vc.tableViewSelectionDidChange(Notification(name: NSTableView.selectionDidChangeNotification, object: table))
+        }
+        /// Measure + capture the current state in light, then dark, then back to light.
+        func both(_ name: String, settle: TimeInterval = 1.2, _ setup: @escaping () -> Void) {
+            at(0.3) { log("STATE \(name)"); setup() }
+            at(settle) { dumpPane("\(name)-light"); shoot("\(name)-light") }
+            at(0.3) { NSApp.appearance = NSAppearance(named: .darkAqua) }
+            at(1.0) { dumpPane("\(name)-dark"); shoot("\(name)-dark") }
+            at(0.3) { NSApp.appearance = NSAppearance(named: .aqua) }
+        }
+
+        // MARK: Extension sources
+
+        func writeExtension(_ folder: String, _ manifest: [String: Any]) -> URL {
+            let dir = URL(fileURLWithPath: "\(outDir)/ext-src/\(folder)")
+            try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+            if let data = try? JSONSerialization.data(withJSONObject: manifest, options: [.prettyPrinted]) {
+                try? data.write(to: dir.appendingPathComponent("manifest.json"))
+            }
+            try? Data("<!doctype html><title>opts</title>".utf8).write(to: dir.appendingPathComponent("options.html"))
+            return dir
+        }
+        var extIDs: [String: String] = [:]
+        func install(_ key: String, _ folder: URL, _ configure: (inout ExtensionInstaller.Options) -> Void = { _ in }) {
+            var opts = ExtensionInstaller.Options()
+            configure(&opts)
+            do {
+                let ext = try ExtensionManager.shared.install(from: folder, options: opts)
+                extIDs[key] = ext.id
+                log("installed \(key) id=\(ext.id)")
+            } catch { log("install \(key) failed: \(error)") }
+        }
+        let manyPerms = ["storage", "tabs", "scripting", "alarms", "contextMenus", "cookies", "webNavigation",
+                         "webRequest", "notifications", "downloads", "history", "bookmarks", "nativeMessaging",
+                         "clipboardWrite", "clipboardRead", "declarativeNetRequest", "activeTab", "sidePanel",
+                         "offscreen", "privacy", "management", "idle"]
+        let manyHosts = ["<all_urls>", "https://*.example.com/*", "https://accounts.very-long-subdomain-name.example.org/*",
+                         "http://localhost/*"]
+
+        // MARK: Script
+
+        var longProfile: Profile?
+        var defaultProfile: Profile?
+        at(2.0) {
+            NSApp.activate(ignoringOtherApps: true)
+            NSApp.appearance = NSAppearance(named: .aqua)
+            defaultProfile = store.profiles.first { !$0.isIncognito }
+            log("profiles=\(store.profiles.map { "\($0.name)\($0.isIncognito ? "(incognito)" : "")" }) spaces=\(store.spaces.map(\.name)) exts=\(ExtensionManager.shared.extensions.count)")
+            settings.showWindow(nil)
+        }
+        at(1.0) { showPane("general") }
+
+        // General
+        both("general") { }
+
+        // Spaces
+        both("spaces-default") { showPane("spaces") }
+        both("spaces-long") {
+            let p = store.addProfile(name: "Work profile with a rather long descriptive name for testing")
+            longProfile = p
+            if let s = store.spaces.first(where: { !$0.isIncognito }) {
+                store.updateSpace(id: s.id, name: "A very long space name that keeps going to test truncation and wrapping",
+                                  emoji: s.emoji, colorHex: s.colorHex, profileID: p.id)
+            }
+            showPane("general")
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) {
+                settings.showSpacesPane(selectSpaceID: store.spaces.first(where: { !$0.isIncognito })?.id)
+            }
+        }
+        both("spaces-many", settle: 1.8) {
+            let emojis = ["🍎", "🚀", "📚", "🎵", "🧪", "🌲", "🏠", "💼", "🎨", "⚙️", "🛒", "✈️", "🐙", "🧭", "🎮", "📈", "🔒", "☕️"]
+            for (i, e) in emojis.enumerated() {
+                _ = store.addSpace(name: "Space \(i + 2)\(i % 4 == 0 ? " with a longer name than usual" : "")",
+                                   emoji: e, colorHex: "#3478F6", profileID: (i % 3 == 0 ? longProfile?.id : nil) ?? defaultProfile!.id)
+            }
+            showPane("general")
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) {
+                settings.showSpacesPane(selectSpaceID: store.spaces.filter { !$0.isIncognito }.last?.id)
+            }
+        }
+
+        // Extensions: none
+        both("extensions-none") { showPane("extensions") }
+
+        // Extensions: one tall extension, then uninstalled through the pane's own
+        // Uninstall button (its alert answered from a timer in the modal run
+        // loop): the window must come down to the 400 minimum (TASK-189 part 2).
+        let tallDir = writeExtension("tall", [
+            "manifest_version": 3, "name": "Only Extension", "version": "3.0",
+            "description": "The only installed extension, with enough permissions to make the pane taller than its minimum.",
+            "permissions": manyPerms, "host_permissions": manyHosts,
+        ])
+        both("extensions-only-tall", settle: 2.0) {
+            install("tall", tallDir) { $0.sourcePath = tallDir }
+            showPane("general")
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) { showPane("extensions") }
+        }
