+#!/usr/bin/env python3
+"""Before/after contact sheets: each state of a pane from BEFORE beside the
+same state from AFTER, light and dark. Usage: compare.py BEFORE AFTER OUTDIR pane..."""
+import os, subprocess, sys
+
+before, after, out = sys.argv[1:4]
+panes = sys.argv[4:]
+font = "/System/Library/Fonts/Supplemental/Arial.ttf"
+order = {
+ "profiles": ["profiles-normal", "profiles-private", "profiles-customUA-warning", "profiles-externalApps-several",
+              "profiles-extensions", "profiles-everything", "profiles-everything-scrolled", "profiles-private-extensions",
+              "profiles-capped", "profiles-capped-scrolled"],
+ "extensions": ["extensions-none", "extensions-one", "extensions-big", "extensions-pending", "extensions-many",
+                "extensions-capped"],
+}
+os.makedirs(out, exist_ok=True)
+for pane in panes:
+    args = ["magick", "montage"]
+    for s in order[pane]:
+        for m in ("light", "dark"):
+            for tag, d in (("before", before), ("after", after)):
+                p = f"{d}/{s}-{m}.png"
+                if os.path.exists(p):
+                    args += ["-label", f"{s} ({m}) {tag}", p]
+                else:
+                    args += ["-label", f"{s} ({m}) {tag}: none", "xc:#bdbdbd[200x100]"]
+    args += ["-tile", "2x", "-geometry", "+16+16", "-font", font, "-pointsize", "20", "-background", "#bdbdbd",
+             f"{out}/{pane}-before-after.png"]
+    subprocess.check_call(args)
+    print(pane, subprocess.check_output(["magick", "identify", "-format", "%wx%h", f"{out}/{pane}-before-after.png"]).decode())
