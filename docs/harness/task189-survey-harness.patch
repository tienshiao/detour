+        at(1.0) { log("FIT spaces natural=\((sw().contentViewController as? SettingsPaneViewController)?.naturalContentHeight ?? -1) content=\(contentHeight()) min=\(sw().contentMinSize) max=\(sw().contentMaxSize)") }
+        // Dragging: the bottom edge in both directions past the bounds, then the right edge.
+        at(0.5) { drag("bottom-down-200", from: NSPoint(x: 370, y: 1), dx: 0, dy: -200) }
