+// TEMP TASK-186.3 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+extension AppDelegate {
+    @MainActor func runTask1863HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"],
+              let port = ProcessInfo.processInfo.environment["DETOUR_VERIFY_PORT"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var steps: [(TimeInterval, () -> Void)] = []
+        var requestedShots: [String] = []
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) { steps.append((dt, block)) }
+        func runStep(_ index: Int) {
+            guard index < steps.count else { return }
+            let missing = requestedShots.filter { !FileManager.default.fileExists(atPath: "\(outDir)/\($0).png") }
+            let delay = missing.isEmpty ? steps[index].0 : 0.1
+            let timer = Timer(timeInterval: delay, repeats: false) { _ in
+                if missing.isEmpty { steps[index].1(); runStep(index + 1) } else { runStep(index) }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window, let space = wc.activeSpace else { return log("no window/space") }
+        let store = TabStore.shared
+        let tallURL = URL(string: "http://localhost:\(port)/tall.html")!
+        let appURL = URL(string: "http://localhost:\(port)/app.html")!
+        let apiURL = URL(string: "http://localhost:\(port)/api.html")!
+        var tabs: [String: BrowserTab] = [:]
+
+        // Seams: a private pasteboard and a scratch folder, never the user's.
+        let pasteboard = NSPasteboard(name: NSPasteboard.Name("com.detourbrowser.verify.task1863"))
+        pasteboard.clearContents()
+        let saveDir = URL(fileURLWithPath: outDir).appendingPathComponent("saved", isDirectory: true)
+        wc.capturePasteboard = pasteboard
+        wc.captureSaveDirectory = { saveDir }
+
+        func r(_ rect: NSRect) -> String {
+            String(format: "(%.0f,%.0f %.0fx%.0f)", rect.minX, rect.minY, rect.width, rect.height)
+        }
+        func shoot(_ name: String) {
+            requestedShots.append(name)
+            log("SHOOT \(name) \(window.windowNumber)")
+        }
+        func group(_ key: String) -> DevToolbarCaptureGroup? {
+            tabs[key]?.webViewContainer?.devToolbar?.captureGroup
+        }
+        func press(_ key: String, _ kind: PageCapture.Kind, option: Bool = false) {
+            guard let g = group(key) else { return log("press [\(key)]: no capture group") }
+            g.modifierFlags = { option ? [.option] : [] }
+            let button = kind == .visible ? g.visibleButton : g.fullPageButton
+            log("press \(kind == .visible ? "visible" : "full page")\(option ? " (option)" : "") [\(key)] enabled=\(button.isEnabled)")
+            button.performClick(nil)
+            log("  busy right after the press: visible.enabled=\(g.visibleButton.isEnabled) full.enabled=\(g.fullPageButton.isEnabled)")
+        }
+        var pasteboardChange = pasteboard.changeCount
+        /// Saves the pasteboard's PNG and logs its size and resolution.
+        func savePasteboard(_ name: String, expectPoints: NSSize?) {
+            guard pasteboard.changeCount != pasteboardChange else { return log("\(name): pasteboard unchanged") }
+            pasteboardChange = pasteboard.changeCount
+            guard let png = pasteboard.data(forType: .png) else { return log("\(name): no PNG on the pasteboard, types \(pasteboard.types ?? [])") }
+            let url = URL(fileURLWithPath: outDir).appendingPathComponent("\(name).png")
+            try? png.write(to: url)
+            let rep = NSBitmapImageRep(data: png)
+            let scale = window.backingScaleFactor
+            var line = "\(name): PNG \(rep?.pixelsWide ?? -1)x\(rep?.pixelsHigh ?? -1) px, size \(rep.map { "\($0.size)" } ?? "-") pt, types \((pasteboard.types ?? []).map(\.rawValue))"
+            if let p = expectPoints { line += String(format: " | expected %.0fx%.0f px (%.0fx%.0f pt x %.0f)", p.width * scale, p.height * scale, p.width, p.height, scale) }
+            log(line)
+        }
+        func pane(_ key: String) -> String {
+            guard let tab = tabs[key], let c = tab.webViewContainer, let w = tab.webView else { return "\(key): none" }
+            return "\(key): container \(r(c.frame)) webView \(r(w.frame)) toolbar \(c.devToolbar.map { r($0.frame) } ?? "none") subviews \(c.subviews.map { "\(type(of: $0))" })"
+        }
+        func js(_ key: String, _ script: String, _ label: String) {
+            tabs[key]?.webView?.evaluateJavaScript(script) { v, e in log("\(label): \(v.map { "\($0)" } ?? "nil") \(e.map { "\($0)" } ?? "")") }
+        }
+
+        // MARK: Seed (on the 2x screen if there is one)
+        at(0) {
+            NSApp.activate(ignoringOtherApps: true)
+            NSApp.appearance = NSAppearance(named: .aqua)
+            let screen = NSScreen.screens.first { $0.backingScaleFactor >= 2 } ?? window.screen ?? NSScreen.main!
+            let f = screen.visibleFrame
+            window.setFrame(NSRect(x: f.minX + 20, y: f.maxY - 20 - 860, width: min(1400, f.width - 40), height: 860), display: true)
+            tabs["tall"] = store.addTab(in: space, url: tallURL)
+            for tab in space.tabs where !tabs.values.contains(where: { $0 === tab }) {
+                store.closeTab(id: tab.id, in: space, undoable: false)
+            }
+            store.undoManager.removeAllActions()
+            wc.selectTab(id: tabs["tall"]!.id)
+            log("seeded: screens \(NSScreen.screens.map { "\($0.localizedName) \($0.backingScaleFactor)x" }) window scale \(window.backingScaleFactor) frame \(r(window.frame))")
+        }
+        at(3.0) {
+            log("0 " + pane("tall"))
+            log("0 stack: \(tabs["tall"]?.webViewContainer?.devToolbar?.trailingStack.arrangedSubviews.map { $0.accessibilityLabel() ?? "\(type(of: $0))" } ?? [])")
+            js("tall", "[document.documentElement.scrollWidth, document.documentElement.scrollHeight, devicePixelRatio]", "0 tall metrics")
+            shoot("0-toolbar")
+        }
+        // MARK: 1 — visible area to the clipboard, scrolled to 1000
+        at(0.5) { js("tall", "window.scrollTo(0, 1000); scrollY", "1 scrolled") }
+        at(0.5) { press("tall", .visible) }
+        at(0.4) { shoot("1-window-toast") }
+        at(1.0) { savePasteboard("1-visible", expectPoints: tabs["tall"]?.webView?.frame.size); log("1 " + pane("tall")) }
+        // MARK: 2 — full page, scrolled to the middle
+        at(2.0) { js("tall", "window.scrollTo(0, 2400); scrollY", "2 scrolled") }
+        at(0.5) { press("tall", .fullPage) }
+        at(0.4) { shoot("2-window-toast-full") }
+        at(2.5) {
+            savePasteboard("2-fullpage", expectPoints: nil)
+            js("tall", "[document.documentElement.scrollWidth, document.documentElement.scrollHeight, scrollY]", "2 doc size and scroll after")
+        }
+        // MARK: 3 — Option-click saves; a second capture does not overwrite
+        at(2.5) { press("tall", .visible, option: true) }
+        at(0.4) { shoot("3-toast-saved-light") }
+        at(0.3) {
+            // Two in the same second: the second must not overwrite the first.
+            press("tall", .visible, option: true)
+            press("tall", .visible, option: true)
+        }
+        at(1.0) { press("tall", .fullPage, option: true) }
+        at(3.0) {
+            let files = (try? FileManager.default.contentsOfDirectory(atPath: saveDir.path))?.sorted() ?? []
+            log("3 saved files: \(files)")
+            log("3 pasteboard unchanged by the saves: \(pasteboard.changeCount == pasteboardChange)")
+        }
+        // MARK: 6 — the toast in dark
+        at(2.5) { NSApp.appearance = NSAppearance(named: .darkAqua) }
+        at(1.0) { press("tall", .visible) }
+        at(0.5) { shoot("6-toast-dark") }
+        at(2.5) { savePasteboard("6-visible-dark", expectPoints: tabs["tall"]?.webView?.frame.size) }
+        at(0.5) { press("tall", .visible, option: true) }
+        at(0.5) { shoot("6-toast-saved-dark") }
+        at(2.5) { NSApp.appearance = NSAppearance(named: .aqua) }
+        // MARK: 4 — a split: the unfocused right pane's button captures that pane only
+        at(1.0) {
+            let app = store.addTab(in: space, url: appURL)
+            let api = store.addTab(in: space, url: apiURL)
+            tabs["app"] = app; tabs["api"] = api
+            store.createSplit(draggedTabID: api.id, targetTabID: app.id, edge: .right, in: space)
+            wc.selectTab(id: app.id)
+        }
+        at(3.0) {
+            log("4 split: \(pane("app")) | \(pane("api")) focused=\(wc.selectedTab.flatMap { t in tabs.first { $0.value === t }?.key } ?? "?")")
+            shoot("4-split")
+        }
+        at(0.5) { press("api", .visible) }
+        at(2.0) {
+            savePasteboard("4-split-api-visible", expectPoints: tabs["api"]?.webView?.frame.size)
+            log("4 focused after the press: \(wc.selectedTab.flatMap { t in tabs.first { $0.value === t }?.key } ?? "?")")
+        }
+        at(0.5) { press("app", .fullPage) }
+        at(2.5) { savePasteboard("4-split-app-full", expectPoints: tabs["app"]?.webView?.frame.size) }
+        // MARK: 5 — docked inspector open: excluded from the capture
+        at(1.0) { wc.selectTab(id: tabs["tall"]!.id) }
+        at(2.0) {
+            guard let wv = tabs["tall"]?.webView else { return }
+            WebInspectorToggler.shared.toggle(.console, for: wv)
+        }
+        at(4.0) {
+            let control = tabs["tall"]?.webView.flatMap { WebInspectorControl(webView: $0) }
+            log("5 inspector visible=\(control?.isVisible ?? false) attached=\(control?.isAttached ?? false) frontend \(control?.frontendWebView.map { r($0.frame) } ?? "none") | " + pane("tall"))
+            js("tall", "window.scrollTo(0, 1000); scrollY", "5 scrolled")
+        }
+        at(0.5) { press("tall", .visible) }
+        at(0.5) { shoot("5-inspector") }
+        at(2.0) { savePasteboard("5-inspector-visible", expectPoints: tabs["tall"]?.webView?.frame.size) }
+        at(0.5) { press("tall", .fullPage) }
+        at(3.0) { savePasteboard("5-inspector-full", expectPoints: nil) }
+        at(0.5) {
+            if let wv = tabs["tall"]?.webView, let c = WebInspectorControl(webView: wv), c.isVisible { c.close() }
+        }
+        at(1.5) { log("5 closed: " + pane("tall")) }
+        at(1.0) { log("done") }
+        steps[0].0 = 3.0
+        runStep(0)
+    }
+}
+#endif
