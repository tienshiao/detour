+// TEMP TASK-287 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask287HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 3.0
+        func at(_ dt: TimeInterval, _ block: @escaping @MainActor @Sendable () -> Void) {
+            clock += dt
+            Timer.scheduledMainTimer(withTimeInterval: clock, repeats: false) { _ in block() }
+        }
+        guard let window = wc.window else { return log("no window") }
+
+        func key(_ code: UInt16, _ chars: String, in target: NSWindow? = nil) {
+            let w = target ?? window
+            guard let e = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: [],
+                                           timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: w.windowNumber, context: nil,
+                                           characters: chars, charactersIgnoringModifiers: chars,
+                                           isARepeat: false, keyCode: code) else { return }
+            w.firstResponder?.keyDown(with: e)
+        }
+        func typeText(_ text: String) {
+            for ch in text { at(0.12) { key(0, String(ch)) } }
+        }
+        func state() -> String {
+            guard let p = wc.commandPaletteView else { return "no palette" }
+            let field = (window.firstResponder as? NSTextView)?.string ?? "?"
+            return "field=\"\(field)\" site=\(p.activeSiteSearch?.name ?? "nil") rows=\(p.suggestions.map { "\($0)".prefix(70) })"
+        }
+
+        at(0) {
+            guard let spaceID = wc.activeSpaceID else { return log("no active space") }
+            HistoryDatabase.shared.recordVisit(url: "https://www.youtube.com/", title: "YouTube",
+                                               faviconURL: nil, spaceID: spaceID.uuidString, typed: true)
+            log("seeded; store has \(SiteSearchStore.shared.entries.map { "\($0.name)/\($0.keyword)" })")
+        }
+        at(0.5) { NSApp.activate(ignoringOtherApps: true); window.makeKeyAndOrderFront(nil); log("front") }
+        at(1.0) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); log("Cmd+T") }
+        typeText("you")
+        at(1.2) { log("after you: \(state())"); log("SHOOT \(window.windowNumber) you") }
+        at(2.5) { key(48, "\t"); log("Tab: \(state())") }
+        typeText("cats")
+        at(1.2) { log("after cats: \(state())"); log("SHOOT \(window.windowNumber) mode") }
+        at(2.5) { key(36, "\r"); log("Return") }
+        at(1.5) { log("selected tab url: \(wc.selectedTab?.url?.absoluteString ?? "nil")") }
+
+        // Keyword + Space, then Backspace out.
+        at(0.5) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil) }
+        typeText("w ")
+        at(0.5) { log("after 'w ': \(state())") }
+        at(0.3) { key(51, "\u{7F}"); log("Backspace: \(state())") }
+        at(0.3) { key(53, "\u{1B}"); key(53, "\u{1B}"); key(53, "\u{1B}") }
+
+        // Settings > Search, then the add sheet.
+        at(1.0) {
+            let settings = SettingsWindowController.shared
+            settings.showWindow(nil)
+            if let item = settings.window?.toolbar?.items.first(where: { $0.itemIdentifier.rawValue == "search" }) {
+                settings.perform(Selector(("selectPane:")), with: item)
+            }
+            log("settings shown")
+        }
+        at(1.5) { log("SHOOT \(SettingsWindowController.shared.window?.windowNumber ?? -1) settings") }
+        at(2.5) {
+            guard let pane = SettingsWindowController.shared.window?.contentViewController else { return log("no pane") }
+            NSApp.sendAction(Selector(("addClicked")), to: pane, from: nil)
+            log("add clicked")
+        }
+        at(1.0) {
+            guard let sheet = SettingsWindowController.shared.window?.attachedSheet else { return log("no sheet") }
+            log("SHOOT \(sheet.windowNumber) sheet")
+        }
+        at(2.5) {
+            if let sheet = SettingsWindowController.shared.window?.attachedSheet {
+                SettingsWindowController.shared.window?.endSheet(sheet, returnCode: .alertSecondButtonReturn)
+            }
+            log("done")
+        }
+    }
+}
+#endif
