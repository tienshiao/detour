+// TEMP TASK-181 / TASK-182 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+extension AppDelegate {
+    func runTask182HarnessIfRequested(_ wc: BrowserWindowController) {
+        guard let outDir = ProcessInfo.processInfo.environment["DETOUR_VERIFY_DIR"] else { return }
+        let logURL = URL(fileURLWithPath: outDir).appendingPathComponent("verify.log")
+        let start = ProcessInfo.processInfo.systemUptime
+        func log(_ line: String) {
+            let stamped = String(format: "[%6.2f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+            let data = Data(stamped.utf8)
+            if let h = try? FileHandle(forWritingTo: logURL) {
+                h.seekToEndOfFile(); h.write(data); try? h.close()
+            } else { try? data.write(to: logURL) }
+        }
+        var clock: TimeInterval = 3.0
+        func at(_ dt: TimeInterval, _ block: @escaping () -> Void) {
+            clock += dt
+            let timer = Timer(timeInterval: clock, repeats: false) { _ in block() }
+            RunLoop.main.add(timer, forMode: .common)
+        }
+        guard let window = wc.window else { return log("no window") }
+
+        func allSubviews(_ view: NSView) -> [NSView] {
+            view.subviews + view.subviews.flatMap(allSubviews)
+        }
+        func palette() -> CommandPaletteView? {
+            allSubviews(window.contentView!).compactMap { $0 as? CommandPaletteView }.first
+        }
+        func editor() -> NSTextView? { window.firstResponder as? NSTextView }
+        func key(_ code: UInt16, _ chars: String, flags: NSEvent.ModifierFlags = []) {
+            guard let e = NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: flags,
+                                           timestamp: ProcessInfo.processInfo.systemUptime,
+                                           windowNumber: window.windowNumber, context: nil,
+                                           characters: chars, charactersIgnoringModifiers: chars,
+                                           isARepeat: false, keyCode: code) else { return }
+            // The field editor's own keyDown: interpretKeyEvents and the real
+            // key bindings (Cmd+Right → moveToRightEndOfLine:).
+            window.firstResponder?.keyDown(with: e)
+        }
+        func typeText(_ text: String) {
+            for ch in text {
+                at(0.12) { key(0, String(ch)) }
+            }
+        }
+        func state(_ label: String) {
+            guard let ed = editor() else { return log("\(label): first responder \(String(describing: window.firstResponder))") }
+            log("\(label): field=\"\(ed.string)\" selection=\(NSStringFromRange(ed.selectedRange()))")
+            if let table = palette().flatMap({ allSubviews($0).compactMap { $0 as? NSTableView }.first }) {
+                for row in 0 ..< table.numberOfRows {
+                    let texts = table.view(atColumn: 0, row: row, makeIfNecessary: false)
+                        .map { allSubviews($0).compactMap { ($0 as? NSTextField)?.stringValue }.filter { !$0.isEmpty } } ?? []
+                    log("  row \(row): \(texts.joined(separator: " | "))")
+                }
+            }
+        }
+        func snap(_ name: String) {
+            guard let view = window.contentView,
+                  let rep = view.bitmapImageRepForCachingDisplay(in: view.bounds) else { return }
+            view.cacheDisplay(in: view.bounds, to: rep)
+            try? rep.representation(using: .png, properties: [:])?
+                .write(to: URL(fileURLWithPath: outDir).appendingPathComponent("\(name).png"))
+            log("SHOT \(name)")
+        }
+
+        at(0) {
+            guard let spaceID = wc.activeSpaceID, let space = TabStore.shared.space(withID: spaceID) else {
+                return log("no active space")
+            }
+            // Three sleeping video tabs: listed, never loaded.
+            for n in 1 ... 3 {
+                space.tabs.append(BrowserTab(id: UUID(), title: "Video \(n)",
+                                             url: URL(string: "https://www.youtube.com/watch?v=\(n)"),
+                                             faviconURL: nil, cachedInteractionState: nil, spaceID: spaceID))
+            }
+            // History: one typed visit to another "you…" host.
+            HistoryDatabase.shared.recordVisit(url: "https://yourstore.example/", title: "Your Store",
+                                               faviconURL: nil, spaceID: spaceID.uuidString, typed: true)
+            log("seeded 3 video tabs + yourstore.example in space \(spaceID)")
+        }
+
+        // TASK-182: Cmd+T, then "you".
+        at(1.0) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); log("Cmd+T") }
+        typeText("you")
+        at(1.0) { state("H1 after typing you"); snap("h1-you") }
+        // TASK-181: Cmd+Right, then Backspace.
+        at(0.3) { key(124, "\u{F703}", flags: [.command, .function, .numericPad]); state("B1 after Cmd+Right") }
+        at(0.3) { key(51, "\u{7F}"); state("B2 after Backspace") }
+        at(0.6) { state("B3 settled") }
+        // Backspace while the completion is still selected: only the completion goes.
+        at(0.3) { key(53, "\u{1B}"); key(53, "\u{1B}"); key(53, "\u{1B}"); log("Escape x3") }
+        at(0.5) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); log("Cmd+T") }
+        typeText("youtube.com/w")
+        at(1.0) { state("U1 after typing youtube.com/w") }
+        at(0.3) { key(51, "\u{7F}"); state("U2 Backspace on the selected completion") }
+        // Left collapses the selection to the caret before the completion; the
+        // Backspace after it deletes the typed "w" (TASK-181).
+        at(0.3) { key(53, "\u{1B}"); key(53, "\u{1B}"); key(53, "\u{1B}"); log("Escape x3") }
+        at(0.5) { NSApp.sendAction(#selector(BrowserWindowController.newTab(_:)), to: wc, from: nil); log("Cmd+T") }
+        typeText("youtube.com/w")
+        at(1.0) { state("L1 after typing youtube.com/w") }
+        at(0.3) { key(123, "\u{F702}", flags: [.function, .numericPad]); state("L2 after Left") }
+        at(0.3) { key(51, "\u{7F}"); state("L3 after Backspace") }
+        at(0.5) { key(53, "\u{1B}"); key(53, "\u{1B}"); key(53, "\u{1B}"); log("done") }
+    }
+}
+#endif
