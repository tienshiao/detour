+++ b/Detour/App/Task1912Harness.swift
@@ -0,0 +1,149 @@
+// TEMP TASK-191.2 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+
+enum Task1912Harness {
+    static let env = ProcessInfo.processInfo.environment
+    static var outDir: String? { env["DETOUR_VERIFY_DIR"] }
+    static let start = ProcessInfo.processInfo.systemUptime
+
+    static func log(_ line: String) {
+        guard let outDir else { return }
+        let url = URL(fileURLWithPath: outDir).appendingPathComponent("verify-\(env["DETOUR_VERIFY_PHASE"] ?? "x").log")
+        let stamped = String(format: "[%7.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+        let data = Data(stamped.utf8)
+        if let h = try? FileHandle(forWritingTo: url) {
+            h.seekToEndOfFile(); h.write(data); try? h.close()
+        } else { try? data.write(to: url) }
+    }
+
+    static func spaceName(_ id: UUID?) -> String {
+        guard let id else { return "-" }
+        guard let space = TabStore.shared.space(withID: id) else { return "?\(id.uuidString.prefix(4))" }
+        return space.isIncognito ? "Private(\(id.uuidString.prefix(4)))" : space.name
+    }
+
+    /// The raw sender attributes of the Apple Event being handled.
+    static func logEvent(urls: [URL], resolvedSender: String?) {
+        let event = NSAppleEventManager.shared().currentAppleEvent
+        func fourCC(_ v: UInt32) -> String {
+            String(bytes: [24, 16, 8, 0].map { UInt8((v >> $0) & 0xff) }, encoding: .macOSRoman) ?? "\(v)"
+        }
+        var parts = ["OPEN urls=\(urls.map(\.absoluteString))"]
+        if let event {
+            parts.append("event=\(fourCC(event.eventClass))/\(fourCC(event.eventID))")
+            let spid = event.attributeDescriptor(forKeyword: AEKeyword(keySenderPIDAttr))
+            parts.append("spid=\(spid.map { "\(fourCC($0.descriptorType)):\($0.data.count == 4 ? String($0.data.withUnsafeBytes { $0.loadUnaligned(as: Int32.self) }) : $0.description)" } ?? "nil")")
+            let addr = event.attributeDescriptor(forKeyword: AEKeyword(keyAddressAttr))
+            parts.append("addr=\(addr.map { "\(fourCC($0.descriptorType)):\($0.description)" } ?? "nil")")
+            let orig = event.attributeDescriptor(forKeyword: AEKeyword(keyOriginalAddressAttr))
+            parts.append("from=\(orig.map { "\(fourCC($0.descriptorType)):\($0.description)" } ?? "nil")")
+            if let pid = linkSenderPID(of: event) {
+                let app = NSRunningApplication(processIdentifier: pid)
+                parts.append("senderPID=\(pid) app.bundleID=\(app?.bundleIdentifier ?? "nil") app.exe=\(app?.executableURL?.path ?? "nil") app.name=\(app?.localizedName ?? "nil")")
+            }
+        } else {
+            parts.append("event=nil")
+        }
+        parts.append("resolvedSender=\(resolvedSender ?? "nil")")
+        parts.append("active=\(NSApp.isActive) key=\((NSApp.keyWindow?.windowController as? BrowserWindowController).map { spaceName($0.activeSpaceID) } ?? "nil") launched=\(didFinishLaunching)")
+        log(parts.joined(separator: " "))
+    }
+
+    static func logDecision(_ url: URL, _ decision: LinkRouteDecision, _ placement: LinkPlacement<ObjectIdentifier>,
+                            windows: [BrowserWindowController]) {
+        let names = windows.map { "#\($0.window?.windowNumber ?? 0):\(spaceName($0.activeSpaceID))" }
+        var p = String(describing: placement)
+        for wc in windows {
+            p = p.replacingOccurrences(of: String(describing: ObjectIdentifier(wc)), with: "#\(wc.window?.windowNumber ?? 0)")
+        }
+        let decisionText: String
+        if case .openInSpace(let id) = decision { decisionText = "openInSpace(\(spaceName(id)))" } else { decisionText = "\(decision)" }
+        for space in TabStore.shared.spaces { p = p.replacingOccurrences(of: space.id.uuidString, with: space.name) }
+        log("ROUTE \(url.absoluteString) decision=\(decisionText) windows(recent first)=\(names) placement=\(p)")
+    }
+
+    static var didFinishLaunching = false
+
+    static func dump(_ label: String) {
+        let ordered = NSApp.browserWindowControllersFrontToBack
+        var lines = ["STATE \(label): active=\(NSApp.isActive) key=#\(NSApp.keyWindow?.windowNumber ?? 0)"]
+        for (i, wc) in ordered.enumerated() {
+            let space = wc.activeSpace
+            let tabs = space?.tabs.compactMap { $0.url?.absoluteString } ?? []
+            lines.append("  [\(i)] #\(wc.window?.windowNumber ?? 0) space=\(spaceName(wc.activeSpaceID)) private=\(wc.isIncognito) selected=\(wc.selectedTab?.url?.absoluteString ?? "-") tabs=\(tabs)")
+        }
+        log(lines.joined(separator: "\n"))
+        log("WINDOWS \(label) \(ordered.compactMap { $0.window?.windowNumber }.map(String.init).joined(separator: " "))")
+    }
+}
+
+extension AppDelegate {
+    func runTask1912HarnessIfRequested(_ wc: BrowserWindowController) {
+        Task1912Harness.didFinishLaunching = true
+        guard let outDir = Task1912Harness.outDir, let phase = Task1912Harness.env["DETOUR_VERIFY_PHASE"] else { return }
+        let log = Task1912Harness.log
+        let store = TabStore.shared
+        let routes = store.linkRoutes
+        log("phase \(phase) launched pid=\(ProcessInfo.processInfo.processIdentifier) spaces=\(store.nonIncognitoSpaces.map(\.name)) routes=\(routes.routes.count) default=\(routes.defaultTarget.storageKind)")
+
+        func space(named name: String) -> Space? { store.nonIncognitoSpaces.first { $0.name == name } }
+
+        if phase == "1" {
+            let profileID = store.nonIncognitoSpaces.first!.profileID
+            for name in ["Work", "Personal", "Other"] where space(named: name) == nil {
+                store.addSpace(name: name, emoji: "🛫", colorHex: name == "Work" ? "007AFF" : name == "Personal" ? "34C759" : "FF9500", profileID: profileID)
+            }
+            for r in routes.routes { routes.removeRoute(id: r.id) }
+            let work = space(named: "Work")!, personal = space(named: "Personal")!, other = space(named: "Other")!
+            routes.add(LinkRoute(match: LinkRouteMatch(kind: .domainIs, pattern: "work.test"), target: .space(work.id)))
+            routes.add(LinkRoute(match: LinkRouteMatch(kind: .domainIs, pattern: "personal.test"), target: .space(personal.id)))
+            routes.add(LinkRoute(match: LinkRouteMatch(kind: .domainIs, pattern: "other.test"), target: .space(other.id)))
+            routes.add(LinkRoute(match: LinkRouteMatch(kind: .contains, pattern: "secret"), target: .privateWindow))
+            routes.add(LinkRoute(match: nil, sourceApp: "com.detourbrowser.verify.sender-a", target: .space(personal.id)))
+            routes.add(LinkRoute(match: LinkRouteMatch(kind: .domainIs, pattern: "mru.test"), target: .mostRecentSpace))
+            routes.setDefaultTarget(.mostRecentSpace)
+            log("seeded routes: \(routes.routes.map { "\(linkRouteSummary($0)) -> \($0.target.storageKind):\(Task1912Harness.spaceName($0.target.spaceID))" })")
+            // Windows: the launch window on Home (or the first space), one on
+            // Work, one on Personal in front.
+            if let home = store.nonIncognitoSpaces.first(where: { !["Work", "Personal", "Other"].contains($0.name) }) {
+                wc.setActiveSpace(id: home.id, selectTab: false)
+            }
+            let workWC = createNewWindow(showing: work)
+            workWC.window?.setFrameOrigin(NSPoint(x: 80, y: 80))
+            let personalWC = createNewWindow(showing: personal)
+            personalWC.window?.setFrameOrigin(NSPoint(x: 160, y: 40))
+        }
+
+        // Commands appended to cmd.txt, one per line, applied in order.
+        var handled = 0
+        let cmdURL = URL(fileURLWithPath: outDir).appendingPathComponent("cmd-\(phase).txt")
+        var previousFront: NSRunningApplication?
+        let timer = Timer(timeInterval: 0.3, repeats: true) { _ in
+            guard let text = try? String(contentsOf: cmdURL, encoding: .utf8) else { return }
+            let lines = text.split(separator: "\n").map(String.init)
+            while handled < lines.count {
+                let parts = lines[handled].split(separator: " ", maxSplits: 1).map(String.init)
+                handled += 1
+                switch parts.first {
+                case "dump": Task1912Harness.dump(parts.count > 1 ? parts[1] : "")
+                case "default":
+                    let arg = parts.count > 1 ? parts[1] : ""
+                    if let s = space(named: arg) { routes.setDefaultTarget(.space(s.id)) } else { routes.setDefaultTarget(.mostRecentSpace) }
+                    log("CMD default -> \(routes.defaultTarget.storageKind):\(Task1912Harness.spaceName(routes.defaultTarget.spaceID))")
+                case "activate":
+                    previousFront = NSWorkspace.shared.frontmostApplication
+                    NSApp.activate(ignoringOtherApps: true)
+                    log("CMD activate (previous front: \(previousFront?.bundleIdentifier ?? "nil"))")
+                case "restore":
+                    previousFront?.activate()
+                    log("CMD restore -> \(previousFront?.bundleIdentifier ?? "nil")")
+                default: log("CMD unknown \(lines[handled - 1])")
+                }
+            }
+        }
+        RunLoop.main.add(timer, forMode: .common)
+        log("ready")
+    }
+}
+#endif
