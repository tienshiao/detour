@@ -0,0 +1,275 @@
+// TEMP TASK-191.4 verify harness — DO NOT COMMIT
+#if DEBUG
+import AppKit
+import WebKit
+
+enum Task1914Harness {
+    static let env = ProcessInfo.processInfo.environment
+    static var outDir: String? { env["DETOUR_VERIFY_DIR"] }
+    static let start = ProcessInfo.processInfo.systemUptime
+    static var labels: [ObjectIdentifier: String] = [:]
+
+    static func log(_ line: String) {
+        guard let outDir else { return }
+        let url = URL(fileURLWithPath: outDir).appendingPathComponent("verify-\(env["DETOUR_VERIFY_PHASE"] ?? "x").log")
+        let stamped = String(format: "[%8.3f] %@\n", ProcessInfo.processInfo.systemUptime - start, line)
+        let data = Data(stamped.utf8)
+        if let h = try? FileHandle(forWritingTo: url) {
+            h.seekToEndOfFile(); h.write(data); try? h.close()
+        } else { try? data.write(to: url) }
+    }
+
+    static func spaceName(_ id: UUID?) -> String {
+        guard let id else { return "-" }
+        guard let space = TabStore.shared.space(withID: id) else { return "?\(id.uuidString.prefix(4))" }
+        return space.isIncognito ? "Private(\(id.uuidString.prefix(4)))" : space.name
+    }
+
+    static func label(_ wc: BrowserWindowController?) -> String {
+        guard let wc else { return "nil" }
+        let name = labels[ObjectIdentifier(wc)] ?? (wc.isIncognito ? "P?" : "W?")
+        return "\(name)#\(wc.window?.windowNumber ?? 0)"
+    }
+
+    static func describe(_ decision: LinkRouteDecision?) -> String {
+        guard let decision else { return "none (as before)" }
+        if case .openInSpace(let id) = decision { return "openInSpace(\(spaceName(id)))" }
+        return "\(decision)"
+    }
+
+    static func logClick(_ wc: BrowserWindowController, _ request: InPageLinkRequest,
+                         _ eligibility: LinkRoutingEligibility, _ decision: LinkRouteDecision?) {
+        log("CLICK window=\(label(wc)) space=\(spaceName(wc.activeSpaceID)) entry=\(request.entry) mods=\(request.modifiers.rawValue) gesture=\(request.isUserGesture) peek=\(request.isInPeek) page=\(request.pageURL?.absoluteString ?? "nil") target=\(request.targetURL.absoluteString) eligibility=\(eligibility) decision=\(describe(decision))")
+    }
+
+    static func logTyped(_ wc: BrowserWindowController, url: URL, typed: Bool, inPlace: Bool, routable: Bool) {
+        log("TYPED window=\(label(wc)) space=\(spaceName(wc.activeSpaceID)) url=\(url.absoluteString) isSearch=\(!typed) navigatesInPlace=\(inPlace) routable=\(routable)")
+    }
+
+    static func logTypedDecision(_ wc: BrowserWindowController, url: URL, decision: LinkRouteDecision?) {
+        log("TYPED-DECISION window=\(label(wc)) url=\(url.absoluteString) decision=\(describe(decision))")
+    }
+
+    static func logPlacement(_ url: URL, _ decision: LinkRouteDecision, _ placement: LinkPlacement<ObjectIdentifier>,
+                             windows: [BrowserWindowController]) {
+        var p = String(describing: placement)
+        for wc in windows { p = p.replacingOccurrences(of: String(describing: ObjectIdentifier(wc)), with: label(wc)) }
+        for space in TabStore.shared.spaces { p = p.replacingOccurrences(of: space.id.uuidString, with: space.name) }
+        log("PLACE \(url.absoluteString) decision=\(describe(decision)) windows(recent first)=\(windows.map(label)) placement=\(p)")
+    }
+
+    static func dump(_ label: String) {
+        let ordered = NSApp.browserWindowControllersFrontToBack
+        var lines = ["STATE \(label): active=\(NSApp.isActive) key=\(Self.label(NSApp.keyWindow?.windowController as? BrowserWindowController))"]
+        for (i, wc) in ordered.enumerated() {
+            let space = wc.activeSpace
+            let tabs = space?.tabs.compactMap { $0.url?.absoluteString } ?? []
+            let pinned = space?.pinnedEntries.compactMap { $0.tab?.url?.absoluteString } ?? []
+            let peek = wc.peekOverlayView != nil ? " PEEK=\(wc.selectedTab?.peekTab?.url?.absoluteString ?? "?")" : ""
+            let split = wc.selectedTab.flatMap { t in space.flatMap { TabStore.shared.splitGroup(containing: t.id, in: $0) } }
+                .map { " SPLIT=\($0.members.compactMap { $0.url?.absoluteString })" } ?? ""
+            lines.append("  [\(i)] \(Self.label(wc)) space=\(spaceName(wc.activeSpaceID)) selected=\(wc.selectedTab?.url?.absoluteString ?? "-")\(peek)\(split) tabs=\(tabs) pinned=\(pinned)")
+        }
+        log(lines.joined(separator: "\n"))
+    }
+}
+
+extension AppDelegate {
+    func runTask1914HarnessIfRequested(_ launchWC: BrowserWindowController) {
+        guard let outDir = Task1914Harness.outDir, let phase = Task1914Harness.env["DETOUR_VERIFY_PHASE"] else { return }
+        let log = Task1914Harness.log
+        let store = TabStore.shared
+        let routes = store.linkRoutes
+        let base = Task1914Harness.env["DETOUR_VERIFY_BASE"] ?? "http://127.0.0.1:8714"
+        log("phase \(phase) launched pid=\(ProcessInfo.processInfo.processIdentifier) spaces=\(store.nonIncognitoSpaces.map(\.name))")
+
+        func space(named name: String) -> Space? { store.nonIncognitoSpaces.first { $0.name == name } }
+        var windows: [String: BrowserWindowController] = [:]
+        func name(_ wc: BrowserWindowController, _ n: String) {
+            windows[n] = wc
+            Task1914Harness.labels[ObjectIdentifier(wc)] = n
+        }
+
+        let profileID = store.nonIncognitoSpaces.first!.profileID
+        for n in ["Work", "Personal"] where space(named: n) == nil {
+            store.addSpace(name: n, emoji: n == "Work" ? "💼" : "🏠", colorHex: n == "Work" ? "007AFF" : "34C759", profileID: profileID)
+        }
+        for r in routes.routes { routes.removeRoute(id: r.id) }
+        let work = space(named: "Work")!, personal = space(named: "Personal")!
+        routes.add(LinkRoute(match: LinkRouteMatch(kind: .contains, pattern: "secret"), target: .privateWindow))
+        routes.add(LinkRoute(match: LinkRouteMatch(kind: .domainIs, pattern: "localhost"), target: .space(work.id)))
+        routes.add(LinkRoute(match: LinkRouteMatch(kind: .contains, pattern: "kind=blank-work"), target: .space(work.id)))
+        routes.add(LinkRoute(match: LinkRouteMatch(kind: .contains, pattern: "routeme"), target: .space(work.id)))
+        routes.setDefaultTarget(.mostRecentSpace)
+        log("routes: \(routes.routes.map { "\(linkRouteSummary($0)) -> \($0.target.storageKind):\(Task1914Harness.spaceName($0.target.spaceID))" }) default=\(routes.defaultTarget.storageKind)")
+
+        // Window B on Work (where routed links land), window A on Personal in front.
+        let workWC = createNewWindow(showing: work)
+        workWC.window?.setFrame(NSRect(x: 60, y: 60, width: 1000, height: 720), display: true)
+        name(workWC, "B")
+        launchWC.setActiveSpace(id: personal.id, selectTab: false)
+        launchWC.window?.setFrame(NSRect(x: 140, y: 120, width: 1000, height: 720), display: true)
+        name(launchWC, "A")
+        // The pinned tab (anchor 127.0.0.1/a?tag=pin), then the page of links.
+        let pinTab = store.addTab(in: personal, url: URL(string: base + "/a?tag=pin")!)
+        store.pinTab(id: pinTab.id, in: personal)
+        let tab = store.addTab(in: personal, url: URL(string: base + "/a?tag=p")!)
+        launchWC.selectTab(id: tab.id)
+        launchWC.window?.makeKeyAndOrderFront(nil)
+
+        func wc(_ n: String?) -> BrowserWindowController? {
+            guard let n else { return NSApp.browserWindowControllersFrontToBack.first }
+            return windows[n]
+        }
+        func flags(_ s: String?) -> NSEvent.ModifierFlags {
+            var f: NSEvent.ModifierFlags = []
+            for part in (s ?? "").split(separator: "+") {
+                switch part {
+                case "cmd": f.insert(.command)
+                case "shift": f.insert(.shift)
+                case "opt": f.insert(.option)
+                default: break
+                }
+            }
+            return f
+        }
+        var eventNumber = 1000
+        /// Input only lands in the key window of the active app: a plain click
+        /// on an inactive window is swallowed (a Cmd-click is not).
+        func ensureFront(_ w: BrowserWindowController) {
+            if !NSApp.isActive { NSApp.activate(ignoringOtherApps: true) }
+            if NSApp.keyWindow !== w.window { w.window?.makeKeyAndOrderFront(nil) }
+        }
+        func post(_ e: NSEvent?) { if let e { NSApp.postEvent(e, atStart: false) } }
+        func click(_ id: String, in webView: WKWebView, of w: BrowserWindowController, mods: NSEvent.ModifierFlags) {
+            let js = "(() => { const e = document.getElementById('\(id)'); if (!e) return null; const b = e.getBoundingClientRect(); return [b.x + Math.min(20, b.width / 2), b.y + b.height / 2]; })()"
+            webView.evaluateJavaScript(js) { result, error in
+                guard let r = result as? [Double], let window = w.window else { log("CMD click \(id): no element (\(String(describing: error)))"); return }
+                let p = webView.convert(NSPoint(x: r[0], y: r[1]), to: nil)
+                ensureFront(w)
+                log("CMD click \(id) mods=\(mods.rawValue) at window point \(p) in \(Task1914Harness.label(w)) active=\(NSApp.isActive) key=\(Task1914Harness.label(NSApp.keyWindow?.windowController as? BrowserWindowController)) front=\(NSWorkspace.shared.frontmostApplication?.bundleIdentifier ?? "nil")")
+                for type in [NSEvent.EventType.mouseMoved, .leftMouseDown, .leftMouseUp] {
+                    eventNumber += 1
+                    post(NSEvent.mouseEvent(with: type, location: p, modifierFlags: mods,
+                                            timestamp: ProcessInfo.processInfo.systemUptime, windowNumber: window.windowNumber,
+                                            context: nil, eventNumber: eventNumber, clickCount: type == .mouseMoved ? 0 : 1,
+                                            pressure: type == .leftMouseDown ? 1 : 0))
+                }
+            }
+        }
+        func key(_ chars: String, mods: NSEvent.ModifierFlags = [], keyCode: UInt16 = 0, in w: BrowserWindowController) {
+            guard let window = w.window else { return }
+            ensureFront(w)
+            for type in [NSEvent.EventType.keyDown, .keyUp] {
+                post(NSEvent.keyEvent(with: type, location: .zero, modifierFlags: mods, timestamp: ProcessInfo.processInfo.systemUptime,
+                                      windowNumber: window.windowNumber, context: nil, characters: chars,
+                                      charactersIgnoringModifiers: chars, isARepeat: false, keyCode: keyCode))
+            }
+        }
+
+        // Commands appended to cmd-<phase>.txt, one per line, applied in order.
+        var handled = 0
+        var resumeAt: TimeInterval = 0
+        var retries = 0
+        let cmdURL = URL(fileURLWithPath: outDir).appendingPathComponent("cmd-\(phase).txt")
+        let timer = Timer(timeInterval: 0.3, repeats: true) { _ in
+            guard let text = try? String(contentsOf: cmdURL, encoding: .utf8) else { return }
+            let lines = text.split(separator: "\n").map(String.init)
+            while handled < lines.count {
+                guard ProcessInfo.processInfo.systemUptime >= resumeAt else { return }
+                let line = lines[handled]
+                handled += 1
+                let parts = line.split(separator: " ").map(String.init)
+                guard let cmd = parts.first else { continue }
+                let arg = parts.count > 1 ? parts[1] : nil
+                let arg2 = parts.count > 2 ? parts[2] : nil
+                log("CMD \(line)")
+                if ["click", "clickpeek", "cmdt", "cmdl", "type", "clear", "return", "escape"].contains(cmd),
+                   let w = wc(arg), !NSApp.isActive || NSApp.keyWindow !== w.window {
+                    // Bring Detour and the window forward first, and retry the
+                    // command once that has had time to take effect.
+                    ensureFront(w)
+                    handled -= 1
+                    resumeAt = ProcessInfo.processInfo.systemUptime + 0.8
+                    retries += 1
+                    if retries <= 3 { return }
+                    log("CMD \(cmd): window still not key after 3 tries (active=\(NSApp.isActive)); posting anyway")
+                    handled += 1
+                }
+                retries = 0
+                switch cmd {
+                case "dump": Task1914Harness.dump(parts.dropFirst().joined(separator: " "))
+                case "#": break
+                case "wait": resumeAt = ProcessInfo.processInfo.systemUptime + (Double(arg ?? "1") ?? 1)
+                case "capture":
+                    // capture <label> <window>: the shell watcher takes the picture
+                    if let l = arg, let w = wc(arg2) { log("CAPTURE \(l) \(w.window?.windowNumber ?? 0)") }
+                    resumeAt = ProcessInfo.processInfo.systemUptime + 2.5
+                case "newtab":
+                    // newtab <window> <url>: a selected tab in the window's space
+                    if let w = wc(arg), let space = w.activeSpace, let s = arg2, let u = URL(string: s) {
+                        let t = store.addTab(in: space, url: u)
+                        w.selectTab(id: t.id)
+                    }
+                case "activate": NSApp.activate(ignoringOtherApps: true)
+                case "front":
+                    // front A|B|P
+                    wc(arg)?.window?.makeKeyAndOrderFront(nil)
+                case "load":
+                    // load <window> <url>: the window's selected tab
+                    if let w = wc(arg), let s = arg2, let u = URL(string: s) { w.selectedTab?.load(u) }
+                case "select":
+                    // select <window> <url substring>: select the tab whose URL contains it (normal or pinned)
+                    if let w = wc(arg), let s = arg2, let space = w.activeSpace,
+                       let t = (space.tabs + space.pinnedEntries.compactMap(\.tab)).first(where: { $0.url?.absoluteString.contains(s) == true }) {
+                        w.selectTab(id: t.id)
+                    }
+                case "click", "clickpeek":
+                    // click <window> <element id> [cmd+shift+opt]
+                    if let w = wc(arg), let id = arg2 {
+                        let webView = cmd == "clickpeek" ? w.selectedTab?.peekTab?.webView : w.selectedTab?.webView
+                        if let webView { click(id, in: webView, of: w, mods: flags(parts.count > 3 ? parts[3] : nil)) }
+                        else { log("CMD \(cmd): no web view") }
+                    }
+                case "eval":
+                    // eval <window> <js...>
+                    if let w = wc(arg), let webView = w.selectedTab?.webView {
+                        let js = parts.dropFirst(2).joined(separator: " ")
+                        webView.evaluateJavaScript(js) { r, e in log("EVAL \(js) -> \(String(describing: r)) \(e.map { "error \($0)" } ?? "")") }
+                    }
+                case "cmdt": if let w = wc(arg) { key("t", mods: .command, keyCode: 17, in: w) }
+                case "cmdl": if let w = wc(arg) { key("l", mods: .command, keyCode: 37, in: w) }
+                case "type":
+                    // type <window> <text>: one key event per character
+                    if let w = wc(arg) {
+                        for ch in parts.dropFirst(2).joined(separator: " ") { key(String(ch), in: w) }
+                    }
+                case "clear":
+                    // clear <window>: select all and delete in the palette's field
+                    if let w = wc(arg) { key("a", mods: .command, keyCode: 0, in: w); key("\u{8}", keyCode: 51, in: w) }
+                case "return": if let w = wc(arg) { key("\r", keyCode: 36, in: w) }
+                case "escape": if let w = wc(arg) { key("\u{1b}", keyCode: 53, in: w) }
+                case "private":
+                    let p = BrowserWindowController(incognito: true)
+                    p.showWindow(nil)
+                    self.registerWindowController(p)
+                    do {
+                        name(p, "P")
+                        p.window?.setFrame(NSRect(x: 220, y: 180, width: 1000, height: 720), display: true)
+                        if let space = p.activeSpace, let s = arg, let u = URL(string: s) {
+                            let t = store.addTab(in: space, url: u)
+                            p.selectTab(id: t.id)
+                        }
+                    }
+                case "name":
+                    // name <label>: label the frontmost unnamed browser window (a routed Private window)
+                    if let n = arg, let w = NSApp.browserWindowControllersFrontToBack.first(where: { Task1914Harness.labels[ObjectIdentifier($0)] == nil }) { name(w, n) }
+                default: log("CMD unknown \(line)")
+                }
+            }
+        }
+        RunLoop.main.add(timer, forMode: .common)
+        log("ready")
+    }
+}
+#endif
